@echo off
chcp 65001 >nul
title CloudPC - แชร์ลิงก์ออนไลน์ให้เพื่อนเข้าทดสอบ

echo ====================================================================
echo        ระบบเปิดเว็บไซต์ CloudPC และสร้างลิงก์สำหรับส่งให้เพื่อน
echo ====================================================================
echo.

:: ตรวจสอบว่าพอร์ต 5218 รันอยู่แล้วหรือไม่
netstat -ano | findstr :5218 >nul
if %errorlevel% neq 0 (
    echo [1/2] กำลังสตาร์ทเว็บไซต์ CloudPC (http://localhost:5218)...
    start "CloudPC Server (ห้ามปิดหน้าต่างนี้)" cmd /k "cd /d "%~dp0CloudPCRental" && dotnet run --no-restore --urls "http://localhost:5218""
    echo กรุณารอสักครู่ เซิร์ฟเวอร์กำลังเริ่มต้น...
    timeout /t 6 >nul
) else (
    echo [1/2] ตรวจพบเว็บไซต์ CloudPC กำลังทำงานอยู่เรียบร้อยแล้ว
)

echo.
echo [2/2] กำลังสร้างลิงก์ออนไลน์สาธารณะ (Public URL)...
echo.
echo --------------------------------------------------------------------
echo   >>> คัดลอกลิงก์ https://... ที่ปรากฏด้านล่างนี้ ส่งให้เพื่อนได้เลย <<<
echo   (เพื่อนสามารถเปิดจากมือถือ แท็บเล็ต หรือคอมฯ จากที่ไหนก็ได้)
echo.
echo   *ข้อแนะนำ: เปิดหน้าต่างนี้ทิ้งไว้ตลอดช่วงเวลาที่ให้เพื่อนทดสอบ*
echo --------------------------------------------------------------------
echo.

ssh -o StrictHostKeyChecking=no -p 443 -R0:localhost:5218 a.pinggy.io

echo.
echo ปิดการเชื่อมต่อเรียบร้อยแล้ว
pause
