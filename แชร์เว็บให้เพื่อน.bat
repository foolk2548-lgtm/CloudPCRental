@echo off
chcp 65001 >nul
title CloudPC Rental - แชร์เว็บให้เพื่อนทดสอบออนไลน์
color 0B

echo ============================================================
echo    CloudPC Rental - ระบบแชร์เว็บให้เพื่อนทดสอบออนไลน์
echo ============================================================
echo.

:: 1. ตรวจสอบว่าเว็บกำลังรันอยู่ที่พอร์ต 5218 หรือไม่
netstat -ano | findstr :5218 >nul
if %errorlevel% equ 0 (
    echo [OK] ตรวจพบว่าเว็บไซค์กำลังเปิดทำงานอยู่ที่ http://localhost:5218 เรียบร้อยแล้ว
) else (
    echo [!] ยังไม่ได้เปิดรันเว็บไซค์ CloudPC
    echo [*] กำลังเปิดเว็บให้โดยอัตโนมัติ กรุณารอสักครู่ (ประมาณ 5-7 วินาที)...
    start "CloudPC Web Server" cmd /k "cd /d "%~dp0CloudPCRental" && dotnet run"
    timeout /t 6 /nobreak >nul
)

echo.
echo ============================================================
echo  [ขั้นตอนการส่งลิงก์ให้เพื่อน]
echo  1. มองหาบรรทัดที่มีคำว่า:
echo     https://xxxxxxxx.trycloudflare.com
echo  2. คัดลอก (Copy) ลิงก์ดังกล่าว ส่งให้เพื่อนใน LINE / Discord ได้ทันที!
echo  3. เพื่อนสามารถเปิดผ่านมือถือ แท็บเล็ต หรือคอมพิวเตอร์ได้เลย
echo  4. เมื่อทดสอบเสร็จเรียบร้อยแล้ว ให้กดปิดหน้าต่างนี้เพื่อหยุดแชร์
echo ============================================================
echo.
echo กำลังเริ่มสร้าง Tunnel ออนไลน์ กรุณารอสักครู่...
echo.

"%~dp0cloudflared.exe" tunnel --url http://localhost:5218

pause
