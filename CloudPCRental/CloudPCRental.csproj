<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ปิด Hot Reload ใน dotnet watch เพื่อป้องกัน Unexpected true crash บน OneDrive / ย้ายโฟลเดอร์ -->
    <EnableHotReload>false</EnableHotReload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- ป้องกันไม่ให้ dotnet watch แครชเมื่อมีการบันทึกข้อมูลหรืออัปโหลดสลิป -->
    <Content Update="App_Data\**" Watch="false" />
    <Content Update="wwwroot\uploads\**" Watch="false" />
    <None Update="App_Data\**" Watch="false" />
    <None Update="wwwroot\uploads\**" Watch="false" />
    <Watch Remove="App_Data\**;wwwroot\uploads\**" />
  </ItemGroup>

</Project>
