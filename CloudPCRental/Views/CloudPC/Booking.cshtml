@model CloudPCRental.Models.Machine
@{
    ViewData["Title"] = "กำหนดเวลาจองของคุณ - CloudPC";
    decimal pricePerHour = Model?.PricePerHour ?? 15.00m;
    decimal defaultTotal = pricePerHour * 2;
    var bookedSlots = (List<string>)(ViewBag.BookedSlots ?? new List<string>());
    var allSlots = (List<string>)(ViewBag.StandardSlots ?? CloudPCRental.Models.MockDataStore.StandardDailySlots);
    string initialDate = (string)(ViewBag.SelectedDate ?? CloudPCRental.Models.MockDataStore.GetTodayThaiDate());
    var nowUtc = DateTime.Now;
    int currentHour = nowUtc.Hour;
    bool isInitialToday = initialDate == CloudPCRental.Models.MockDataStore.GetTodayThaiDate();
}

<div class="mb-3">
    <a asp-action="Machines" class="text-secondary text-decoration-none small">
        <i class="bi bi-arrow-left me-1"></i> ย้อนกลับไปหน้าค้นหาเครื่อง
    </a>
</div>

<div class="row g-4 pb-5">
    <!-- Left Card: รายละเอียดเครื่อง (Wireframe Page 4) -->
    <div class="col-lg-4">
        <div class="card-cloudpc p-4 bg-white sticky-top" style="top: 80px;">
            <div class="text-center p-3 rounded-3 mb-3 d-flex align-items-center justify-content-center bg-light position-relative overflow-hidden" style="height: 180px;">
                <img src="@(Model?.DisplayImageUrl ?? "/images/machines/pc-gaming.png")" 
                     alt="@Model?.MachineName" 
                     class="img-fluid" 
                     style="max-height: 160px; object-fit: contain;" 
                     onerror="this.onerror=null; this.src='/images/machines/pc-gaming.png';" />
                <span class="position-absolute top-0 start-0 m-2 badge bg-primary text-white rounded-pill px-2 py-1 font-monospace" style="font-size: 0.7rem;">
                    PC-@(Model?.MachineId.ToString("D3") ?? "001")
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold mb-0 text-dark">@Model?.MachineName</h5>
                @if (Model?.Status == "PendingRepair" || (!string.IsNullOrEmpty(Model?.RepairNote) && string.IsNullOrEmpty(Model?.ApprovedBy)))
                {
                    <span class="badge text-nowrap" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.75rem;"><i class="bi bi-hourglass-split me-1"></i> รออนุมัติซ่อม</span>
                }
                else if (Model?.Status == "Maintenance" || (!string.IsNullOrEmpty(Model?.RepairNote) && !string.IsNullOrEmpty(Model?.ApprovedBy)))
                {
                    <span class="badge-status-maintenance text-nowrap"><i class="bi bi-tools me-1"></i> ซ่อมบำรุง</span>
                }
                else if (Model?.Status == "Rented")
                {
                    <span class="badge text-nowrap" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 0.75rem;"><i class="bi bi-clock-history me-1"></i> มีคิวบางช่วง</span>
                }
                else
                {
                    <span class="badge-status-available text-nowrap">ว่าง</span>
                }
            </div>

            <p class="text-muted small mb-3">
                เหมาะสำหรับเล่นเกมกราฟิกสูง งานตัดต่อวิดีโอ 4K และงานเรนเดอร์ทั่วไป
            </p>

            <div class="border-top pt-3 mb-3">
                <h6 class="fw-bold small text-secondary mb-2">ข้อมูลสเปกเครื่อง</h6>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>CPU:</span>
                    <span class="text-dark fw-semibold">@Model?.CPU</span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>RAM:</span>
                    <span class="text-dark fw-semibold">@Model?.RAM</span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>GPU:</span>
                    <span class="text-dark fw-semibold">@Model?.GPU</span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Storage:</span>
                    <span class="text-dark fw-semibold">1TB NVMe M.2 SSD</span>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <span class="text-secondary small">อัตราค่าบริการ</span>
                <span class="text-primary fw-bold fs-5">@pricePerHour.ToString("N0") <small class="fs-6 text-muted">บาท/ชั่วโมง</small></span>
            </div>
        </div>
    </div>

    <!-- Right Card: กำหนดเวลาจอง (Wireframe Page 4) -->
    <div class="col-lg-8">
        <div class="card-cloudpc p-4 p-md-5 bg-white">
            <h4 class="fw-bold text-dark mb-1">กำหนดเวลาจองของคุณ</h4>
            <p class="text-muted small mb-4">กรุณาเลือกวันที่และช่วงเวลาที่ต้องการเริ่มใช้งานระบบคอมพิวเตอร์คลาวด์</p>

            <!-- 1. ปฏิทินเลือกวันที่ (Interactive Real-time Calendar) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2" style="max-width: 380px;">
                    <label class="form-label small fw-semibold text-secondary mb-0">เลือกวันที่</label>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold" id="selectedDateBadge">
                        <i class="bi bi-calendar-check me-1"></i> @initialDate
                    </span>
                </div>

                <div class="border rounded-3 p-3 bg-white shadow-xs" style="max-width: 380px;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <button type="button" id="calPrevBtn" class="btn btn-sm btn-link p-0 text-secondary text-decoration-none" onclick="prevMonth()" title="เดือนก่อนหน้า">
                            <i class="bi bi-chevron-left fs-6"></i>
                        </button>
                        <span class="fw-bold small text-dark" id="calendarMonthTitle">กำลังโหลดปฏิทิน...</span>
                        <button type="button" id="calNextBtn" class="btn btn-sm btn-link p-0 text-secondary text-decoration-none" onclick="nextMonth()" title="เดือนถัดไป">
                            <i class="bi bi-chevron-right fs-6"></i>
                        </button>
                    </div>

                    <div class="row text-center text-secondary small g-1 mb-2 fw-semibold">
                        <div class="col text-danger">อา</div>
                        <div class="col">จ</div>
                        <div class="col">อ</div>
                        <div class="col">พ</div>
                        <div class="col">พฤ</div>
                        <div class="col">ศ</div>
                        <div class="col text-primary">ส</div>
                    </div>

                    <!-- Calendar Grid Container (Populated dynamically by JavaScript in real-time) -->
                    <div id="calendarDaysGrid">
                        <div class="text-center py-4 text-muted small">
                            <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                            กำลังโหลดปฏิทินตามเวลาจริง...
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. เลือกช่วงเวลาที่ต้องการใช้งาน (Interactive Time Slots) -->
            <div class="mb-4">
                @if (isInitialToday && currentHour >= 23)
                {
                    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 rounded-3 mb-3 border-warning-subtle shadow-xs" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-moon-stars text-warning fs-4 me-3"></i>
                            <div>
                                <strong class="text-dark d-block">รอบเวลาให้บริการของวันนี้สิ้นสุดลงแล้ว (23:00 น.)</strong>
                                <span class="small text-muted">ทุกช่วงเวลาสำหรับวันนี้ผ่านไปแล้ว คุณสามารถเลือกจองล่วงหน้าสำหรับวันพรุ่งนี้ได้ทันที</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-warning btn-sm fw-semibold rounded-pill px-3 text-nowrap ms-2" onclick="selectTomorrow()">
                            <i class="bi bi-calendar2-check me-1"></i> จองวันพรุ่งนี้
                        </button>
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label small fw-semibold text-secondary mb-0">เลือกช่วงเวลาที่ต้องการใช้งาน</label>
                    <span class="text-muted small" id="selectedTimeRangeText">
                        ช่วงเวลา: <strong class="text-primary" id="timeRangeSummary">09:00 - 11:00 (รวม 2 ชม.)</strong>
                    </span>
                </div>

                <div class="d-flex flex-wrap gap-2" id="timeSlotsContainer">
                    @{
                        int selectedCount = 0;
                    }
                    @foreach (var slot in allSlots)
                    {
                        var parts = slot.Split(new[] { '-', '–' }, StringSplitOptions.RemoveEmptyEntries);
                        var start = parts.Length > 0 ? parts[0].Trim() : "";
                        var end = parts.Length > 1 ? parts[1].Trim() : "";
                        int slotStartHour = 0;
                        if (int.TryParse(start.Split(':')[0], out int sh)) { slotStartHour = sh; }

                        bool isExpired = isInitialToday && (slotStartHour <= currentHour);
                        bool isBooked = bookedSlots.Contains(slot);
                        bool isInitialSelected = !isExpired && !isBooked && selectedCount < 2;
                        if (isInitialSelected) { selectedCount++; }

                        if (isExpired)
                        {
                            <button type="button" class="btn btn-light btn-sm px-2 py-2 rounded-2 text-muted border bg-light opacity-75 fw-normal" 
                                    disabled title="ช่วงเวลานี้ผ่านไปแล้วสำหรับวันนี้">
                                <i class="bi bi-clock-history me-1 text-secondary"></i> @slot (เลยเวลา)
                            </button>
                        }
                        else if (isBooked)
                        {
                            <button type="button" class="btn btn-light btn-sm px-3 py-2 rounded-2 text-danger border bg-danger-subtle bg-opacity-25 fw-semibold" 
                                    disabled title="ช่วงเวลานี้มีผู้จองแล้ว ไม่สามารถเลือกได้">
                                <i class="bi bi-x-circle me-1"></i> @slot (เต็ม)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm px-3 py-2 rounded-2 slot-btn @(isInitialSelected ? "btn-primary text-white" : "btn-outline-secondary bg-white text-dark")" 
                                    data-slot="@slot" data-start="@start" data-end="@end" onclick="toggleSlot(this)">
                                @slot
                            </button>
                        }
                    }
                </div>
                <div id="slotWarning" class="alert alert-warning py-1 px-2 small mt-2 d-none" role="alert">
                    <i class="bi bi-exclamation-circle me-1"></i> กรุณาเลือกช่วงเวลาอย่างน้อย 1 ชั่วโมง เพื่อดำเนินการจอง
                </div>
            </div>

            <!-- 3. รหัสส่วนลด (Promo Code) -->
            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary mb-1">รหัสส่วนลด</label>
                <div class="input-group" style="max-width: 420px;">
                    <input type="text" id="promoInput" class="form-control" placeholder="กรอกรหัสโค้ดโปรโมชั่นของคุณที่นี่ (เช่น NEW10, CLOUD)" />
                    <button class="btn btn-dark" type="button" onclick="applyPromoCode()">ตรวจสอบโค้ด</button>
                </div>
                <div id="promoFeedback" class="small mt-1 d-none"></div>
            </div>

            <!-- 4. สรุปยอดเงิน (Live Pricing Summary) -->
            <div class="border-top pt-3 mb-4">
                <div class="d-flex justify-content-between align-items-center small text-muted mb-2 gap-2">
                    <span id="hoursSummaryLabel" class="text-break" style="max-width: 72%;">ค่าเช่าระบบเครื่อง @Model?.MachineName (2 ชั่วโมง)</span>
                    <span class="text-dark fw-semibold text-nowrap ms-auto" id="subtotalDisplay">@defaultTotal.ToString("N2") บาท</span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>ส่วนลดคูปอง</span>
                    <span class="text-danger fw-semibold" id="discountDisplay">-0.00 บาท</span>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="fw-bold text-dark">รวมทั้งสิ้น</span>
                    <span class="text-primary fw-bold fs-4" id="totalDisplay">@defaultTotal.ToString("N2") บาท</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top small">
                    <span class="text-secondary"><i class="bi bi-wallet2 text-primary me-1"></i> ยอดเงินในกระเป๋าของคุณ:</span>
                    <span class="fw-bold text-dark font-monospace" id="bookingWalletBal">@(((decimal)(ViewBag.UserBalance ?? 600.00m)).ToString("N2")) บาท</span>
                </div>

                <div id="bookingInsufficientAlert" class="alert alert-danger small p-2 mt-2 @(((decimal)(ViewBag.UserBalance ?? 600.00m) >= defaultTotal) ? "d-none" : "") rounded-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                    <strong>ยอดเงินในกระเป๋าไม่เพียงพอกับค่าใช้จ่าย</strong> (มี @(((decimal)(ViewBag.UserBalance ?? 600.00m)).ToString("N2")) บาท) คุณจะต้องมีเงินในกระเป๋าเพียงพอก่อนจึงจะสามารถทำรายการใช้จ่ายได้
                </div>
            </div>

            <!-- 5. ปุ่มยืนยันไปหน้าชำระเงิน -->
            <div class="d-grid">
                <a id="confirmBookingBtn" 
                   asp-action="Payment" 
                   asp-route-machineId="@Model?.MachineId" 
                   asp-route-hours="2"
                   asp-route-bookingDate="@initialDate"
                   asp-route-timeRange="09:00 - 11:00"
                   asp-route-slots="09:00 - 10:00|10:00 - 11:00"
                   asp-route-discount="0"
                   class="btn btn-primary btn-lg py-2 rounded-3 fw-semibold shadow-sm">
                    ยืนยันการจองและไปหน้าชำระเงิน
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .cal-day {
        cursor: pointer;
        width: 34px;
        height: 34px;
        line-height: 34px;
        display: inline-block;
        border-radius: 50%;
        text-align: center;
        user-select: none;
        transition: all 0.15s ease-in-out;
        font-weight: 500;
        color: #1e293b;
        position: relative;
    }
    .cal-day:hover:not(.active):not(.disabled-day) {
        background-color: #dbeafe;
        color: #1d4ed8;
    }
    .cal-day.active {
        background-color: #2563eb !important;
        color: #ffffff !important;
        font-weight: 700;
        box-shadow: 0 2px 4px rgba(37, 99, 235, 0.3);
    }
    .cal-day.disabled-day {
        color: #cbd5e1;
        cursor: not-allowed;
    }
    .today-marker {
        position: absolute;
        bottom: 2px;
        left: 50%;
        transform: translateX(-50%);
        width: 5px;
        height: 5px;
        background-color: #2563eb;
        border-radius: 50%;
    }
    .cal-day.active .today-marker {
        background-color: #ffffff;
    }
    .slot-btn {
        transition: all 0.15s ease-in-out;
        font-size: 0.85rem;
    }
    .slot-btn:hover:not(.btn-primary) {
        border-color: #2563eb;
        color: #2563eb;
    }
</style>

<script>
    var pricePerHour = @pricePerHour;
    var machineId = @(Model?.MachineId ?? 1);
    var machineName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.MachineName ?? "Cloud PC"));

    var realNow = new Date();
    var realDay = realNow.getDate();
    var realMonth = realNow.getMonth(); // 0-11
    var realYear = realNow.getFullYear() + 543;

    // หากเวลาปัจจุบันเกิน 23:00 น. ให้เริ่มต้นเลือกวันถัดไปอัตโนมัติ เพื่อให้ผู้ใช้เห็นสล็อตที่สามารถจองได้ทันที
    var initTarget = new Date();
    if (initTarget.getHours() >= 23) {
        initTarget.setDate(initTarget.getDate() + 1);
    }
    var selectedDay = initTarget.getDate();
    var selectedMonthIndex = initTarget.getMonth();
    var currentYear = initTarget.getFullYear() + 543;

    function selectTomorrow() {
        var tom = new Date();
        tom.setDate(tom.getDate() + 1);
        selectedDay = tom.getDate();
        selectedMonthIndex = tom.getMonth();
        currentYear = tom.getFullYear() + 543;
        renderCalendar();
        var fullDateStr = getSelectedDateString();
        var badge = document.getElementById('selectedDateBadge');
        if (badge) badge.innerHTML = '<i class="bi bi-calendar-check me-1"></i> ' + fullDateStr;
        updateBookingUrl();
        fetchBookedSlotsForDate(fullDateStr);
    }

    var monthsThai = [
        "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
        "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
    ];
    var discountAmount = 0;

    function getSelectedDateString() {
        return selectedDay + " " + monthsThai[selectedMonthIndex] + " " + currentYear;
    }

    function renderCalendar() {
        var title = monthsThai[selectedMonthIndex] + " " + currentYear;
        var titleEl = document.getElementById('calendarMonthTitle');
        if (titleEl) titleEl.innerText = title;

        var gregorianYear = currentYear - 543;
        var firstDayOfWeek = new Date(gregorianYear, selectedMonthIndex, 1).getDay(); // 0 = Sun
        var totalDays = new Date(gregorianYear, selectedMonthIndex + 1, 0).getDate();
        var prevMonthDays = new Date(gregorianYear, selectedMonthIndex, 0).getDate();

        var grid = document.getElementById('calendarDaysGrid');
        if (!grid) return;

        var html = '';
        var dayCounter = 1;
        var nextMonthDay = 1;
        var totalCells = (firstDayOfWeek + totalDays > 35) ? 42 : 35;

        for (var r = 0; r < totalCells / 7; r++) {
            html += '<div class="row text-center small g-1 ' + (r > 0 ? 'mt-1' : '') + '">';
            for (var c = 0; c < 7; c++) {
                var cellIndex = r * 7 + c;
                if (cellIndex < firstDayOfWeek) {
                    var prevDayNum = prevMonthDays - (firstDayOfWeek - 1 - c);
                    html += '<div class="col text-muted cal-day disabled-day opacity-50">' + prevDayNum + '</div>';
                } else if (dayCounter <= totalDays) {
                    var d = dayCounter;
                    var isPast = false;
                    if (currentYear < realYear) {
                        isPast = true;
                    } else if (currentYear === realYear) {
                        if (selectedMonthIndex < realMonth) {
                            isPast = true;
                        } else if (selectedMonthIndex === realMonth && d < realDay) {
                            isPast = true;
                        }
                    }

                    var isToday = (currentYear === realYear && selectedMonthIndex === realMonth && d === realDay);
                    var isSelected = (d === selectedDay);

                    if (isPast) {
                        html += '<div class="col"><span class="cal-day disabled-day text-muted opacity-50" title="ไม่สามารถเลือกวันย้อนหลังได้">' + d + '</span></div>';
                    } else {
                        var cls = "cal-day";
                        if (isSelected) cls += " active";
                        var marker = isToday ? '<span class="today-marker" title="วันนี้"></span>' : '';
                        html += '<div class="col position-relative"><span class="' + cls + '" onclick="selectCalendarDate(' + d + ', this)" title="' + (isToday ? 'วันนี้' : '') + '">' + d + marker + '</span></div>';
                    }
                    dayCounter++;
                } else {
                    html += '<div class="col text-muted cal-day disabled-day opacity-50">' + nextMonthDay + '</div>';
                    nextMonthDay++;
                }
            }
            html += '</div>';
        }

        grid.innerHTML = html;

        var prevBtn = document.getElementById('calPrevBtn');
        if (prevBtn) {
            if (currentYear < realYear || (currentYear === realYear && selectedMonthIndex <= realMonth)) {
                prevBtn.classList.add('disabled', 'opacity-25');
                prevBtn.style.pointerEvents = 'none';
            } else {
                prevBtn.classList.remove('disabled', 'opacity-25');
                prevBtn.style.pointerEvents = 'auto';
            }
        }

        var fullDateStr = getSelectedDateString();
        var badge = document.getElementById('selectedDateBadge');
        if (badge) badge.innerHTML = '<i class="bi bi-calendar-check me-1"></i> ' + fullDateStr;
    }

    function selectCalendarDate(day, elem) {
        document.querySelectorAll('.cal-day').forEach(function(el) {
            el.classList.remove('active');
        });
        elem.classList.add('active');
        selectedDay = day;

        var fullDateStr = getSelectedDateString();
        var badge = document.getElementById('selectedDateBadge');
        if (badge) badge.innerHTML = '<i class="bi bi-calendar-check me-1"></i> ' + fullDateStr;
        updateBookingUrl();
        fetchBookedSlotsForDate(fullDateStr);
    }

    function prevMonth() {
        if (currentYear < realYear || (currentYear === realYear && selectedMonthIndex <= realMonth)) {
            return;
        }
        if (selectedMonthIndex > 0) {
            selectedMonthIndex--;
        } else {
            selectedMonthIndex = 11;
            currentYear--;
        }
        if (currentYear === realYear && selectedMonthIndex === realMonth && selectedDay < realDay) {
            selectedDay = realDay;
        }
        renderCalendar();
        fetchBookedSlotsForDate(getSelectedDateString());
    }

    function nextMonth() {
        if (selectedMonthIndex < 11) {
            selectedMonthIndex++;
        } else {
            selectedMonthIndex = 0;
            currentYear++;
        }
        selectedDay = 1;
        renderCalendar();
        fetchBookedSlotsForDate(getSelectedDateString());
    }

    function fetchBookedSlotsForDate(dateStr) {
        fetch('/CloudPC/GetBookedSlots?machineId=' + machineId + '&date=' + encodeURIComponent(dateStr))
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    renderTimeSlots(data.bookedSlots || [], data.allSlots || []);
                }
            })
            .catch(err => console.error(err));
    }

    function renderTimeSlots(bookedSlots, allSlots) {
        var container = document.getElementById('timeSlotsContainer');
        if (!container || !allSlots || allSlots.length === 0) return;
        var html = '';
        var selectedCount = 0;

        var now = new Date();
        var isToday = (selectedDay === now.getDate() && selectedMonthIndex === now.getMonth() && currentYear === (now.getFullYear() + 543));
        var currentHour = now.getHours();

        allSlots.forEach(function(slot) {
            var parts = slot.split(/[-–]/);
            var start = parts.length > 0 ? parts[0].trim() : '';
            var end = parts.length > 1 ? parts[1].trim() : '';
            var slotStartHour = parseInt(start.split(':')[0], 10);

            var isExpired = isToday && (slotStartHour <= currentHour);
            var isBooked = bookedSlots.includes(slot);
            var isInitial = !isExpired && !isBooked && selectedCount < 2;
            if (isInitial) selectedCount++;

            if (isExpired) {
                html += '<button type="button" class="btn btn-light btn-sm px-2 py-2 rounded-2 text-muted border bg-light opacity-75 fw-normal" disabled title="ช่วงเวลานี้ผ่านไปแล้วสำหรับวันนี้"><i class="bi bi-clock-history me-1 text-secondary"></i> ' + slot + ' (เลยเวลา)</button> ';
            } else if (isBooked) {
                html += '<button type="button" class="btn btn-light btn-sm px-3 py-2 rounded-2 text-danger border bg-danger-subtle bg-opacity-25 fw-semibold" disabled title="ช่วงเวลานี้มีผู้จองแล้ว ไม่สามารถเลือกได้"><i class="bi bi-x-circle me-1"></i> ' + slot + ' (เต็ม)</button> ';
            } else {
                var cls = isInitial ? "btn-primary text-white" : "btn-outline-secondary bg-white text-dark";
                html += '<button type="button" class="btn btn-sm px-3 py-2 rounded-2 slot-btn ' + cls + '" data-slot="' + slot + '" data-start="' + start + '" data-end="' + end + '" onclick="toggleSlot(this)">' + slot + '</button> ';
            }
        });

        container.innerHTML = html;
        recalculatePricing();
    }

    function toggleSlot(btn) {
        if (btn.classList.contains('btn-primary')) {
            // Deselect
            btn.classList.remove('btn-primary', 'text-white');
            btn.classList.add('btn-outline-secondary', 'bg-white', 'text-dark');
        } else {
            // Select
            btn.classList.remove('btn-outline-secondary', 'bg-white', 'text-dark');
            btn.classList.add('btn-primary', 'text-white');
        }
        recalculatePricing();
    }

    function recalculatePricing() {
        var selectedSlots = document.querySelectorAll('.slot-btn.btn-primary');
        var hours = selectedSlots.length;

        var warning = document.getElementById('slotWarning');
        var confirmBtn = document.getElementById('confirmBookingBtn');

        if (hours === 0) {
            warning.classList.remove('d-none');
            confirmBtn.classList.add('disabled');
            confirmBtn.innerText = "กรุณาเลือกช่วงเวลาอย่างน้อย 1 ชั่วโมง";
            document.getElementById('timeRangeSummary').innerText = "ยังไม่ได้เลือกช่วงเวลา";
            document.getElementById('subtotalDisplay').innerText = "0.00 บาท";
            document.getElementById('totalDisplay').innerText = "0.00 บาท";
            return;
        }

        warning.classList.add('d-none');
        confirmBtn.classList.remove('disabled');
        confirmBtn.innerText = "ยืนยันการจองและไปหน้าชำระเงิน";

        // Determine earliest and latest time range
        var firstSlot = selectedSlots[0].getAttribute('data-start');
        var lastSlot = selectedSlots[selectedSlots.length - 1].getAttribute('data-end');
        var timeRange = firstSlot + " - " + lastSlot;

        document.getElementById('timeRangeSummary').innerText = timeRange + " (รวม " + hours + " ชม.)";
        var summaryLabel = document.getElementById('hoursSummaryLabel');
        if (summaryLabel) {
            summaryLabel.innerText = "ค่าเช่าระบบเครื่อง " + machineName + " (" + hours + " ชั่วโมง)";
        }

        var subtotal = hours * pricePerHour;
        var finalTotal = Math.max(0, subtotal - discountAmount);

        document.getElementById('subtotalDisplay').innerText = subtotal.toFixed(2) + " บาท";
        document.getElementById('totalDisplay').innerText = finalTotal.toFixed(2) + " บาท";

        var userWallet = @(((decimal)(ViewBag.UserBalance ?? 600.00m)));
        var insuffAlert = document.getElementById('bookingInsufficientAlert');
        if (insuffAlert) {
            if (finalTotal > userWallet) {
                insuffAlert.classList.remove('d-none');
            } else {
                insuffAlert.classList.add('d-none');
            }
        }

        updateBookingUrl(hours, timeRange, discountAmount);
    }

    function updateBookingUrl(hours, timeRange, discount) {
        var selectedSlots = document.querySelectorAll('.slot-btn.btn-primary');
        if (!hours) {
            hours = selectedSlots.length;
            if (hours === 0) return;
            var firstSlot = selectedSlots[0].getAttribute('data-start');
            var lastSlot = selectedSlots[selectedSlots.length - 1].getAttribute('data-end');
            timeRange = firstSlot + " - " + lastSlot;
        }
        if (discount === undefined) discount = discountAmount;

        var slotList = Array.from(selectedSlots).map(function(b) { return b.getAttribute('data-slot'); }).join('|');
        var dateStr = getSelectedDateString();
        var url = "/CloudPC/Payment?machineId=" + machineId + 
                  "&hours=" + hours + 
                  "&bookingDate=" + encodeURIComponent(dateStr) + 
                  "&timeRange=" + encodeURIComponent(timeRange) + 
                  "&discount=" + discount +
                  "&slots=" + encodeURIComponent(slotList);

        document.getElementById('confirmBookingBtn').setAttribute('href', url);
    }

    function applyPromoCode() {
        var code = document.getElementById('promoInput').value.trim().toUpperCase();
        var feedback = document.getElementById('promoFeedback');
        feedback.classList.remove('d-none');

        if (code === "NEW10" || code === "CLOUD10") {
            var selectedSlots = document.querySelectorAll('.slot-btn.btn-primary');
            var hours = selectedSlots.length || 2;
            var subtotal = hours * pricePerHour;
            discountAmount = subtotal * 0.10;
            document.getElementById('discountDisplay').innerText = "-" + discountAmount.toFixed(2) + " บาท";
            feedback.className = "small mt-1 text-success fw-semibold";
            feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ใช้โค้ดส่วนลด 10% สำเร็จ!';
            recalculatePricing();
        } else if (code === "CLOUDFREE" || code === "DISCOUNT30") {
            discountAmount = 30;
            document.getElementById('discountDisplay').innerText = "-30.00 บาท";
            feedback.className = "small mt-1 text-success fw-semibold";
            feedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ใช้โค้ดส่วนลด 30 บาท สำเร็จ!';
            recalculatePricing();
        } else if (code === "") {
            discountAmount = 0;
            document.getElementById('discountDisplay').innerText = "-0.00 บาท";
            feedback.className = "small mt-1 text-secondary";
            feedback.innerText = "กรุณากรอกโค้ดโปรโมชั่น";
            recalculatePricing();
        } else {
            feedback.className = "small mt-1 text-danger fw-semibold";
            feedback.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> ไม่พบคูปองส่วนลดนี้ หรือหมดอายุแล้ว';
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        renderCalendar();
        recalculatePricing();
    });
</script>
