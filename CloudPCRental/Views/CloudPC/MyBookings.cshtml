    // ===== Virtual Desktop Simulator Interactive Functions =====
    var standbyTimerInterval = null;

    function startStandbyTimer(startDt) {
        if (standbyTimerInterval) clearInterval(standbyTimerInterval);
        if (!startDt) return;

        function updateStandby() {
            var now = new Date();
            var diff = Math.floor((startDt - now) / 1000);
            var el = document.getElementById("standbyCountdownLarge");
            if (diff > 0) {
                var h = Math.floor(diff / 3600);
                var m = Math.floor((diff % 3600) / 60);
                var s = diff % 60;
                if (el) el.innerText = String(h).padStart(2,'0') + ":" + String(m).padStart(2,'0') + ":" + String(s).padStart(2,'0');
            } else {
                if (el) el.innerText = "00:00:00 (ถึงเวลาใช้งานแล้ว)";
                clearInterval(standbyTimerInterval);
            }
        }
        updateStandby();
        standbyTimerInterval = setInterval(updateStandby, 1000);
    }

    function toggleVirtualFullscreen() {
        var frame = document.getElementById("vdesktopContainer");
        if (!frame) return;
        frame.classList.toggle("vfullscreen");
        if (frame.classList.contains("vfullscreen")) {
            showFeedback("เปิดโหมดเต็มหน้าจอ (คลิก 'เต็มจอ' อีกครั้งเพื่อย่อกลับ)", "info");
        }
    }

    function openSimApp(app) {
        // ซ่อนทุกหน้าต่างจำลองก่อน
        var steam = document.getElementById("simWinSteam");
        var taskmgr = document.getElementById("simWinTaskmgr");
        var terminal = document.getElementById("simWinTerminal");
        if (steam) steam.classList.add("d-none");
        if (taskmgr) taskmgr.classList.add("d-none");
        if (terminal) terminal.classList.add("d-none");

        if (app === 'steam' && steam) steam.classList.remove("d-none");
        else if (app === 'taskmgr' && taskmgr) taskmgr.classList.remove("d-none");
        else if (app === 'terminal' && terminal) terminal.classList.remove("d-none");
        else if (app === 'chrome') {
            showFeedback("กำลังเปิดเบราว์เซอร์ Google Chrome บน Cloud PC...", "success");
        } else if (app === 'premiere') {
            showFeedback("กำลังเปิด Adobe Premiere Pro 2024 (CUDA GPU Acceleration: Active)...", "success");
        } else if (app === 'storage') {
            showFeedback("เปิด This PC: ไดรฟ์ C: (1TB NVMe PCIe 4.0 SSD มีที่ว่าง 820 GB)", "info");
        }
    }

    function closeSimApp(app) {
        if (app === 'steam') document.getElementById("simWinSteam")?.classList.add("d-none");
        if (app === 'taskmgr') document.getElementById("simWinTaskmgr")?.classList.add("d-none");
        if (app === 'terminal') document.getElementById("simWinTerminal")?.classList.add("d-none");
    }

    function simulateGameLaunch(gameName) {
        var toast = document.getElementById("simLaunchToast");
        if (toast) {
            toast.className = "alert alert-success py-2 px-3 mt-3 mb-0";
            toast.innerHTML = '<div class="d-flex align-items-center gap-2"><div class="spinner-border spinner-border-sm text-success" role="status"></div><div>กำลังรัน <strong>' + gameName + '</strong> ด้วย NVIDIA RTX 4080 (DLSS 3.5 Frame Gen 120 FPS)...</div></div>';
            toast.classList.remove("d-none");
            setTimeout(function() {
                toast.innerHTML = '<i class="bi bi-play-circle-fill text-success me-1"></i> สตรีมเกม <strong>' + gameName + '</strong> ความละเอียด 4K HDR 120FPS เริ่มต้นสมบูรณ์แล้ว!';
            }, 1800);
        }
    }

    function toggleSimStartMenu() {
        showFeedback("Windows 11 Start Menu เปิดใช้งานบนเครื่อง Cloud PC", "info");
    }

    // ===== Countdown Timer & Real-time Status =====
    function formatDuration(secs) {
        if (secs <= 0) return "00:00:00";
        var h = Math.floor(secs / 3600);
        var m = Math.floor((secs % 3600) / 60);
        var s = secs % 60;
        return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }

    function parseDateSafe(dateStr) {
        if (!dateStr) return null;
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return null;
        // กรณีปีเป็น พ.ศ. (เกิน 2500) ให้แปลงเป็น ค.ศ.
        if (d.getFullYear() > 2500) {
            d.setFullYear(d.getFullYear() - 543);
        }
        return d;
    }

    function tickCountdowns() {
        var now = new Date();

        // อัปเดตนาฬิกาบน Taskbar ของเครื่องจำลอง
        var taskClock = document.getElementById("vtaskbarClock");
        if (taskClock) {
            taskClock.innerText = String(now.getHours()).padStart(2,'0') + ":" + String(now.getMinutes()).padStart(2,'0');
        }

        // Countdown สำหรับ "กำลังใช้งาน" — นับถอยหลังถึงเวลาสิ้นสุด
        document.querySelectorAll('[id^="countdown"]').forEach(function(el) {
            var endTime = parseDateSafe(el.dataset.end);
            if (!endTime) return;
            var diff = Math.floor((endTime - now) / 1000);
            if (diff > 0) {
                el.textContent = '(' + formatDuration(diff) + ')';
            } else {
                el.textContent = '(เสร็จสิ้น)';
            }
        });

        // แสดง "เริ่มในอีก X" สำหรับ "จองล่วงหน้า"
        document.querySelectorAll('[id^="startIn"]').forEach(function(el) {
            var startTime = parseDateSafe(el.dataset.start);
            if (!startTime) return;
            var diff = Math.floor((startTime - now) / 1000);
            if (diff > 0) {
                var d = Math.floor(diff / 86400);
                var h = Math.floor((diff % 86400) / 3600);
                var m = Math.floor((diff % 3600) / 60);
                if (d > 0) el.textContent = '(เริ่มในอีก ' + d + ' วัน ' + (h > 0 ? h + ' ชม.' : '') + ')';
                else if (h > 0) el.textContent = '(เริ่มในอีก ' + h + ' ชม. ' + m + ' นาที)';
                else if (m > 0) el.textContent = '(เริ่มในอีก ' + m + ' นาที)';
                else el.textContent = '(กำลังจะเริ่มใช้งาน...)';
            } else {
                el.textContent = '(ถึงเวลาใช้งานแล้ว)';
            }
        });
    }

    // เริ่ม tick ทันที แล้วทุก 1 วินาที
    tickCountdowns();
    setInterval(tickCountdowns, 1000);
</script>
}