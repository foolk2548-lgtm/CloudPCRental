                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded-2 p-2 bg-white">
                                <strong class="text-dark d-block">GPU</strong>
                                NVIDIA RTX 4080 (16GB VRAM)
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded-2 p-2 bg-white">
                                <strong class="text-dark d-block">Storage</strong>
                                1TB NVMe PCIe 4.0 SSD
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Machine Action Controls (4 Buttons from User's Screenshot) -->
                <div class="border-top pt-3">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sliders text-secondary me-1"></i> คำสั่งควบคุมเครื่อง</h6>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button" id="btnRestart" class="btn btn-outline-primary btn-sm rounded-2 px-3 py-2 fw-semibold" onclick="restartMachine()">
                            <i class="bi bi-arrow-repeat me-1" id="restartIcon"></i> รีสตาร์ทเครื่อง (Restart)
                        </button>
                        <button type="button" id="btnExtend" class="btn btn-outline-success btn-sm rounded-2 px-3 py-2 fw-semibold" onclick="extendTime()">
                            <i class="bi bi-clock-history me-1"></i> ต่อเวลาใช้งาน (+1 ชม.)
                        </button>
                        <button type="button" id="btnResetPass" class="btn btn-outline-warning btn-sm rounded-2 px-3 py-2 fw-semibold" onclick="resetPasswordModal()">
                            <i class="bi bi-shield-lock me-1"></i> รีเซ็ตรหัสผ่านเครื่อง
                        </button>
                        <button type="button" id="btnEndSession" class="btn btn-outline-danger btn-sm rounded-2 px-3 py-2 fw-semibold ms-auto" onclick="endSessionConfirm()">
