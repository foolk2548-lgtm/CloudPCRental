@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "ประวัติการจองของฉัน";
}

<style>
    /* สไตล์สำหรับ Virtual Cloud PC Desktop Simulator */
    .vdesktop-frame {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #1e293b;
        background: #090d16;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
        position: relative;
    }
    .vdesktop-frame.vfullscreen {
        position: fixed !important;
        inset: 0 !important;
        z-index: 1060 !important;
        width: 100vw !important;
        height: 100vh !important;
        border-radius: 0 !important;
        display: flex;
        flex-direction: column;
    }
    .vdesktop-frame.vfullscreen .vdesktop-screen {
        flex: 1;
        min-height: 0 !important;
        max-height: none !important;
        aspect-ratio: auto !important;
    }
    .vdesktop-topbar {
        background: #0f172a;
        color: #94a3b8;
        padding: 7px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #1e293b;
    }
    .vdot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .vdesktop-screen {
        position: relative;
        aspect-ratio: 16 / 9;
        min-height: 440px;
        max-height: 520px;
        background: #020617;
        overflow: hidden;
        user-select: none;
    }
    .vscreen-layer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    /* Standby Layer */
    .vstandby-layer {
        background: radial-gradient(circle at 50% 35%, #1e1b4b 0%, #090d16 75%, #020617 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
    }
    .vstandby-pulse-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(234, 179, 8, 0.15);
        border: 2px solid rgba(234, 179, 8, 0.5);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: vPulse 2.5s infinite ease-in-out;
    }
    @@keyframes vPulse {
        0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(234, 179, 8, 0.2); }
        50% { transform: scale(1.08); box-shadow: 0 0 35px rgba(234, 179, 8, 0.45); }
    }
    /* Active Windows 11 Desktop Layer */
    .vdesktop-layer {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
    }
    .vdesktop-wallpaper {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #090d16 0%, #1e1b4b 50%, #020617 100%);
        background-image: radial-gradient(at 80% 20%, rgba(99, 102, 241, 0.35) 0px, transparent 50%),
                          radial-gradient(at 20% 80%, rgba(236, 72, 153, 0.25) 0px, transparent 50%),
                          radial-gradient(at 50% 50%, rgba(59, 130, 246, 0.3) 0px, transparent 60%);
        z-index: 1;
    }
    .vdesktop-icons-grid {
        position: absolute;
        top: 15px;
        left: 15px;
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        gap: 15px;
        max-height: calc(100% - 70px);
        z-index: 5;
    }
    .vdesk-icon {
        width: 76px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 6px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .vdesk-icon:hover {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        transform: translateY(-2px);
    }
    .vdesk-icon-img {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        margin-bottom: 4px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
    }
    .vdesk-icon-label {
        color: #ffffff;
        font-size: 0.68rem;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 72px;
    }
    /* Simulated Windows */
    .vwindow {
        position: absolute;
        top: 35px;
        left: 110px;
        right: 25px;
        bottom: 60px;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 10px;
        overflow: hidden;
        z-index: 20;
        display: flex;
        flex-direction: column;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
        animation: vWinPop 0.2s ease-out;
    }
    @@keyframes vWinPop {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .vwindow-header {
        padding: 8px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #1e293b;
    }
    .vwindow-body {
        flex: 1;
        overflow-y: auto;
    }
    .vtaskbar {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 44px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(16px);
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 14px;
        z-index: 30;
    }
    .vtaskbar-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .vtask-btn {
        width: 34px;
        height: 34px;
        border-radius: 6px;
        border: none;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        cursor: pointer;
        transition: background 0.15s;
    }
    .vtask-btn:hover {
        background: rgba(255, 255, 255, 0.12);
    }
    .vtaskbar-tray {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.72rem;
        color: #e2e8f0;
    }
    .vtray-clock {
        font-family: monospace;
        font-size: 0.75rem;
    }
    .vblink-cursor {
        animation: vBlink 1s infinite;
    }
    @@keyframes vBlink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    /* สไตล์สำหรับการพิมพ์รายงานประวัติการจองเป็น PDF */
    @@media print {
        body > header,
        body > footer,
        aside,
        .sidebar-panel,
        .top-user-bar,
        .btn,
        .alert,
        #liveChatWidget,
        .chat-widget,
        .d-print-none,
        #bookingSearchInput,
        #bookingStatusFilter {
            display: none !important;
            visibility: hidden !important;
        }

        .layout-with-sidebar,
        .main-content-panel,
        body, html {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            color: #111827 !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Sarabun", sans-serif !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .card-cloudpc {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
            margin-bottom: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        #bookingsTable {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        #bookingsTable th, #bookingsTable td {
            border: 1px solid #cbd5e1 !important;
            padding: 8px 10px !important;
            font-size: 0.8rem !important;
        }

        #bookingsTable th:last-child, #bookingsTable td:last-child {
            display: none !important; /* ซ่อนคอลัมน์การจัดการในการพิมพ์รายงานสรุป */
        }

        .d-print-header {
            display: block !important;
            margin-bottom: 20px !important;
            border-bottom: 2px solid #0f172a !important;
            padding-bottom: 12px !important;
        }

        @@page {
            size: A4 landscape;
            margin: 10mm 12mm;
        }
    }
</style>

<!-- Print Report Header (แสดงเฉพาะเมื่อกดพิมพ์ / ดาวน์โหลด PDF) -->
<div class="d-none d-print-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold text-dark mb-0"><i class="bi bi-cpu-fill text-primary"></i> CloudPC Thailand - รายงานประวัติการจองเครื่องคอมพิวเตอร์</h4>
            <div class="small text-muted">บริษัท คลาวด์พีซี เซอร์วิสเซส (ประเทศไทย) จำกัด | ระบบเช่าคอมพิวเตอร์ออนไลน์ประสิทธิภาพสูง</div>
        </div>
        <div class="text-end small text-muted">
            <div>ผู้ใช้งาน: <strong>@(User?.Identity?.Name ?? "ลูกค้าผู้ใช้บริการ")</strong></div>
            <div>ออกรายงานเมื่อ: @CloudPCRental.Models.MockDataStore.GetCurrentThaiDateTime()</div>
        </div>
    </div>
</div>

<!-- Page Alert Container -->
<div id="pageAlertBox" class="alert alert-success d-none shadow-sm border-0 d-flex align-items-center mb-4 rounded-3" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2" id="pageAlertIcon"></i>
    <div id="pageAlertText"></div>
    <button type="button" class="btn-close ms-auto" onclick="hidePageAlert()"></button>
</div>

<!-- Header (Wireframe Page 7) -->
<div class="mb-4">
    <div class="text-muted small">แดชบอร์ดลูกค้า</div>
    <h3 class="fw-bold text-dark mb-0">ประวัติการจองของฉัน</h3>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">การจองทั้งหมด</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0" id="totalBookingsStat">@(ViewBag.TotalBookingsCount ?? 4) <small class="fs-6 text-muted">ครั้ง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">ประวัติการเช่าทั้งหมดของคุณ</div>
                </div>
                <div class="p-3 bg-light rounded-3 text-secondary">
                    <i class="bi bi-calendar3 fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">กำลังใช้งานอยู่</span>
                    <h3 class="fw-bold text-primary mt-1 mb-0" id="activeMachinesStat">@(ViewBag.ActiveMachinesCount ?? 0) <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">@((ViewBag.ActiveMachinesCount != null && (int)ViewBag.ActiveMachinesCount > 0) ? "กำลังเชื่อมต่อออนไลน์ในขณะนี้" : "ไม่มีเครื่องที่เชื่อมต่อค้างอยู่")</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-play-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">เวลาสะสมรวม</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0" id="accumulatedHoursStat">@(ViewBag.AccumulatedHoursCount ?? 48) <small class="fs-6 text-muted">ชั่วโมง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">เวลาการใช้งาน Cloud PC ทั้งหมด</div>
                </div>
                <div class="p-3 bg-light rounded-3 text-secondary">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bookings Table Section -->
<div class="card-cloudpc bg-white p-4 mb-5 border rounded-4 shadow-sm" style="margin-bottom: 90px !important;">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-task text-primary me-1"></i> รายการประวัติการจองทั้งหมด @(ViewBag.TotalBookingsCount ?? 0) รายการ
        </h6>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input type="text" id="bookingSearchInput" class="form-control form-control-sm rounded-2" 
                   placeholder="ค้นหาเลขที่จอง, ชื่อเครื่อง..." style="width: 190px;" oninput="filterBookingsTable()" />
            <select id="bookingStatusFilter" class="form-select form-select-sm rounded-2" style="width: 140px;" onchange="filterBookingsTable()">
                <option value="all" selected>สถานะทั้งหมด</option>
                <option value="booked">จอง / กำลังใช้งาน</option>
                <option value="completed">เสร็จสิ้น</option>
                <option value="cancelled">ยกเลิก / คืนเงิน</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small" id="bookingsTable">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3 py-3" style="width: 130px; white-space: nowrap;">เลขที่จอง</th>
                    <th class="py-3" style="min-width: 220px;">ชื่อเครื่อง</th>
                    <th class="py-3" style="min-width: 260px;">วันเวลาที่จอง</th>
                    <th class="py-3" style="width: 190px; white-space: nowrap;">สถานะ</th>
                    <th class="text-end pe-3 py-3" style="min-width: 210px; white-space: nowrap;">การจัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.NewBookings != null && ((List<CloudPCRental.Models.Booking>)ViewBag.NewBookings).Any())
                {
                    var thaiCulture = new System.Globalization.CultureInfo("th-TH");
                    foreach (var nb in (List<CloudPCRental.Models.Booking>)ViewBag.NewBookings)
                    {
                        var machine = nb.Machine ?? CloudPCRental.Models.MockDataStore.GetMachineById(nb.MachineId);
                        var mName = (machine != null && CloudPCRental.Models.MockDataStore.StandardMachineNames.TryGetValue(machine.MachineId, out var sName))
                            ? sName 
                            : (machine?.MachineName ?? "Cloud PC");
                        if (mName.Contains("à") || mName.Contains("¹") || mName.Contains("¸") || string.IsNullOrWhiteSpace(mName)) 
                            mName = CloudPCRental.Models.MockDataStore.StandardMachineNames.GetValueOrDefault(nb.MachineId, $"เครื่องคอมพิวเตอร์ PC-{nb.MachineId:D3}");

                        var mSpec = $"Spec: {machine?.CPU ?? "High CPU"} | {machine?.RAM ?? "32GB RAM"} | {machine?.GPU ?? "High GPU"}";
                        
                        string timeText;
                        if (nb.MachineId == 0 || (nb.Note != null && (nb.Note.Contains("เติมเงิน") || nb.Note.Contains("Wallet"))))
                        {
                            timeText = $"{nb.PaymentDate.ToString("d MMMM yyyy, HH:mm น.", thaiCulture)} (เติมเงินเข้ากระเป๋าเงิน)";
                        }
                        else if (!string.IsNullOrEmpty(nb.Note) && nb.Note.Contains("(") && !nb.Note.Contains("à") && !nb.Note.Contains("¹") && !nb.Note.Contains("¸"))
                        {
                            timeText = nb.Note;
                        }
                        else
                        {
                            timeText = $"{nb.PaymentDate.ToString("d MMMM yyyy, HH:mm", thaiCulture)} - {nb.PaymentDate.AddHours(nb.RentalHours):HH:mm น.} ({nb.RentalHours} ชม.)";
                        }

                        string rowStatus = (nb.PaymentStatus == "Completed") 
                            ? "completed" 
                            : ((nb.PaymentStatus == "Refunded" || nb.PaymentStatus == "RefundRejected" || nb.PaymentStatus == "Rejected") 
                                ? "cancelled" 
                                : ((nb.PaymentStatus == "RefundRequested" || nb.PaymentStatus == "Pending") 
                                    ? "pending" 
                                    : "booked"));

                        <tr id="bookingRow@(nb.BookingId)" data-status="@rowStatus" data-search="#cpc-@nb.BookingId @mName.ToLower()">
                            <td class="ps-3" style="white-space: nowrap;">
                                <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="fw-bold text-primary font-monospace text-decoration-none" title="คลิกเพื่อดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                    <i class="bi bi-receipt me-1"></i>#CPC-@nb.BookingId
                                </a>
                            </td>
                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-1">
                                    <span>@mName</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.65rem;">เครื่องเช่า</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.72rem;">@mSpec</div>
                            </td>
                            <td id="bookingTime@(nb.BookingId)" style="white-space: normal; line-height: 1.4;">@timeText</td>
                            <td id="statusCell@(nb.BookingId)" style="white-space: nowrap;">
                                @if (nb.PaymentStatus == "Pending")
                                {
                                    <span class="badge" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-hourglass-split me-1 text-warning-emphasis"></i> รอฝ่ายบัญชีตรวจสอบสลิป
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Rejected")
                                {
                                    <span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-x-circle me-1"></i> ปฏิเสธสลิปโอนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "RefundRequested")
                                {
                                    <span class="badge" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-hourglass-split me-1 text-warning-emphasis"></i> รอฝ่ายบัญชีตรวจสอบคืนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Refunded")
                                {
                                    <span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-check2-circle me-1"></i> คืนเงินเรียบร้อย (+@nb.TotalAmount.ToString("N2") ฿)
                                    </span>
                                }
                                else if (nb.PaymentStatus == "RefundRejected")
                                {
                                    <span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-x-circle me-1"></i> ปฏิเสธการคืนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Completed")
                                {
                                    <span class="badge" style="background-color: #f0fdf4 !important; color: #15803d !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;">
                                        <i class="bi bi-check-circle-fill me-1"></i> เสร็จสิ้น
                                    </span>
                                }
                                else if (nb.PaymentStatus == "InUse")
                                {
                                    <span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;"
                                          id="inuseBadge@(nb.BookingId)">
                                        <i class="bi bi-lightning-charge-fill me-1 text-success"></i> กำลังใช้งาน
                                        @if (nb.EndTime.HasValue)
                                        {
                                            <span class="ms-1 font-monospace" id="countdown@(nb.BookingId)" data-end="@nb.EndTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)"></span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #eff6ff !important; color: #1d4ed8 !important; border: 1px solid #bfdbfe !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center; white-space: nowrap;"
                                          id="bookedBadge@(nb.BookingId)">
                                        <i class="bi bi-calendar-check me-1"></i> จองล่วงหน้า (ยังไม่ถึงเวลา)
                                        @if (nb.StartTime.HasValue)
                                        {
                                            <span class="ms-1 fw-normal text-muted font-monospace" style="font-size:0.75rem;" id="startIn@(nb.BookingId)" data-start="@nb.StartTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)"></span>
                                        }
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3" id="actionCell@(nb.BookingId)" style="white-space: nowrap;">
                                @if (nb.PaymentStatus == "Pending")
                                {
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        <button type="button" class="btn btn-outline-warning btn-sm py-1 px-3 rounded-2 fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                onclick="openCustomerSlipModal('@nb.BookingId', '@(nb.SlipImageUrl ?? "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&auto=format&fit=crop&q=80")', @nb.TotalAmount)">
                                            <i class="bi bi-image me-1"></i> ดูสลิปที่ส่งตรวจ
                                        </button>
                                    </div>
                                }
                                else if (nb.PaymentStatus == "Rejected")
                                {
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-1 px-3 rounded-2 fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                onclick="openCustomerRejectReasonModal('@nb.BookingId', '@(nb.Note ?? "สลิปไม่ถูกต้อง หรือยอดเงินไม่ตรงกับรายการ")')">
                                            <i class="bi bi-exclamation-circle me-1"></i> ดูเหตุผลปฏิเสธ
                                        </button>
                                    </div>
                                }
                                else if (nb.PaymentStatus == "RefundRequested" || nb.PaymentStatus == "RefundRejected")
                                {
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        <button type="button" class="btn btn-outline-warning btn-sm py-1 px-3 rounded-2 fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                onclick="openRefundStatusModal('@nb.BookingId', '@nb.PaymentStatus', '@(nb.RefundReason ?? "ขอยกเลิกการจองและขอคืนเงิน")', '@(nb.Note ?? "ฝ่ายบัญชีกำลังตรวจสอบข้อมูล")', @nb.TotalAmount)">
                                            <i class="bi bi-clock-history me-1"></i> ดูสถานะคำขอคืนเงิน
                                        </button>
                                    </div>
                                }
                                else if (nb.PaymentStatus == "Refunded")
                                {
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        <button type="button" class="btn btn-outline-success btn-sm py-1 px-3 rounded-2 fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                onclick="openRefundStatusModal('@nb.BookingId', '@nb.PaymentStatus', '@(nb.RefundReason ?? "")', '@(nb.Note ?? "คืนเงินเรียบร้อยแล้ว")', @nb.TotalAmount)">
                                            <i class="bi bi-check-circle-fill me-1"></i> ดูผลการคืนเงิน (+@nb.TotalAmount.ToString("N0") ฿)
                                        </button>
                                    </div>
                                }
                                else if (nb.PaymentStatus == "Completed")
                                {
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        <span class="badge bg-light text-muted border px-3 py-2 fw-normal" style="font-size: 0.78rem;">
                                            <i class="bi bi-check2-all text-success me-1"></i> สิ้นสุดการเช่าแล้ว
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    var rowCpu = machine?.CPU ?? "AMD Ryzen 9 7900X";
                                    var rowRam = machine?.RAM ?? "32GB DDR5";
                                    var rowGpu = machine?.GPU ?? "RTX 4080 (16GB)";
                                    var rowStorage = "1TB NVMe PCIe 4.0 SSD";
                                    var rowPrice = machine?.PricePerHour ?? 15.00m;
                                    var rowStartIso = nb.StartTime?.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) ?? "";
                                    var rowEndIso = nb.EndTime?.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) ?? "";
                                    var rowIp = $"103.22.180.{(nb.MachineId * 17) % 200 + 20}:3389";
                                    var rowUser = $"CloudUser_{nb.BookingId}";
                                    var rowPass = $"Pass#{(nb.BookingId * 83) % 9000 + 1000}!";
                                    bool isLiveInUse = (nb.PaymentStatus == "InUse");

                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 text-nowrap">
                                        <a asp-action="Receipt" asp-route-id="@nb.BookingId" target="_blank" class="btn btn-outline-secondary btn-sm py-1 px-2 rounded-2 text-nowrap fw-semibold shadow-xs" style="font-size: 0.78rem;" title="ดูและดาวน์โหลดใบเสร็จรับเงิน (PDF)">
                                            <i class="bi bi-receipt text-danger me-1"></i> ใบเสร็จ
                                        </a>
                                        @if (isLiveInUse)
                                        {
                                            <button type="button" class="btn btn-primary btn-sm py-1 px-3 rounded-2 shadow-sm fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                    onclick="openMachineControl(@nb.BookingId, '@mName', @nb.MachineId, @nb.RentalHours, @rowPrice, '@rowStartIso', '@rowEndIso', '@Html.Raw(Html.Encode(timeText))', '@rowCpu', '@rowRam', '@rowGpu', '@rowStorage', '@rowIp', '@rowUser', '@rowPass')">
                                                <i class="bi bi-pc-display me-1"></i> เข้าใช้งานเครื่อง
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm py-1 px-3 rounded-2 shadow-xs fw-semibold text-nowrap" style="font-size: 0.78rem;" 
                                                    onclick="openMachineControl(@nb.BookingId, '@mName', @nb.MachineId, @nb.RentalHours, @rowPrice, '@rowStartIso', '@rowEndIso', '@Html.Raw(Html.Encode(timeText))', '@rowCpu', '@rowRam', '@rowGpu', '@rowStorage', '@rowIp', '@rowUser', '@rowPass')">
                                                <i class="bi bi-clock-history me-1 text-warning"></i> ดูหน้าจอคิว (ยังไม่ถึงเวลา)
                                            </button>
                                        }
                                        <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 rounded-2 text-nowrap" style="font-size: 0.78rem;" onclick="openRefundModal('@nb.BookingId', '@mName', @nb.TotalAmount)" title="ขอยกเลิกการจองและขอคืนเงิน">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> ยกเลิก
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <div>ยังไม่มีประวัติการจองเครื่องคอมพิวเตอร์ในขณะนี้</div>
                            <div class="mt-3">
                                <a asp-action="Machines" class="btn btn-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-search me-1"></i> ค้นหาเครื่องคอมพิวเตอร์ที่พร้อมใช้งาน
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- No Results Row -->
        <div id="noBookingsFound" class="text-center py-4 text-muted d-none">
            <i class="bi bi-search fs-3 d-block mb-1 text-secondary"></i>
            ไม่พบรายการประวัติการจองที่ตรงกับเงื่อนไขการค้นหา
        </div>
    </div>

    <!-- Bottom summary -->
    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top small text-muted">
        <span id="bookingCountText">แสดงทั้งหมด @(ViewBag.TotalBookingsCount ?? 4) รายการประวัติการจอง</span>
        <span class="text-success"><i class="bi bi-shield-check me-1"></i> เชื่อมต่อระบบคลาวด์เสร็จสมบูรณ์</span>
    </div>
</div>

<!-- Modal: จัดการเครื่อง Cloud PC และหน้าจอจำลอง (Virtual Cloud PC Desktop Simulator) -->
<div class="modal fade" id="machineControlModal" tabindex="-1" aria-labelledby="machineControlModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header border-bottom px-4 pt-3 pb-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-display fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="machineControlModalLabel">
                            ศูนย์จัดการเครื่องและหน้าจอจำลอง Cloud PC (Virtual Remote Desktop)
                        </h5>
                        <div class="text-muted small">
                            รหัสการจอง: <span class="fw-bold text-dark font-monospace" id="modalMachineCode">#CPC-94812</span> &bull; 
                            เครื่อง: <span class="fw-bold text-primary" id="modalMachineTitle">Extreme Gaming PC</span> &bull; 
                            รอบเวลาจอง: <span class="fw-bold text-dark" id="modalBookingTime"></span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold" id="machineStatusBadge">
                        <i class="bi bi-check-circle-fill me-1"></i> เชื่อมต่อออนไลน์ (Online)
                    </span>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <div class="modal-body p-4 bg-light">
                <!-- Alert: แสดงเมื่อยังไม่ถึงเวลาจองจริง -->
                <div id="modalNotStartedAlert" class="alert alert-warning border border-warning-subtle rounded-3 p-3 mb-3 d-none shadow-xs">
                    <div class="d-flex align-items-start gap-3">
                        <div class="p-2 bg-warning-subtle text-warning-emphasis rounded-circle">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                <span>ขณะนี้ยังไม่ถึงเวลาเริ่มใช้งานเครื่องตามคิวที่คุณจองไว้</span>
                                <span class="badge bg-warning text-dark px-2 py-1" style="font-size: 0.72rem;">สถานะ: เครื่องยังไม่พร้อมใช้งาน</span>
                            </div>
                            <div class="small text-secondary mt-1" style="line-height: 1.6;">
                                รอบเวลาที่คุณจองคือ: <strong class="text-primary font-monospace" id="modalBookingTimeAlert">...</strong><br />
                                <span class="text-danger fw-semibold">
                                    <i class="bi bi-shield-lock-fill me-1"></i> ระบบล็อกการเชื่อมต่อไว้เนื่องจากยังไม่ถึงเวลาจองของคุณ (หากมีผู้ใช้งานคนอื่นในคิวก่อนหน้า ระบบจะสลับเครื่องและเปิดสิทธิ์ให้คุณอัตโนมัติเมื่อถึงเวลา)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =============================================================== -->
                <!-- VIRTUAL CLOUD PC DESKTOP SCREEN (หน้าจอจำลองการใช้งานคอมพิวเตอร์) -->
                <!-- =============================================================== -->
                <div class="vdesktop-frame mb-4" id="vdesktopContainer">
                    <!-- Stream Overlay Bar -->
                    <div class="vdesktop-topbar">
                        <div class="d-flex align-items-center gap-2">
                            <span class="vdot bg-danger"></span>
                            <span class="vdot bg-warning"></span>
                            <span class="vdot bg-success"></span>
                            <span class="fw-bold text-light ms-2"><i class="bi bi-cast me-1 text-info"></i> CloudPC Remote Stream v4.2</span>
                            <span class="badge bg-dark border border-secondary text-secondary ms-2" style="font-size: 0.68rem;" id="vdesktopStreamStatus">LIVE</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 small font-monospace">
                            <span class="text-success"><i class="bi bi-reception-4 me-1"></i> <span id="vdesktopPing">12 ms</span></span>
                            <span class="text-info"><i class="bi bi-speedometer2 me-1"></i> 60 FPS</span>
                            <span class="text-warning d-none d-md-inline"><i class="bi bi-activity me-1"></i> 35.4 Mbps</span>
                            <span class="text-light d-none d-lg-inline"><i class="bi bi-gpu-card me-1"></i> <span id="vdesktopGpuTag">RTX 4080 (Active)</span></span>
                            <button type="button" class="btn btn-outline-light btn-sm py-0 px-2 rounded" style="font-size: 0.72rem;" onclick="toggleVirtualFullscreen()" title="โหมดขยายเต็มหน้าจอ">
                                <i class="bi bi-arrows-fullscreen me-1"></i> เต็มจอ
                            </button>
                        </div>
                    </div>

                    <!-- Screen Viewport -->
                    <div class="vdesktop-screen" id="vdesktopScreen">
                        <!-- MODE A: STANDBY SCREEN (แสดงเมื่อยังไม่ถึงเวลาเริ่มใช้งาน) -->
                        <div id="vscreenStandby" class="vscreen-layer vstandby-layer d-none">
                            <div class="vstandby-content text-center text-white p-4">
                                <div class="vstandby-pulse-circle mb-3">
                                    <i class="bi bi-shield-lock-fill text-warning display-4"></i>
                                </div>
                                <h4 class="fw-bold text-white mb-1">
                                    <i class="bi bi-pc-display me-2 text-info"></i> Cloud PC Standby & Reserved
                                </h4>
                                <div class="text-white-50 small mb-3">
                                    เครื่องนี้ถูกจัดสรรและล็อกทรัพยากรไว้สำหรับคิวของคุณเรียบร้อยแล้ว
                                </div>

                                <div class="card bg-dark bg-opacity-75 border border-secondary border-opacity-50 rounded-3 p-3 mb-3 mx-auto shadow" style="max-width: 580px;">
                                    <div class="row g-2 text-start small">
                                        <div class="col-6">
                                            <span class="text-muted d-block">เครื่องที่จอง:</span>
                                            <strong class="text-light" id="standbyMachineNameDisplay">Extreme Gaming PC</strong>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted d-block">สถานะคิว:</span>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> รอถึงเวลาเริ่มจอง</span>
                                        </div>
                                        <div class="col-12 border-top border-secondary border-opacity-25 pt-2 mt-2">
                                            <span class="text-muted d-block">ช่วงเวลาที่คุณจองไว้:</span>
                                            <strong class="text-info font-monospace fs-6" id="standbyBookingTimeDisplay">23 พฤศจิกายน 2569, 08:00 - 10:00 (2 ชม.)</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="text-warning-emphasis small text-uppercase letter-spacing-1">เครื่องจะพร้อมเปิดใช้งานอัตโนมัติในอีก</div>
                                    <div class="display-5 fw-bold font-monospace text-warning mt-1" id="standbyCountdownLarge">--:--:--</div>
                                </div>

                                <div class="d-inline-flex flex-wrap gap-2 justify-content-center small text-muted">
                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 py-1 px-2">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> GPU RTX 4080: Standby
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 py-1 px-2">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> RAM 32GB DDR5: Ready
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 py-1 px-2">
                                        <i class="bi bi-check-circle-fill text-success me-1"></i> 1TB NVMe: Profile Loaded
                                    </span>
                                </div>

                                <div class="mt-3 text-secondary" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle me-1"></i> หากมีผู้ใช้งานคิวก่อนหน้า ระบบจะทำการเคลียร์ข้อมูลชั่วคราวและเปิดให้คุณเชื่อมต่อได้ทันทีเมื่อถึงเวลาจอง
                                </div>
                            </div>
                        </div>

                        <!-- MODE B: ACTIVE WINDOWS 11 DESKTOP (แสดงเมื่อถึงเวลาใช้งานแล้ว) -->
                        <div id="vscreenDesktop" class="vscreen-layer vdesktop-layer">
                            <!-- Desktop Wallpaper (Windows 11 Bloom Style) -->
                            <div class="vdesktop-wallpaper"></div>

                            <!-- Desktop App Icons -->
                            <div class="vdesktop-icons-grid">
                                <div class="vdesk-icon" onclick="openSimApp('steam')" title="คลิกเพื่อเปิด Steam และทดลองเล่นเกม">
                                    <div class="vdesk-icon-img bg-dark text-info"><i class="bi bi-steam"></i></div>
                                    <span class="vdesk-icon-label">Steam</span>
                                </div>
                                <div class="vdesk-icon" onclick="openSimApp('taskmgr')" title="คลิกเพื่อตรวจสอบสเปกและกราฟการทำงาน">
                                    <div class="vdesk-icon-img bg-primary text-white"><i class="bi bi-graph-up"></i></div>
                                    <span class="vdesk-icon-label">Task Manager</span>
                                </div>
                                <div class="vdesk-icon" onclick="openSimApp('chrome')" title="คลิกเพื่อเปิดเบราว์เซอร์">
                                    <div class="vdesk-icon-img bg-white text-danger"><i class="bi bi-browser-chrome"></i></div>
                                    <span class="vdesk-icon-label">Google Chrome</span>
                                </div>
                                <div class="vdesk-icon" onclick="openSimApp('terminal')" title="คลิกเพื่อเปิด Terminal สั่งการ">
                                    <div class="vdesk-icon-img bg-black text-success"><i class="bi bi-terminal"></i></div>
                                    <span class="vdesk-icon-label">PowerShell</span>
                                </div>
                                <div class="vdesk-icon" onclick="openSimApp('premiere')" title="คลิกเพื่อเปิดโปรแกรมตัดต่อ">
                                    <div class="vdesk-icon-img bg-dark text-purple" style="color: #c084fc;"><i class="bi bi-film"></i></div>
                                    <span class="vdesk-icon-label">Premiere Pro</span>
                                </div>
                                <div class="vdesk-icon" onclick="openSimApp('storage')" title="คลิกเพื่อดูไดรฟ์ SSD 1TB">
                                    <div class="vdesk-icon-img bg-warning-subtle text-warning-emphasis"><i class="bi bi-hdd-fill"></i></div>
                                    <span class="vdesk-icon-label">This PC (1TB)</span>
                                </div>
                            </div>

                            <!-- Interactive Simulated Window: Steam -->
                            <div class="vwindow shadow-lg d-none" id="simWinSteam">
                                <div class="vwindow-header bg-dark text-light">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-steam text-info"></i>
                                        <span class="fw-semibold small">Steam Client - คลังเกมพร้อมเล่น</span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-white-50 p-0" onclick="closeSimApp('steam')"><i class="bi bi-x-lg"></i></button>
                                </div>
                                <div class="vwindow-body bg-dark text-light p-3 small">
