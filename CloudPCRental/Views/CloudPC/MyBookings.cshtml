                </div>
                <img id="customerSlipModalImg" src="" alt="Slip Preview" class="img-fluid rounded shadow-sm border" style="max-height: 460px;" />
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm px-4 rounded-3" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: ดูเหตุผลการปฏิเสธสลิป (Customer Reject Reason Modal) -->
<div class="modal fade" id="customerRejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="bi bi-x-octagon-fill me-2"></i> สลิปโอนเงินถูกปฏิเสธโดยฝ่ายบัญชี
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small text-muted">รหัสรายการจอง:</label>
                    <div class="fw-bold font-monospace text-dark" id="customerRejectCode">#CPC-0000</div>
                </div>
                <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-3 mb-3">
                    <div class="fw-semibold text-danger small mb-1">เหตุผลจากฝ่ายบัญชี:</div>
                    <div class="text-dark small" id="customerRejectReasonText">-</div>
                </div>
                <div class="text-muted small">
                    <i class="bi bi-arrow-repeat me-1"></i> คุณสามารถทำการจองใหม่และแนบสลิปที่ถูกต้องได้ตลอดเวลาครับ
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary btn-sm px-4 rounded-3" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
</div>

<!-- Form สำหรับยกเลิกการจองและคืนเงินเข้ากระเป๋าเงินแบบเรียลไทม์ (Instant Demo) -->
<form id="cancelBookingRealtimeForm" asp-action="CancelBooking" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="refundAmount" value="60.00" />
    <input type="hidden" name="bookingCode" value="#CPC-94812" />
</form>

@section Scripts {
<script>
    // 1. Live Countdown Timer (Initialized to 03:45:18 = 13518 seconds)
    var remainingSeconds = (3 * 3600) + (45 * 60) + 18;
    var timerInterval = null;

    function formatTime(totalSecs) {
        if (totalSecs <= 0) return "00:00:00 (หมดเวลา)";
        var h = Math.floor(totalSecs / 3600);
        var m = Math.floor((totalSecs % 3600) / 60);
        var s = totalSecs % 60;
        return (h < 10 ? "0" + h : h) + ":" + 
               (m < 10 ? "0" + m : m) + ":" + 
               (s < 10 ? "0" + s : s);
    }

    function startTimer() {
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(function() {
            if (remainingSeconds > 0) {
                remainingSeconds--;
                var clock = document.getElementById("countdownClock");
                if (clock) clock.innerText = formatTime(remainingSeconds);
            } else {
                clearInterval(timerInterval);
                var clock = document.getElementById("countdownClock");
                if (clock) clock.innerText = "หมดเวลาใช้งาน";
            }
        }, 1000);
    }
    startTimer();

    // 2. Copy to Clipboard with Feedback and Icon Change
    function copyToClipboard(elementId, btnId, label) {
        var copyText = document.getElementById(elementId);
        if (!copyText) return;
        
        navigator.clipboard.writeText(copyText.value).then(function() {
            showFeedback("คัดลอก " + label + " เรียบร้อยแล้ว: " + copyText.value, "success");
            var btn = document.getElementById(btnId);
            if (btn) {
                var oldHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i>';
                setTimeout(function() { btn.innerHTML = oldHtml; }, 1500);
            }
        }).catch(function() {
            // Fallback
            copyText.select();
            document.execCommand("copy");
            showFeedback("คัดลอก " + label + " เรียบร้อยแล้ว", "success");
        });
    }

    // 3. Toggle Password Visibility
    function togglePasswordVisibility() {
        var field = document.getElementById("passField");
        var icon = document.getElementById("eyeIcon");
        if (field.type === "password") {
            field.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        } else {
            field.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }

    // 4. Restart Machine
    function restartMachine() {
        var btn = document.getElementById("btnRestart");
        var icon = document.getElementById("restartIcon");
        var badge = document.getElementById("machineStatusBadge");
        var ping = document.getElementById("machinePing");

        btn.disabled = true;
        badge.className = "badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 me-2";
        badge.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> กำลังรีสตาร์ทเครื่อง...';
        ping.innerHTML = '<i class="bi bi-arrow-repeat text-warning me-1"></i> --- ms';
        showFeedback("ส่งสัญญาณรีสตาร์ทเครื่อง PRO 01 ไปยัง Hypervisor สำเร็จ กำลังบูตระบบใหม่...", "warning");

        setTimeout(function() {
            btn.disabled = false;
            badge.className = "badge bg-success-subtle text-success border border-success-subtle px-2 py-1 me-2";
            badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> เชื่อมต่อออนไลน์ (Online)';
            ping.innerHTML = '<i class="bi bi-reception-4 text-success me-1"></i> 12 ms';
            showFeedback("เครื่อง #CPC-94812 รีสตาร์ทและเชื่อมต่อออนไลน์พร้อมใช้งานเรียบร้อยแล้ว!", "success");
        }, 2200);
    }

    // 5. Extend Time (+1 Hour with Wallet Balance Check)
    var currentHours = 4;
    function extendTime() {
        var extendPrice = 15.00;
        var navEl = document.getElementById("customerNavBalance");
        var currentNavText = navEl ? navEl.innerText.replace(" THB", "").replace(/,/g, "") : "600";
        var currentBal = parseFloat(currentNavText) || 0;

        if (currentBal < extendPrice) {
            showFeedback("ยอดเงินในกระเป๋าไม่เพียงพอสำหรับการต่อเวลา (มี " + currentBal.toFixed(2) + " THB ต้องการ 15.00 THB) คุณจะต้องมีเงินเพียงพอกับค่าใช้จ่าย กรุณาเติมเงินก่อนครับ", "danger");
            showPageAlert("ยอดเงินในกระเป๋าไม่เพียงพอสำหรับการต่อเวลา (มี " + currentBal.toFixed(2) + " THB ต้องการ 15.00 THB) กรุณาเติมเงินเข้ากระเป๋าเงินก่อนครับ", "danger");
            return;
        }

        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var formData = new FormData();
        formData.append('amount', extendPrice);
        formData.append('title', 'ต่อเวลาใช้งานเครื่อง #CPC-94812 (+1 ชั่วโมง)');
        formData.append('__RequestVerificationToken', token);

        fetch('/CloudPC/DeductWalletAjax', {
            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                if (navEl) navEl.innerText = data.formatted;
                remainingSeconds += 3600;
                var clock = document.getElementById("countdownClock");
                if (clock) clock.innerText = formatTime(remainingSeconds);

                currentHours += 1;
                var timeCell = document.getElementById("bookingTime94812");
                if (timeCell) {
                    var endHour = 14 + currentHours;
                    timeCell.innerText = `25 ต.ค. 2023, 14:00 - ${endHour}:00 (${currentHours} ชม.)`;
                }

                var stat = document.getElementById("accumulatedHoursStat");
                if (stat) stat.innerHTML = `${48 + (currentHours - 4)} <small class="fs-6 text-muted">ชั่วโมง</small>`;

                showFeedback(`หักค่าต่อเวลา -${extendPrice.toFixed(2)} THB สำเร็จ! ขยายเวลาถึง ${14 + currentHours}:00 น. (ยอดคงเหลือ: ${data.formatted})`, "success");
                showPageAlert(`ต่อเวลาการจองเครื่อง #CPC-94812 สำเร็จ (+1 ชม.) หักค่าบริการ ${extendPrice.toFixed(2)} THB ยอดเงินคงเหลือ: ${data.formatted}`, "success");
            } else {
                showFeedback(data.message || "ยอดเงินคงเหลือไม่พอสำหรับการต่อเวลา", "danger");
                showPageAlert(data.message || "ยอดเงินคงเหลือไม่พอสำหรับการต่อเวลา กรุณาเติมเงินก่อนครับ", "danger");
            }
        })
        .catch(function() {
            remainingSeconds += 3600;
            var clock = document.getElementById("countdownClock");
            if (clock) clock.innerText = formatTime(remainingSeconds);
            showFeedback("ต่อเวลาการใช้งานสำเร็จ +1 ชั่วโมง!", "success");
        });
    }

    // 6. Reset Password
    function resetPasswordModal() {
        var randomNum = Math.floor(1000 + Math.random() * 9000);
        var newPass = "Pass#" + randomNum + "!";
        var passInput = document.getElementById("passField");
        passInput.value = newPass;
        passInput.type = "text";
        
        var icon = document.getElementById("eyeIcon");
        if (icon) {
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        }

        showFeedback("รีเซ็ตรหัสผ่านเครื่องใหม่เป็น: " + newPass + " เรียบร้อยแล้ว", "success");
    }

    // 7. End Rental / Return Machine
    function endSessionConfirm() {
        if (confirm("คุณแน่ใจหรือไม่ว่าต้องการคืนเครื่องและสิ้นสุดการเช่า #CPC-94812 ในครั้งนี้?")) {
            // Stop timer
            if (timerInterval) clearInterval(timerInterval);
            var clock = document.getElementById("countdownClock");
            if (clock) clock.innerText = "สิ้นสุดการเช่าแล้ว";

            var badge = document.getElementById("machineStatusBadge");
            if (badge) {
                badge.className = "badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 me-2";
                badge.innerHTML = '<i class="bi bi-power me-1"></i> สิ้นสุดการเช่าแล้ว';
            }

            // Disable buttons
            document.getElementById("btnRestart").disabled = true;
            document.getElementById("btnExtend").disabled = true;
            document.getElementById("btnResetPass").disabled = true;
            document.getElementById("btnEndSession").disabled = true;

            // Update row in table
            var row = document.getElementById("bookingRow94812");
            if (row) row.setAttribute("data-status", "completed");

            var statusCell = document.getElementById("statusCell94812");
            if (statusCell) {
                statusCell.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">เสร็จ</span>';
            }

            var actionCell = document.getElementById("actionCell94812");
            if (actionCell) {
                actionCell.className = "text-end pe-3 text-muted";
                actionCell.innerText = "ทำรายการเสร็จสิ้น";
            }

            // Update active machines counter
            var activeStat = document.getElementById("activeMachinesStat");
            if (activeStat) activeStat.innerHTML = '0 <small class="fs-6 text-muted">เครื่อง</small>';

            // Close modal
            var modalEl = document.getElementById('machineControlModal');
            var modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();

            showPageAlert("คืนเครื่อง #CPC-94812 เรียบร้อยแล้ว ขอบคุณที่เลือกใช้บริการ CloudPC ครับ", "success");
        }
    }

    // 8. Cancel Booking
    function cancelBooking(bookingId, amount) {
        bookingId = bookingId || "94812";
        amount = amount || "60.00";
        if (confirm("ยืนยันการยกเลิกการจอง #CPC-" + bookingId + " หรือไม่?\nระบบจะคืนเงินจำนวน +" + amount + " THB เข้ากระเป๋าเงิน CloudPC Wallet ให้คุณทันทีแบบเรียลไทม์")) {
            var form = document.getElementById("cancelBookingRealtimeForm");
            if (form) {
                var amtField = form.querySelector('input[name="refundAmount"]');
                var codeField = form.querySelector('input[name="bookingCode"]');
                if (amtField) amtField.value = amount;
                if (codeField) codeField.value = "#CPC-" + bookingId;
                form.submit();
            }
        }
    }

    function quickCancelInstant() {
        var idInput = document.getElementById("refundModalBookingId");
        var bookingId = idInput ? idInput.value : "94812";
        var amtInput = document.getElementById("refundModalAmountInput");
        var amount = amtInput ? amtInput.value : "60.00";

        var modalEl = document.getElementById('requestRefundModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            var modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
        }
        cancelBooking(bookingId, amount);
    }

    // 9. Live Search and Filter
    function filterBookingsTable() {
        var query = document.getElementById("bookingSearchInput").value.toLowerCase().trim();
        var statusFilter = document.getElementById("bookingStatusFilter").value;
        var rows = document.querySelectorAll("#bookingsTable tbody tr");
        var visibleCount = 0;

        rows.forEach(function(r) {
            var searchData = (r.getAttribute("data-search") || "").toLowerCase();
            var rowStatus = r.getAttribute("data-status");

            var matchSearch = !query || searchData.includes(query);
            var matchStatus = (statusFilter === "all") || (rowStatus === statusFilter);

            if (matchSearch && matchStatus) {
                r.classList.remove("d-none");
                visibleCount++;
            } else {
                r.classList.add("d-none");
            }
        });

        var noFound = document.getElementById("noBookingsFound");
        if (noFound) {
            if (visibleCount === 0) noFound.classList.remove("d-none");
            else noFound.classList.add("d-none");
        }

        var countText = document.getElementById("bookingCountText");
        if (countText) countText.innerText = `แสดง ${visibleCount} จากทั้งหมด @(ViewBag.TotalBookingsCount ?? 4) รายการประวัติการจอง`;
    }

    // Dynamic Modal Openers for Newly Booked Machines
    function openMachineControl(bookingId, machineName) {
        var codeEl = document.getElementById("modalMachineCode");
        var titleEl = document.getElementById("modalMachineTitle");
        if (codeEl) codeEl.innerText = '#CPC-' + bookingId;
        if (titleEl) titleEl.innerText = machineName;
        var modalEl = document.getElementById('machineControlModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            new bootstrap.Modal(modalEl).show();
        }
    }

    function openRefundModal(bookingId, machineName, amount) {
        var idInput = document.getElementById("refundModalBookingId");
        var amtInput = document.getElementById("refundModalAmountInput");
        var codeText = document.getElementById("refundModalBookingCode");
        var nameText = document.getElementById("refundModalMachineName");
        var amtText = document.getElementById("refundModalAmountText");

        if (idInput) idInput.value = bookingId;
        if (amtInput) amtInput.value = (amount !== undefined && amount !== null) ? Number(amount).toFixed(2) : '60.00';
        if (codeText) codeText.innerText = '#CPC-' + bookingId;
        if (nameText) nameText.innerText = machineName;
        if (amtText) amtText.innerText = ((amount !== undefined && amount !== null) ? Number(amount).toFixed(2) : '60.00') + ' THB';

        var modalEl = document.getElementById('requestRefundModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            var modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }
    }

    function openRefundStatusModal(bookingId, status, reason, note, amount) {
        var codeText = document.getElementById("refundStatusBookingCode");
        if (codeText) codeText.innerText = '#CPC-' + bookingId;

        var amtText = document.getElementById("refundStatusAmount");
        if (amtText) amtText.innerText = (amount ? parseFloat(amount).toFixed(2) : '60.00') + ' THB';

        var reasonText = document.getElementById("refundStatusReason");
        if (reasonText) reasonText.innerText = reason || "ขอยกเลิกการจองและขอคืนเงิน";

        var noteText = document.getElementById("refundStatusNote");
        var noteContainer = document.getElementById("refundStatusNoteContainer");
        if (noteText) {
            if (note && note.trim() !== "") {
                noteText.innerText = note;
                if (noteContainer) noteContainer.classList.remove("d-none");
            } else {
                if (noteContainer) noteContainer.classList.add("d-none");
            }
        }

        var iconContainer = document.getElementById("refundStatusIconContainer");
        var titleEl = document.getElementById("refundStatusTitle");
        var descEl = document.getElementById("refundStatusDesc");
        var badgeEl = document.getElementById("refundStatusBadge");

        if (status === "Refunded") {
            if (iconContainer) iconContainer.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>';
            if (titleEl) {
                titleEl.className = "fw-bold text-success mb-2";
                titleEl.innerText = "อนุมัติคืนเงินเรียบร้อยแล้ว";
            }
            if (descEl) descEl.innerHTML = '<div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 mb-2"><i class="bi bi-wallet2 me-1"></i> โอนเครดิตเข้ากระเป๋าเงิน: <strong>+' + (amount ? parseFloat(amount).toFixed(2) : '60.00') + ' THB</strong></div><p class="text-muted small mb-0">ฝ่ายบัญชีได้ตรวจสอบเงื่อนไขและอนุมัติการคืนเงินตามคำขอของคุณเรียบร้อยแล้ว ยอดเงินได้ถูกโอนเข้า CloudPC Wallet พร้อมใช้งานทันที</p>';
            if (badgeEl) badgeEl.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> อนุมัติคืนเงินสำเร็จ</span>';
        } else if (status === "RefundRejected") {
            if (iconContainer) iconContainer.innerHTML = '<i class="bi bi-x-circle-fill text-danger" style="font-size: 3.5rem;"></i>';
            if (titleEl) {
                titleEl.className = "fw-bold text-danger mb-2";
                titleEl.innerText = "ปฏิเสธคำขอคืนเงิน";
            }
            if (descEl) descEl.innerHTML = '<p class="text-muted small">คำขอนี้ไม่ตรงตามเงื่อนไขการคืนเงินของบริษัท</p>';
            if (badgeEl) badgeEl.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i> ปฏิเสธคำขอ</span>';
        } else {
            // RefundRequested
            if (iconContainer) iconContainer.innerHTML = '<i class="bi bi-hourglass-split text-warning" style="font-size: 3.5rem;"></i>';
            if (titleEl) {
                titleEl.className = "fw-bold text-dark mb-2";
                titleEl.innerText = "อยู่ระหว่างการตรวจสอบข้อมูล";
            }
            if (descEl) descEl.innerHTML = '<p class="text-muted small">ฝ่ายบัญชีกำลังตรวจสอบเงื่อนไขตามนโยบายของระบบ เพื่ออนุมัติและโอนเงินคืนเข้ากระเป๋าเงินของคุณ</p>';
            if (badgeEl) badgeEl.innerHTML = '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-hourglass-split me-1"></i> รอฝ่ายบัญชีตรวจสอบ</span>';
        }

        var modalEl = document.getElementById('refundStatusModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            new bootstrap.Modal(modalEl).show();
        }
    }

    // Helpers
    function showFeedback(msg, type) {
        var box = document.getElementById("actionFeedback");
        if (!box) return;
        box.className = "alert alert-" + type + " mt-3 small py-2";
        box.innerHTML = '<i class="bi bi-info-circle-fill me-1"></i> ' + msg;
        box.classList.remove("d-none");
    }

    function showPageAlert(msg, type) {
        var box = document.getElementById("pageAlertBox");
        var text = document.getElementById("pageAlertText");
        if (!box || !text) return;
        box.className = "alert alert-" + type + " shadow-sm border-0 d-flex align-items-center mb-4 rounded-3";
        text.innerText = msg;
        box.classList.remove("d-none");
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function hidePageAlert() {
        var box = document.getElementById("pageAlertBox");
        if (box) box.classList.add("d-none");
    }

    function openCustomerSlipModal(bookingId, slipUrl, amount) {
        var titleEl = document.getElementById('customerSlipModalTitle');
        var subtitleEl = document.getElementById('customerSlipModalSubtitle');
        var imgEl = document.getElementById('customerSlipModalImg');
        if (titleEl) titleEl.innerText = "สลิปโอนเงินรายการ #CPC-" + bookingId;
        if (subtitleEl) subtitleEl.innerText = "ยอดโอน: " + (amount ? parseFloat(amount).toFixed(2) : '0.00') + " THB (รอฝ่ายบัญชีตรวจสอบ)";
        if (imgEl) imgEl.src = slipUrl || "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&auto=format&fit=crop&q=80";
        var modalEl = document.getElementById('customerSlipModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            new bootstrap.Modal(modalEl).show();
        }
    }

    function openCustomerRejectReasonModal(bookingId, reason) {
        var codeEl = document.getElementById('customerRejectCode');
        var reasonEl = document.getElementById('customerRejectReasonText');
        if (codeEl) codeEl.innerText = "#CPC-" + bookingId;
        if (reasonEl) reasonEl.innerText = reason || "สลิปไม่ถูกต้อง หรือยอดเงินไม่ตรงกับรายการ";
        var modalEl = document.getElementById('customerRejectModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            new bootstrap.Modal(modalEl).show();
        }
    }

    // ===== Countdown Timer & Real-time Status =====
    function formatDuration(secs) {
        if (secs <= 0) return "00:00:00";
        var h = Math.floor(secs / 3600);
        var m = Math.floor((secs % 3600) / 60);
        var s = secs % 60;
        return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }

    function parseDateSafe(dateStr) {
        if (!dateStr) return null;
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return null;
        // กรณีปีเป็น พ.ศ. (เกิน 2500) ให้แปลงเป็น ค.ศ.
        if (d.getFullYear() > 2500) {
            d.setFullYear(d.getFullYear() - 543);
        }
        return d;
    }

    function tickCountdowns() {
        var now = new Date();

        // Countdown สำหรับ "กำลังใช้งาน" — นับถอยหลังถึงเวลาสิ้นสุด
        document.querySelectorAll('[id^="countdown"]').forEach(function(el) {
            var endTime = parseDateSafe(el.dataset.end);
            if (!endTime) return;
            var diff = Math.floor((endTime - now) / 1000);
            if (diff > 0) {
                el.textContent = '(' + formatDuration(diff) + ')';
            } else {
                el.textContent = '(เสร็จสิ้น)';
            }
        });

        // แสดง "เริ่มในอีก X" สำหรับ "จอง (พร้อมใช้งาน)"
        document.querySelectorAll('[id^="startIn"]').forEach(function(el) {
            var startTime = parseDateSafe(el.dataset.start);
            if (!startTime) return;
            var diff = Math.floor((startTime - now) / 1000);
            if (diff > 0) {
                var h = Math.floor(diff / 3600);
                var m = Math.floor((diff % 3600) / 60);
                if (h > 0) el.textContent = '(เริ่มในอีก ' + h + 'ชม. ' + m + 'น.)';
                else if (m > 0) el.textContent = '(เริ่มในอีก ' + m + ' นาที)';
                else el.textContent = '(กำลังจะเริ่ม...)';
            } else {
                el.textContent = '';
            }
        });
    }

    // เริ่ม tick ทันที แล้วทุก 1 วินาที
    tickCountdowns();
    setInterval(tickCountdowns, 1000);
</script>
}