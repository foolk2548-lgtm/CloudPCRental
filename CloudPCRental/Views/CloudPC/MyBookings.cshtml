@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "ประวัติการจองของฉัน";
}

<!-- Page Alert Container -->
<div id="pageAlertBox" class="alert alert-success d-none shadow-sm border-0 d-flex align-items-center mb-4 rounded-3" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2" id="pageAlertIcon"></i>
    <div id="pageAlertText"></div>
    <button type="button" class="btn-close ms-auto" onclick="hidePageAlert()"></button>
</div>

<!-- Header (Wireframe Page 7) -->
<div class="mb-4">
    <div class="text-muted small">แดชบอร์ดลูกค้า</div>
    <h3 class="fw-bold text-dark mb-0">ประวัติการจองของฉัน</h3>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">การจองทั้งหมด</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0" id="totalBookingsStat">@(ViewBag.TotalBookingsCount ?? 4) <small class="fs-6 text-muted">ครั้ง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">ประวัติการเช่าทั้งหมดของคุณ</div>
                </div>
                <div class="p-3 bg-light rounded-3 text-secondary">
                    <i class="bi bi-calendar3 fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">กำลังใช้งานอยู่</span>
                    <h3 class="fw-bold text-primary mt-1 mb-0" id="activeMachinesStat">@(ViewBag.ActiveMachinesCount ?? 0) <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">@((ViewBag.ActiveMachinesCount != null && (int)ViewBag.ActiveMachinesCount > 0) ? "กำลังเชื่อมต่อออนไลน์ในขณะนี้" : "ไม่มีเครื่องที่เชื่อมต่อค้างอยู่")</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3">
                    <i class="bi bi-play-fill fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">เวลาสะสมรวม</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0" id="accumulatedHoursStat">@(ViewBag.AccumulatedHoursCount ?? 48) <small class="fs-6 text-muted">ชั่วโมง</small></h3>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">เวลาการใช้งาน Cloud PC ทั้งหมด</div>
                </div>
                <div class="p-3 bg-light rounded-3 text-secondary">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bookings Table Section -->
<div class="card-cloudpc bg-white p-4 mb-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-list-task text-primary me-1"></i> รายการประวัติการจองทั้งหมด @(ViewBag.TotalBookingsCount ?? 4) รายการ
        </h6>
        <div class="d-flex gap-2">
            <input type="text" id="bookingSearchInput" class="form-control form-control-sm rounded-2" 
                   placeholder="ค้นหาเลขที่จอง, ชื่อเครื่อง..." style="width: 210px;" oninput="filterBookingsTable()" />
            <select id="bookingStatusFilter" class="form-select form-select-sm rounded-2" style="width: 150px;" onchange="filterBookingsTable()">
                <option value="all" selected>สถานะทั้งหมด</option>
                <option value="booked">จอง</option>
                <option value="completed">เสร็จ</option>
                <option value="cancelled">ยกเลิก</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small" id="bookingsTable">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">เลขที่จอง</th>
                    <th>ชื่อเครื่อง</th>
                    <th>วันเวลา</th>
                    <th>สถานะ</th>
                    <th class="text-end pe-3">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @* 1. รายการเครื่องใหม่ที่ผู้ใช้เพิ่งกดเช่าเข้ามาแบบเรียลไทม์ *@
                @if (ViewBag.NewBookings != null)
                {
                    foreach (var nb in (List<CloudPCRental.Models.Booking>)ViewBag.NewBookings)
                    {
                        var machine = nb.Machine ?? CloudPCRental.Models.MockDataStore.GetMachineById(nb.MachineId);
                        var mName = machine?.MachineName ?? "Cloud PC";
                        var mSpec = $"Spec: {machine?.CPU ?? "High CPU"} | {machine?.RAM ?? "32GB RAM"} | {machine?.GPU ?? "High GPU"}";
                        var timeText = !string.IsNullOrEmpty(nb.Note) && nb.Note.Contains("(") ? nb.Note : $"{nb.PaymentDate.ToString("d MMM yyyy, HH:mm", new System.Globalization.CultureInfo("th-TH"))} - {nb.PaymentDate.AddHours(nb.RentalHours):HH:mm} ({nb.RentalHours} ชม.)";
                        string rowStatus = (nb.PaymentStatus == "Refunded" || nb.PaymentStatus == "RefundRejected" || nb.PaymentStatus == "Rejected") ? "cancelled" : (nb.PaymentStatus == "RefundRequested" || nb.PaymentStatus == "Pending" ? "pending" : "booked");

                        <tr id="bookingRow@(nb.BookingId)" data-status="@rowStatus" data-search="#cpc-@nb.BookingId @mName.ToLower()">
                            <td class="ps-3 fw-bold text-primary font-monospace">#CPC-@nb.BookingId</td>
                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-1">
                                    <span>@mName</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.65rem;">เครื่องเช่าใหม่</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.72rem;">@mSpec</div>
                            </td>
                            <td>@timeText</td>
                            <td id="statusCell@(nb.BookingId)">
                                @if (nb.PaymentStatus == "Pending")
                                {
                                    <span class="badge" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-hourglass-split me-1 text-warning-emphasis"></i> รอฝ่ายบัญชีตรวจสอบสลิป
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Rejected")
                                {
                                    <span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-x-circle me-1"></i> ปฏิเสธสลิปโอนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "RefundRequested")
                                {
                                    <span class="badge" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-hourglass-split me-1 text-warning-emphasis"></i> รอฝ่ายบัญชีตรวจสอบคืนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Refunded")
                                {
                                    <span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-check2-circle me-1"></i> คืนเงินเรียบร้อย (+@nb.TotalAmount.ToString("N2") ฿)
                                    </span>
                                }
                                else if (nb.PaymentStatus == "RefundRejected")
                                {
                                    <span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-x-circle me-1"></i> ปฏิเสธการคืนเงิน
                                    </span>
                                }
                                else if (nb.PaymentStatus == "Completed")
                                {
                                    <span class="badge" style="background-color: #f0fdf4 !important; color: #15803d !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-check-circle-fill me-1"></i> เสร็จสิ้น
                                    </span>
                                }
                                else if (nb.PaymentStatus == "InUse")
                                {
                                    <span class="badge" style="background-color: #fef9c3 !important; color: #854d0e !important; border: 1px solid #fde047 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;"
                                          id="inuseBadge@(nb.BookingId)">
                                        <i class="bi bi-lightning-charge-fill me-1"></i> กำลังใช้งาน
                                        @if (nb.EndTime.HasValue)
                                        {
                                            <span class="ms-1" id="countdown@(nb.BookingId)" data-end="@nb.EndTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)"></span>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #eff6ff !important; color: #1d4ed8 !important; border: 1px solid #bfdbfe !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                        <i class="bi bi-play-circle-fill text-primary me-1"></i> จอง (พร้อมใช้งาน)
                                        @if (nb.StartTime.HasValue)
                                        {
                                            <span class="ms-1 text-muted" style="font-size:0.7rem;" id="startIn@(nb.BookingId)" data-start="@nb.StartTime.Value.ToString("yyyy-MM-ddTHH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)"></span>
                                        }
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3" id="actionCell@(nb.BookingId)">
                                @if (nb.PaymentStatus == "Pending")
                                {
                                    <button type="button" class="btn btn-outline-warning btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                            onclick="openCustomerSlipModal('@nb.BookingId', '@(nb.SlipImageUrl ?? "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=600&auto=format&fit=crop&q=80")', @nb.TotalAmount)">
                                        <i class="bi bi-image me-1"></i> ดูสลิปที่ส่งตรวจ
                                    </button>
                                }
                                else if (nb.PaymentStatus == "Rejected")
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                            onclick="openCustomerRejectReasonModal('@nb.BookingId', '@(nb.Note ?? "สลิปไม่ถูกต้อง หรือยอดเงินไม่ตรงกับรายการ")')">
                                        <i class="bi bi-exclamation-circle me-1"></i> ดูเหตุผลปฏิเสธ
                                    </button>
                                }
                                else if (nb.PaymentStatus == "RefundRequested" || nb.PaymentStatus == "RefundRejected")
                                {
                                    <button type="button" class="btn btn-outline-warning btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                            onclick="openRefundStatusModal('@nb.BookingId', '@nb.PaymentStatus', '@(nb.RefundReason ?? "ขอยกเลิกการจองและขอคืนเงิน")', '@(nb.Note ?? "ฝ่ายบัญชีกำลังตรวจสอบข้อมูล")', @nb.TotalAmount)">
                                        <i class="bi bi-clock-history me-1"></i> ดูสถานะคำขอคืนเงิน
                                    </button>
                                }
                                else if (nb.PaymentStatus == "Refunded")
                                {
                                    <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                        <button type="button" class="btn btn-outline-success btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                                onclick="openRefundStatusModal('@nb.BookingId', '@nb.PaymentStatus', '@(nb.RefundReason ?? "")', '@(nb.Note ?? "คืนเงินเรียบร้อยแล้ว")', @nb.TotalAmount)">
                                            <i class="bi bi-check-circle-fill me-1"></i> ดูผลการคืนเงิน (+@nb.TotalAmount.ToString("N0") ฿)
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary btn-sm py-1 px-3 rounded-2 me-1 shadow-sm fw-semibold" style="font-size: 0.78rem;" onclick="openMachineControl('@nb.BookingId', '@mName')">
                                        <i class="bi bi-gear-fill me-1"></i> จัดการเครื่อง
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 rounded-2" style="font-size: 0.78rem;" onclick="openRefundModal('@nb.BookingId', '@mName', @nb.TotalAmount)" title="ขอยกเลิกการจองและขอคืนเงิน">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> ยกเลิก
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }

                <!-- Row 1: Active Booking / Refunded -->
                <tr id="bookingRow94812" data-status="@(ViewBag.Booking94812Status == "Refunded" || ViewBag.Booking94812Status == "RefundRejected" ? "cancelled" : "booked")" data-search="#cpc-94812 extreme gaming pc - rtx 4090">
                    <td class="ps-3 fw-bold text-dark font-monospace">#CPC-94812</td>
                    <td>
                        <div class="fw-bold text-dark">Extreme Gaming PC - RTX 4090</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Spec: AMD Ryzen 9 | 32GB RAM | 1Gbps Bandwidth</div>
                    </td>
                    <td id="bookingTime94812">25 ต.ค. 2023, 14:00 - 18:00 (4 ชม.)</td>
                    <td id="statusCell94812">
                        @if (ViewBag.Booking94812Status == "RefundRequested")
                        {
                            <span class="badge" style="background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #f59e0b !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                <i class="bi bi-hourglass-split me-1 text-warning-emphasis"></i> รอฝ่ายบัญชีตรวจสอบคืนเงิน
                            </span>
                        }
                        else if (ViewBag.Booking94812Status == "Refunded")
                        {
                            <span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                <i class="bi bi-check2-circle me-1"></i> คืนเงินเรียบร้อย (+60.00 ฿)
                            </span>
                        }
                        else if (ViewBag.Booking94812Status == "RefundRejected")
                        {
                            <span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">
                                <i class="bi bi-x-circle me-1"></i> ปฏิเสธการคืนเงิน
                            </span>
                        }
                        else
                        {
                            <span class="badge" style="background-color: #eff6ff !important; color: #1d4ed8 !important; border: 1px solid #bfdbfe !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px; display: inline-flex; align-items: center;">จอง</span>
                        }
                    </td>
                    <td class="text-end pe-3" id="actionCell94812">
                        @if (ViewBag.Booking94812Status == "RefundRequested" || ViewBag.Booking94812Status == "RefundRejected")
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                    onclick="openRefundStatusModal('94812', '@ViewBag.Booking94812Status', '@(ViewBag.Booking94812Reason ?? "กดจองผิดวัน ต้องการเปลี่ยนวันใช้งาน")', '@(ViewBag.Booking94812Note ?? "ตรวจสอบเงื่อนไขตรงตามนโยบาย")', 60.00)">
                                <i class="bi bi-clock-history me-1"></i> ดูสถานะคำขอคืนเงิน
                            </button>
                        }
                        else if (ViewBag.Booking94812Status == "Refunded")
                        {
                            <div class="d-inline-flex align-items-center gap-1 justify-content-end">
                                <button type="button" class="btn btn-outline-success btn-sm py-1 px-3 rounded-2 fw-semibold" style="font-size: 0.78rem;" 
                                        onclick="openRefundStatusModal('94812', '@ViewBag.Booking94812Status', '@(ViewBag.Booking94812Reason ?? "")', '@(ViewBag.Booking94812Note ?? "คืนเงินเรียบร้อยแล้ว")', 60.00)">
                                    <i class="bi bi-check-circle-fill me-1"></i> ดูผลการคืนเงิน (+60 ฿)
                                </button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm py-1 px-3 rounded-2 me-1 shadow-sm fw-semibold" style="font-size: 0.78rem;" data-bs-toggle="modal" data-bs-target="#machineControlModal">
                                <i class="bi bi-gear-fill me-1"></i> จัดการเครื่อง
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 rounded-2" style="font-size: 0.78rem;" onclick="openRefundModal('94812', 'Extreme Gaming PC - RTX 4090', 60.00)" title="ขอยกเลิกการจองและขอคืนเงิน">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> ยกเลิก
                            </button>
                        }
                    </td>
                </tr>

                <!-- Row 2: Completed -->
                <tr data-status="completed" data-search="#cpc-93721 standard office pc - core i5">
                    <td class="ps-3 fw-bold text-dark font-monospace">#CPC-93721</td>
                    <td>
                        <div class="fw-bold text-dark">Standard Office PC - Core i5</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Spec: Intel Core i5 | 16GB RAM | 100Mbps Bandwidth</div>
                    </td>
                    <td>24 ต.ค. 2023, 09:00 - 12:00 (3 ชม.)</td>
                    <td><span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px;">เสร็จ</span></td>
                    <td class="text-end pe-3 text-muted">ทำรายการเสร็จสิ้น</td>
                </tr>

                <!-- Row 3: Cancelled -->
                <tr data-status="cancelled" data-search="#cpc-91605 high-end workstation - rtx 3080">
                    <td class="ps-3 fw-bold text-dark font-monospace">#CPC-91605</td>
                    <td>
                        <div class="fw-bold text-dark">High-End Workstation - RTX 3080</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Spec: AMD Ryzen 7 | 32GB RAM | 500Mbps Bandwidth</div>
                    </td>
                    <td>22 ต.ค. 2023, 10:00 - 15:00 (5 ชม.)</td>
                    <td><span class="badge" style="background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fca5a5 !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px;">ยกเลิก</span></td>
                    <td class="text-end pe-3 text-muted">ยกเลิกแล้ว</td>
                </tr>

                <!-- Row 4: Completed -->
                <tr data-status="completed" data-search="#cpc-89540 ai & developer node - a100 gpu">
                    <td class="ps-3 fw-bold text-dark font-monospace">#CPC-89540</td>
                    <td>
                        <div class="fw-bold text-dark">AI &amp; Developer Node - A100 GPU</div>
                        <div class="text-muted" style="font-size: 0.72rem;">Spec: NVIDIA A100 | 64GB RAM | 2Gbps Bandwidth</div>
                    </td>
                    <td>18 ต.ค. 2023, 13:00 - 21:00 (8 ชม.)</td>
                    <td><span class="badge" style="background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.65rem; border-radius: 6px;">เสร็จ</span></td>
                    <td class="text-end pe-3 text-muted">ทำรายการเสร็จสิ้น</td>
                </tr>
            </tbody>
        </table>

        <!-- No Results Row -->
        <div id="noBookingsFound" class="text-center py-4 text-muted d-none">
            <i class="bi bi-search fs-3 d-block mb-1 text-secondary"></i>
            ไม่พบรายการประวัติการจองที่ตรงกับเงื่อนไขการค้นหา
        </div>
    </div>

    <!-- Bottom summary -->
    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top small text-muted">
