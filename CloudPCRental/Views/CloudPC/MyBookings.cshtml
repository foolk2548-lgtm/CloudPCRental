<!-- Modal: ตรวจสอบสถานะคำขอคืนเงิน (Refund Status Modal) -->
<!-- =============================================================== -->
<div class="modal fade" id="refundStatusModal" tabindex="-1" aria-labelledby="refundStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-warning-subtle text-warning rounded-circle" id="refundStatusHeaderIcon">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="refundStatusModalLabel">สถานะคำขอยกเลิกและคืนเงิน</h5>
                        <small class="text-muted">รายการจองรหัส: <strong id="refundStatusBookingCode">#CPC-94812</strong></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center py-3">
                    <div class="mb-3" id="refundStatusIconContainer">
                        @if (ViewBag.Booking94812Status == "RefundRequested")
                        {
                            <i class="bi bi-hourglass-split text-warning" style="font-size: 3.5rem;"></i>
                        }
                        else if (ViewBag.Booking94812Status == "Refunded")
                        {
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                        }
                        else if (ViewBag.Booking94812Status == "RefundRejected")
                        {
                            <i class="bi bi-x-circle-fill text-danger" style="font-size: 3.5rem;"></i>
                        }
                    </div>
                    <h5 class="fw-bold @(ViewBag.Booking94812Status == "Refunded" ? "text-success" : (ViewBag.Booking94812Status == "RefundRejected" ? "text-danger" : "text-dark"))" id="refundStatusTitle">
                        @(ViewBag.Booking94812Status == "Refunded" ? "อนุมัติคืนเงินเรียบร้อยแล้ว" : (ViewBag.Booking94812Status == "RefundRejected" ? "ปฏิเสธคำขอคืนเงิน" : "อยู่ระหว่างการตรวจสอบข้อมูล"))
                    </h5>
                    <div id="refundStatusDesc">
                        @if (ViewBag.Booking94812Status == "RefundRequested")
                        {
                            <p class="text-muted small">ฝ่ายบัญชีกำลังตรวจสอบเงื่อนไขตามนโยบายของระบบ เพื่ออนุมัติและโอนเงินคืนเข้ากระเป๋าเงินของคุณ</p>
                        }
                        else if (ViewBag.Booking94812Status == "Refunded")
                        {
                            <div class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 mb-2">
                                <i class="bi bi-wallet2 me-1"></i> โอนเครดิตเข้ากระเป๋าเงิน: <strong>+60.00 THB</strong>
                            </div>
                            <p class="text-muted small mb-0">ฝ่ายบัญชีได้ตรวจสอบเงื่อนไขและอนุมัติการคืนเงินตามคำขอของคุณเรียบร้อยแล้ว ยอดเงินได้ถูกโอนเข้า CloudPC Wallet พร้อมใช้งานทันที</p>
                        }
                        else if (ViewBag.Booking94812Status == "RefundRejected")
                        {
                            <p class="text-muted small">คำขอนี้ไม่ตรงตามเงื่อนไขการคืนเงินของบริษัท</p>
                        }
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-light border small">
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <span class="text-muted">สถานะการคืนเงิน:</span>
                        <div id="refundStatusBadge">
                            @if (ViewBag.Booking94812Status == "Refunded")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> อนุมัติคืนเงินสำเร็จ
                                </span>
                            }
                            else if (ViewBag.Booking94812Status == "RefundRejected")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                    <i class="bi bi-x-circle me-1"></i> ปฏิเสธคำขอ
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                    <i class="bi bi-hourglass-split me-1"></i> รอฝ่ายบัญชีตรวจสอบ
                                </span>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted">เหตุผลที่ลูกค้ายื่นขอคืนเงิน:</span>
                        <div class="fw-medium text-dark mt-1" id="refundStatusReason">
                            @(string.IsNullOrEmpty(ViewBag.Booking94812Reason as string) ? "กดจองผิดวัน ต้องการเปลี่ยนวันใช้งาน" : ViewBag.Booking94812Reason)
                        </div>
                    </div>
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <span class="text-muted">ยอดเงินที่ขอคืน:</span>
                        <div class="fw-bold text-danger fs-6" id="refundStatusAmount">60.00 THB</div>
                    </div>
                    <div class="mb-2 d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted">ยอดเงินคงเหลือในกระเป๋าปัจจุบัน:</span>
                        <div class="fw-bold text-primary fs-6">@(ViewBag.CurrentBalance ?? "600.00") THB</div>
                    </div>
                    <div class="mt-2 pt-2 border-top @(string.IsNullOrEmpty(ViewBag.Booking94812Note as string) ? "d-none" : "")" id="refundStatusNoteContainer">
                        <span class="text-muted">หมายเหตุจากฝ่ายบัญชี:</span>
                        <div class="fw-semibold text-success mt-1" id="refundStatusNote">@ViewBag.Booking94812Note</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2 px-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4 btn-sm" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: ดูสลิปที่ลูกค้าส่งตรวจ (Customer Slip View Modal) -->
<div class="modal fade" id="customerSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-warning-subtle text-warning rounded-circle">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0" id="customerSlipModalTitle">สลิปโอนเงินที่ส่งตรวจสอบ</h6>
                        <small class="text-muted" id="customerSlipModalSubtitle">สถานะ: รอฝ่ายบัญชีตรวจสอบ</small>
