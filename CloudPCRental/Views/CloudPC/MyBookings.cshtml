                </div>

                <div id="actionFeedback" class="alert alert-success mt-3 small py-2 d-none" role="alert"></div>
            </div>
            <div class="modal-footer border-top px-4 py-3">
                <button type="button" class="btn btn-secondary rounded-2 px-4 small" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
            </div>
        </div>
    </div>
</div>

