<!-- Modal: ขอยกเลิกการจองและยื่นขอคืนเงิน (Customer Request Refund Modal) -->
<!-- =============================================================== -->
<div class="modal fade" id="requestRefundModal" tabindex="-1" aria-labelledby="requestRefundModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-danger-subtle text-danger rounded-circle">
                        <i class="bi bi-arrow-counterclockwise fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="requestRefundModalLabel">ขอยกเลิกการจองและยื่นขอคืนเงิน</h5>
                        <small class="text-muted">รายการจองรหัส: <strong id="refundModalBookingCode">#CPC-94812</strong></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="refundModalBookingId" value="94812" />
                <input type="hidden" name="refundAmount" id="refundModalAmountInput" value="60.00" />

                <div class="modal-body p-4">
                    <!-- สรุปรายการจองที่จะขอคืนเงิน -->
                    <div class="p-3 rounded-3 mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">เครื่องคอมพิวเตอร์:</span>
                            <span class="fw-bold text-dark" id="refundModalMachineName">Extreme Gaming PC - RTX 4090</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">ระยะเวลาที่จอง:</span>
                            <span class="text-dark" id="refundModalTimeRange">4 ชั่วโมง (14:00 - 18:00)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-2 border-top">
                            <span class="fw-semibold text-secondary small">ยอดเงินที่จะได้รับคืน:</span>
                            <span class="fw-bold text-danger fs-5" id="refundModalAmountText">60.00 THB</span>
                        </div>
                    </div>

                    <!-- นโยบายการตรวจสอบการคืนเงิน -->
                    <div class="alert border-0 small mb-3" style="background-color: #fffbeb; color: #92400e; border-left: 4px solid #f59e0b; border-radius: 8px;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-exclamation text-warning fs-6 mt-1"></i>
                            <div>
                                <strong>เงื่อนไขการคืนเงินของระบบ:</strong><br />
                                คำขอจะถูกส่งไปยัง <strong>ฝ่ายบัญชีและการเงิน</strong> เพื่อตรวจสอบข้อมูลและเหตุผล หากตรงตามเงื่อนไข ยอดเงินจะถูกโอนคืนเข้า <strong>CloudPC Wallet</strong> ของคุณทันที
                            </div>
                        </div>
                    </div>

                    <!-- เหตุผลในการขอคืนเงิน -->
                    <div class="mb-3">
                        <label for="refundReasonSelect" class="form-label small fw-semibold text-secondary">
                            เหตุผลในการขอยกเลิกและขอคืนเงิน <span class="text-danger">*</span>
                        </label>
                        <select id="refundReasonSelect" name="refundReason" class="form-select">
                            <option value="เครื่องมีปัญหาจอฟ้าและกระตุก ไม่สามารถเรนเดอร์งานกราฟิกต่อได้">เครื่องมีปัญหาจอฟ้า / เครื่องดับ / ค้างกระตุก</option>
                            <option value="กดจองผิดวันหรือผิดเวลา ต้องการเปลี่ยนวันใช้งาน">จองผิดวันหรือเวลา ต้องการเปลี่ยนไปจองเครื่องอื่น</option>
                            <option value="เกิดเหตุสุดวิสัย ไฟตกหรืออินเทอร์เน็ตที่บ้านขัดข้อง">เกิดเหตุสุดวิสัย / ไฟตก / เน็ตที่บ้านใช้งานไม่ได้</option>
                            <option value="ปัญหาการเชื่อมต่ออื่นๆ">ปัญหาอื่นๆ (ระบุในรายละเอียดด้านล่าง)</option>
                        </select>
                    </div>

                    <!-- รายละเอียดเพิ่มเติม -->
                    <div class="mb-3">
                        <label for="refundIssueDetail" class="form-label small fw-semibold text-secondary">
                            รายละเอียดเพิ่มเติมส่งถึงฝ่ายบัญชี
                        </label>
                        <textarea id="refundIssueDetail" name="issueDetail" class="form-control" rows="3" placeholder="ระบุรายละเอียดอาการหรือเหตุผล เช่น เครื่องเชื่อมต่อไม่ติดตั้งแต่เริ่มเช่า ขอยกเลิกและขอเงินคืนครับ..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-link text-muted text-decoration-none small" onclick="quickCancelInstant()">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> ยกเลิกด่วนทันที (Instant Wallet Demo)
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">ปิด</button>
                        <button type="submit" class="btn btn-danger rounded-3 px-4 fw-semibold shadow-sm">
                            <i class="bi bi-send-fill me-1"></i> ส่งคำขอคืนเงิน
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

