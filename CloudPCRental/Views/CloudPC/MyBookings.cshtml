    // 9. Live Search and Filter
    function filterBookingsTable() {
        var query = document.getElementById("bookingSearchInput").value.toLowerCase().trim();
        var statusFilter = document.getElementById("bookingStatusFilter").value;
        var rows = document.querySelectorAll("#bookingsTable tbody tr");
        var visibleCount = 0;

        rows.forEach(function(r) {
            var searchData = (r.getAttribute("data-search") || "").toLowerCase();
            var rowStatus = r.getAttribute("data-status");

            var matchSearch = !query || searchData.includes(query);
            var matchStatus = (statusFilter === "all") || (rowStatus === statusFilter);

            if (matchSearch && matchStatus) {
                r.classList.remove("d-none");
                visibleCount++;
            } else {
                r.classList.add("d-none");
            }
        });

        var noFound = document.getElementById("noBookingsFound");
        if (noFound) {
            if (visibleCount === 0) noFound.classList.remove("d-none");
            else noFound.classList.add("d-none");
        }

        var countText = document.getElementById("bookingCountText");
        if (countText) countText.innerText = `แสดง ${visibleCount} จากทั้งหมด ${rows.length} รายการประวัติการจอง`;
    }

    // Dynamic Modal Openers for Newly Booked Machines with Real Data & Dynamic Countdown
    function openMachineControl(bookingId, machineName, machineId, rentalHours, pricePerHour, startIso, endIso, timeText, cpu, ram, gpu, storage, ip, username, password) {
        activeBookingId = bookingId;
        activeMachineName = machineName || "Cloud PC";
        activePricePerHour = parseFloat(pricePerHour) || 15.00;

        var codeEl = document.getElementById("modalMachineCode");
        var titleEl = document.getElementById("modalMachineTitle");
        var timeEl = document.getElementById("modalBookingTime");
        if (codeEl) codeEl.innerText = '#CPC-' + bookingId;
        if (titleEl) titleEl.innerText = machineName;
        if (timeEl && timeText) timeEl.innerText = timeText;

        // เติมข้อมูล credentials จริง
        var ipField = document.getElementById("ipField");
        var userField = document.getElementById("userField");
        var passField = document.getElementById("passField");
        if (ipField) ipField.value = ip || "103.22.180.45:3389";
        if (userField) userField.value = username || ("CloudUser_" + bookingId);
        if (passField) passField.value = password || ("GameFast#" + (bookingId % 9000 + 1000) + "!");

        // เติมข้อมูลสเปกฮาร์ดแวร์จริงของเครื่อง
        var cpuField = document.getElementById("specCpu");
        var ramField = document.getElementById("specRam");
        var gpuField = document.getElementById("specGpu");
        var storageField = document.getElementById("specStorage");
        if (cpuField) cpuField.innerText = cpu || "AMD Ryzen 9 7900X (12C/24T)";
        if (ramField) ramField.innerText = ram || "32GB DDR5 6000MHz";
        if (gpuField) gpuField.innerText = gpu || "NVIDIA RTX 4080 (16GB VRAM)";
        if (storageField) storageField.innerText = storage || "1TB NVMe PCIe 4.0 SSD";

        // ล้างกล่องแจ้งเตือนใน modal
        var fb = document.getElementById("actionFeedback");
        if (fb) fb.className = "alert alert-success mt-3 small py-2 d-none";

        // คำนวณเวลานับถอยหลังจริงตามเวลาจอง (Real-Time Countdown from EndTime)
        var now = new Date();
        var startDt = startIso ? parseDateSafe(startIso) : null;
        var endDt = endIso ? parseDateSafe(endIso) : null;

        var isNotStartedYet = (startDt && now < startDt);
        var isExpired = (endDt && now >= endDt);

        if (endDt) {
            activeEndTime = endDt;
            var diffSecs = Math.floor((activeEndTime - now) / 1000);
            remainingSeconds = Math.max(0, diffSecs);
        } else {
            remainingSeconds = (rentalHours || 2) * 3600;
        }

        var clock = document.getElementById("countdownClock");
        var btnRestart = document.getElementById("btnRestart");
        var btnExtend = document.getElementById("btnExtend");
        var btnResetPass = document.getElementById("btnResetPass");
        var btnEnd = document.getElementById("btnEndSession");
        var statusBadge = document.getElementById("machineStatusBadge");

        // Elements สำหรับ Virtual Screen และ Alert
        var notStartedAlert = document.getElementById("modalNotStartedAlert");
        var timeAlert = document.getElementById("modalBookingTimeAlert");
        var vscreenStandby = document.getElementById("vscreenStandby");
        var vscreenDesktop = document.getElementById("vscreenDesktop");
        var standbyMachineDisplay = document.getElementById("standbyMachineNameDisplay");
        var standbyTimeDisplay = document.getElementById("standbyBookingTimeDisplay");
        var standbyCountLarge = document.getElementById("standbyCountdownLarge");
        var credLocked = document.getElementById("credentialsLockedBox");
        var credActive = document.getElementById("credentialsActiveBox");
        var credUnlockTime = document.getElementById("credentialsUnlockTimeText");
        var streamStatus = document.getElementById("vdesktopStreamStatus");
        var streamGpu = document.getElementById("vdesktopGpuTag");
        var termSession = document.getElementById("simTermSessionId");

        if (timeAlert && timeText) timeAlert.innerText = timeText;
        if (standbyMachineDisplay) standbyMachineDisplay.innerText = machineName;
        if (standbyTimeDisplay && timeText) standbyTimeDisplay.innerText = timeText;
        if (streamGpu && gpu) streamGpu.innerText = gpu + " (Active)";
        if (termSession) termSession.innerText = '#CPC-' + bookingId;

        // สกัดเวลาเริ่มเพื่อนำไปแสดงที่กล่องล็อกรหัส
        if (credUnlockTime && timeText) {
            var timeOnly = timeText.split(',').length > 1 ? timeText.split(',')[1].trim().split(' ')[0] : '08:00';
            credUnlockTime.innerText = timeOnly + ' น.';
        }

        if (isNotStartedYet) {
            // โหมดจองล่วงหน้า ยังไม่ถึงเวลาใช้งาน
            var diffStart = Math.floor((startDt - now) / 1000);
            var dh = Math.floor(diffStart / 3600);
            var dm = Math.floor((diffStart % 3600) / 60);
            var ds = diffStart % 60;
            var countdownStartStr = String(dh).padStart(2,'0') + ":" + String(dm).padStart(2,'0') + ":" + String(ds).padStart(2,'0');

            if (clock) {
                clock.innerText = "รอเริ่มคิว (เริ่มในอีก " + (dh > 0 ? dh + " ชม. " : "") + dm + " นาที)";
            }
            if (standbyCountLarge) {
                standbyCountLarge.innerText = countdownStartStr;
            }

            // แสดงแถบแจ้งเตือน & หน้าจอ Standby & ล็อกรหัสผ่าน
            if (notStartedAlert) notStartedAlert.classList.remove("d-none");
            if (vscreenStandby) vscreenStandby.classList.remove("d-none");
            if (vscreenDesktop) vscreenDesktop.classList.add("d-none");
            if (credLocked) credLocked.classList.remove("d-none");
            if (credActive) credActive.classList.add("d-none");

            if (streamStatus) {
                streamStatus.className = "badge bg-warning text-dark ms-2";
                streamStatus.innerText = "STANDBY / RESERVED";
            }

            if (btnRestart) btnRestart.disabled = true;
            if (btnExtend) btnExtend.disabled = false;
            if (btnResetPass) btnResetPass.disabled = true;
            if (btnEnd) btnEnd.disabled = true;
            if (statusBadge) {
                statusBadge.className = "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 fw-semibold";
                statusBadge.innerHTML = '<i class="bi bi-clock-history me-1"></i> จองล่วงหน้า (ยังไม่ถึงเวลาเริ่ม)';
            }
            startStandbyTimer(startDt);
        } else if (isExpired) {
            // โหมดหมดเวลาแล้ว
            if (clock) clock.innerText = "00:00:00 (หมดเวลา / สิ้นสุดการเช่า)";
            if (notStartedAlert) notStartedAlert.classList.add("d-none");
            if (vscreenStandby) vscreenStandby.classList.remove("d-none");
            if (vscreenDesktop) vscreenDesktop.classList.add("d-none");
            if (standbyCountLarge) standbyCountLarge.innerText = "00:00:00 (หมดเวลา)";
            if (credLocked) credLocked.classList.add("d-none");
            if (credActive) credActive.classList.remove("d-none");

            if (streamStatus) {
                streamStatus.className = "badge bg-secondary text-white ms-2";
                streamStatus.innerText = "SESSION ENDED";
            }

            if (btnRestart) btnRestart.disabled = true;
            if (btnExtend) btnExtend.disabled = true;
            if (btnResetPass) btnResetPass.disabled = true;
            if (btnEnd) btnEnd.disabled = true;
            if (statusBadge) {
                statusBadge.className = "badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 fw-semibold";
                statusBadge.innerHTML = '<i class="bi bi-power me-1"></i> สิ้นสุดการเช่าแล้ว';
            }
        } else {
            // โหมดกำลังเปิดใช้งานจริง (Active & Connected)
            if (clock) clock.innerText = formatTime(remainingSeconds);
            if (notStartedAlert) notStartedAlert.classList.add("d-none");
            if (vscreenStandby) vscreenStandby.classList.add("d-none");
            if (vscreenDesktop) vscreenDesktop.classList.remove("d-none");
            if (credLocked) credLocked.classList.add("d-none");
            if (credActive) credActive.classList.remove("d-none");

            if (streamStatus) {
                streamStatus.className = "badge bg-success text-white ms-2";
                streamStatus.innerText = "LIVE 60FPS";
            }

            if (btnRestart) btnRestart.disabled = false;
            if (btnExtend) btnExtend.disabled = false;
            if (btnResetPass) btnResetPass.disabled = false;
            if (btnEnd) btnEnd.disabled = false;
            if (statusBadge) {
                statusBadge.className = "badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold";
                statusBadge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> เชื่อมต่อออนไลน์ (Online)';
            }
            startTimer();
        }

        var modalEl = document.getElementById('machineControlModal');
        if (modalEl && typeof bootstrap !== "undefined") {
            new bootstrap.Modal(modalEl).show();
        }
    }

