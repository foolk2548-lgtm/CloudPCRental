@model IEnumerable<CloudPCRental.Models.Machine>
@{
    ViewData["Title"] = "ค้นหาและคัดกรองเครื่อง - CloudPC";
    var search = ViewBag.Search as string;
    var status = ViewBag.Status as string ?? "All";
    var minPrice = ViewBag.MinPrice;
    var maxPrice = ViewBag.MaxPrice;
    var countAvailable = ViewBag.CountAvailable ?? 0;
    var countRented = ViewBag.CountRented ?? 0;
    var countMaintenance = ViewBag.CountMaintenance ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    var sort = ViewBag.Sort as string ?? "available_first";
    var selectedCategories = (ViewBag.Categories as List<string>) ?? new List<string>();
}

<div class="row g-4 py-3">
    <!-- Left Sidebar: ค้นหาและคัดกรองเครื่อง (Wireframe Page 3) -->
    <div class="col-lg-3">
        <div class="card-cloudpc p-4 bg-white">
            <h5 class="fw-bold mb-4">ค้นหาและคัดกรองเครื่อง</h5>

            <form method="get" asp-action="Machines" id="filterMachinesForm">
                <!-- ค้นหาคำ -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">ค้นหาชื่อหรือฮาร์ดแวร์</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="เช่น PRO 01, Ryzen, RTX" value="@search" />
                    </div>
                </div>

                <!-- ประเภทเครื่อง -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label small fw-semibold text-secondary mb-0">ประเภทเครื่อง</label>
                        @if (selectedCategories.Any())
                        {
                            <a href="@Url.Action("Machines", new { search, status, minPrice, maxPrice, sort })" class="text-primary text-decoration-none" style="font-size: 0.72rem;">ล้างค่า</a>
                        }
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="categories" value="gaming" id="cat-gaming" @(selectedCategories.Contains("gaming") ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label small" for="cat-gaming">สเปกสำหรับเล่นเกม (Gaming)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="categories" value="graphic" id="cat-graphic" @(selectedCategories.Contains("graphic") ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label small" for="cat-graphic">สเปกสำหรับทำงานกราฟิก (Graphic Work)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="categories" value="ai" id="cat-ai" @(selectedCategories.Contains("ai") ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label small" for="cat-ai">สเปกสำหรับประมวลผลสูง (AI/AI Processing)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="categories" value="office" id="cat-office" @(selectedCategories.Contains("office") ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label small" for="cat-office">สเปกทำงานทั่วไป (General Office)</label>
                    </div>
                </div>

                <!-- สถานะ -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary d-block mb-2">สถานะ</label>
                    <div class="form-check d-flex justify-content-between mb-2">
                        <div>
                            <input class="form-check-input" type="radio" name="status" id="st-all" value="All" @(status == "All" || string.IsNullOrEmpty(status) ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small" for="st-all">ทั้งหมด</label>
                        </div>
                    </div>
                    <div class="form-check d-flex justify-content-between mb-2">
                        <div>
                            <input class="form-check-input" type="radio" name="status" id="st-avail" value="Available" @(status == "Available" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small text-success fw-semibold" for="st-avail">ว่าง</label>
                        </div>
                        <span class="text-muted small">@countAvailable เครื่อง</span>
                    </div>
                    <div class="form-check d-flex justify-content-between mb-2">
                        <div>
                            <input class="form-check-input" type="radio" name="status" id="st-rent" value="Rented" @(status == "Rented" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small text-danger fw-semibold" for="st-rent">มีคิวบางช่วง</label>
                        </div>
                        <span class="text-muted small">@countRented เครื่อง</span>
                    </div>
                    <div class="form-check d-flex justify-content-between">
                        <div>
                            <input class="form-check-input" type="radio" name="status" id="st-maint" value="Maintenance" @(status == "Maintenance" ? "checked" : "") onchange="this.form.submit()" />
                            <label class="form-check-label small text-warning fw-semibold" for="st-maint">ซ่อมบำรุง</label>
                        </div>
                        <span class="text-muted small">@countMaintenance เครื่อง</span>
                    </div>
                </div>

                <!-- ช่วงราคา -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <label class="form-label small fw-semibold text-secondary mb-0">ช่วงราคา</label>
                        <span class="text-primary small fw-bold">5 - 100 บาท/ชม.</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.72rem;">ต่ำสุด: 5 บาท</span>
                            <input type="number" name="minPrice" class="form-control form-control-sm" value="@minPrice" />
                        </div>
                        <div class="col-6">
                            <span class="text-muted small" style="font-size: 0.72rem;">สูงสุด: 100 บาท</span>
                            <input type="number" name="maxPrice" class="form-control form-control-sm" value="@maxPrice" />
                        </div>
                    </div>
                </div>

                <input type="hidden" name="sort" value="@sort" />

                <button type="submit" class="btn btn-primary w-100 rounded-2 fw-semibold">
                    กรองข้อมูล
                </button>
            </form>
        </div>
    </div>

    <!-- Main Content: เครื่องคอมพิวเตอร์ -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">
                พบคอมพิวเตอร์ทั้งหมด @totalCount เครื่อง ที่ตรงตามเงื่อนไข
            </h5>
            <div class="d-flex align-items-center">
                <span class="text-muted small me-2 text-nowrap">เรียงตาม:</span>
                <select class="form-select form-select-sm" style="width: auto;" onchange="applySorting(this.value)">
                    <option value="available_first" selected="@(sort == "available_first")">เครื่องว่างอันดับแรก</option>
                    <option value="price_asc" selected="@(sort == "price_asc")">ราคา: ต่ำไปสูง</option>
                    <option value="price_desc" selected="@(sort == "price_desc")">ราคา: สูงไปต่ำ</option>
                </select>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @if (Model != null && Model.Any())
            {
                @foreach (var machine in Model)
                {
                    <div class="col">
                        <div class="card-cloudpc p-3 h-100 d-flex flex-column bg-white">
                            <div class="text-center p-2 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center position-relative overflow-hidden" style="height: 140px;">
                                <img src="@machine.DisplayImageUrl" 
                                     alt="@machine.MachineName" 
                                     class="img-fluid" 
                                     style="max-height: 125px; object-fit: contain; transition: transform 0.3s ease;" 
                                     onerror="this.onerror=null; this.src='/images/machines/pc-gaming.png';" />
                                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1 font-monospace" style="font-size: 0.65rem;">
                                    PC-@machine.MachineId.ToString("D3")
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-start mb-2">
                                @{
                                    var displayMachineName = (CloudPCRental.Models.MockDataStore.StandardMachineNames.TryGetValue(machine.MachineId, out var sName))
                                        ? sName
                                        : (machine.MachineName != null && (machine.MachineName.Contains("à") || machine.MachineName.Contains("¹") || machine.MachineName.Contains("¸"))
                                            ? $"เครื่องคอมพิวเตอร์ PC-{machine.MachineId:D3}"
                                            : machine.MachineName);
                                }
                                <h6 class="fw-bold mb-0 text-dark text-truncate" title="@displayMachineName" style="max-width: 170px;">
                                    @displayMachineName
                                </h6>
                                @if (machine.Status == "PendingRepair" || (!string.IsNullOrEmpty(machine.RepairNote) && string.IsNullOrEmpty(machine.ApprovedBy)))
                                {
                                    <span class="badge text-nowrap" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-size: 0.72rem;"><i class="bi bi-hourglass-split me-1"></i> รออนุมัติซ่อม</span>
                                }
                                else if (machine.Status == "Maintenance" || (!string.IsNullOrEmpty(machine.RepairNote) && !string.IsNullOrEmpty(machine.ApprovedBy)))
                                {
                                    <span class="badge-status-maintenance text-nowrap"><i class="bi bi-tools me-1"></i> ซ่อมบำรุง</span>
                                }
                                else if (machine.Status == "Rented")
                                {
                                    <span class="badge text-nowrap" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 0.72rem;"><i class="bi bi-clock-history me-1"></i> มีคิวบางช่วง</span>
                                }
                                else
                                {
                                    <span class="badge-status-available text-nowrap">ว่าง</span>
                                }
                            </div>

                            <div class="small text-muted mb-3 flex-grow-1" style="font-size: 0.8rem; line-height: 1.6;">
                                <div><strong class="text-secondary">CPU:</strong> @machine.CPU</div>
                                <div><strong class="text-secondary">RAM:</strong> @machine.RAM</div>
                                <div><strong class="text-secondary">GPU:</strong> @machine.GPU</div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <span class="text-muted d-block" style="font-size: 0.7rem;">ราคาเช่า</span>
                                    <span class="fw-bold text-dark fs-6">@machine.PricePerHour.ToString("N0")</span>
                                    <span class="text-muted small" style="font-size: 0.75rem;">บาท/ชั่วโมง</span>
                                </div>
                                <div>
                                    @if (machine.Status == "PendingRepair" || (!string.IsNullOrEmpty(machine.RepairNote) && string.IsNullOrEmpty(machine.ApprovedBy)))
                                    {
                                        <button class="btn btn-light text-warning btn-sm px-2 rounded-2 border fw-semibold" disabled title="เครื่องมีปัญหา รอผู้จัดการอนุมัติการซ่อมบำรุง">
                                            <i class="bi bi-tools me-1"></i> รอซ่อม
                                        </button>
                                    }
                                    else if (machine.Status == "Maintenance" || (!string.IsNullOrEmpty(machine.RepairNote) && !string.IsNullOrEmpty(machine.ApprovedBy)))
                                    {
                                        <button class="btn btn-light text-muted btn-sm px-2 rounded-2 border fw-semibold" disabled title="เครื่องอยู่ระหว่างการปิดซ่อมบำรุง ไม่อนุญาตให้จอง">
                                            <i class="bi bi-wrench-adjustable me-1"></i> ซ่อมบำรุง
                                        </button>
                                    }
                                    else if (machine.Status == "Rented")
                                    {
                                        <a asp-action="Booking" asp-route-machineId="@machine.MachineId" class="btn btn-primary btn-sm px-3 rounded-2 fw-semibold shadow-xs" title="เครื่องนี้มีคิวการจองบางช่วงเวลา สามารถกดเพื่อจองช่วงเวลาว่างล่วงหน้าได้">
                                            <i class="bi bi-calendar-plus me-1"></i> จองล่วงหน้า
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Booking" asp-route-machineId="@machine.MachineId" class="btn btn-primary btn-sm px-3 rounded-2 fw-semibold shadow-xs" title="เครื่องว่างพร้อมใช้งานทันที">
                                            <i class="bi bi-play-circle me-1"></i> จองเลย
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 py-5 text-center text-muted">
                    <i class="bi bi-search fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">ไม่พบคอมพิวเตอร์ที่ตรงกับเงื่อนไขที่เลือก</h6>
                    <p class="small">กรุณาลองเปลี่ยนตัวเลือกสถานะ หมวดหมู่ หรือปรับช่วงราคาใหม่อีกครั้ง</p>
                    <a asp-action="Machines" class="btn btn-outline-primary btn-sm rounded-pill px-3">ล้างตัวกรองทั้งหมด</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applySorting(sortVal) {
        var form = document.getElementById('filterMachinesForm');
        if (form) {
            var sortInput = form.querySelector('input[name="sort"]');
            if (sortInput) sortInput.value = sortVal;
            form.submit();
        } else {
            var url = new URL(window.location.href);
            url.searchParams.set('sort', sortVal);
            window.location.href = url.toString();
        }
    }
</script>
}

