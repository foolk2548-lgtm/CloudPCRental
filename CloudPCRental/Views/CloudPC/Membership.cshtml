    function renderTierCards(tierKey) {
        const tier = tierDetails[tierKey] || tierDetails.platinum;
        const container = document.getElementById("tierContentContainer");
        if (!container) return;

        let perksHtml = "";
        tier.perks.forEach(p => {
            perksHtml += `
                <div class="col-sm-6 col-xl-3">
                    <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-xs hover-shadow transition-all">
                        <div class="fs-3 mb-2" style="color: ${tier.themeColor};">
                            <i class="bi ${p.icon}"></i>
                        </div>
                        <h6 class="fw-bold small text-dark mb-1">${p.title}</h6>
                        <p class="text-muted small mb-0" style="font-size: 0.75rem;">${p.desc}</p>
                    </div>
                </div>
            `;
        });

        const isCurrent = (tierKey === "platinum");

        container.innerHTML = `
            <div class="p-3 mb-3 rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-color: ${isCurrent ? '#f0f9ff' : '#f8fafc'}; border-color: ${tier.themeColor} !important;">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4" style="color: ${tier.themeColor};"><i class="bi bi-patch-check-fill"></i></span>
                    <div>
                        <div class="fw-bold text-dark fs-6">${tier.badge}</div>
                        <div class="text-muted small">${tier.desc}</div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                        <i class="bi bi-percent text-danger me-1"></i> ${tier.discount}
                    </span>
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                        <i class="bi bi-lightning text-warning me-1"></i> ${tier.multiplier}
                    </span>
                    <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-xs">
                        <i class="bi bi-speedometer2 text-info me-1"></i> ${tier.bandwidth}
                    </span>
                </div>
            </div>
            <div class="row g-3">
                ${perksHtml}
            </div>
        `;
    }

    function switchTierView(tierKey, btn) {
        document.querySelectorAll(".tier-tab-btn").forEach(b => {
            b.classList.remove("active", "btn-primary", "fw-semibold", "shadow-xs");
        });
        if (btn) {
            btn.classList.add("active", "btn-primary", "fw-semibold", "shadow-xs");
        }
        renderTierCards(tierKey);
    }

    function filterPointsTable() {
        const query = (document.getElementById("ptsSearchInput")?.value || "").toLowerCase().trim();
        const type = document.getElementById("ptsTypeFilter")?.value || "all";
        const rows = document.querySelectorAll("#pointsTable tbody tr");

        rows.forEach(row => {
            const rowSearch = (row.getAttribute("data-search") || "").toLowerCase();
            const rowType = row.getAttribute("data-type") || "";

            const matchQuery = !query || rowSearch.includes(query);
            const matchType = (type === "all") || (rowType === type);

            if (matchQuery && matchType) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        renderTierCards("@(Model.TierName.ToLower())");
    });
</script>
}
