<!-- 6. Points History Table (ประวัติคะแนนสะสม) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h6 class="fw-bold mb-0 text-dark">ประวัติคะแนนสะสม ทั้งหมด @(Model.Transactions?.Count ?? 0) รายการ</h6>
            <small class="text-muted">รายการรับและใช้คะแนนสะสมของคุณ (คำนวณอัตโนมัติทุกการเช่าเครื่อง)</small>
        </div>
        <div class="d-flex gap-2">
            <input type="text" id="ptsSearchInput" class="form-control form-control-sm" placeholder="ค้นหาประวัติคะแนน..." style="width: 200px;" oninput="filterPointsTable()" />
            <select id="ptsTypeFilter" class="form-select form-select-sm" style="width: 170px;" onchange="filterPointsTable()">
                <option value="all" selected>ประเภทรายการทั้งหมด</option>
                <option value="receive">เฉพาะที่ได้รับ (+)</option>
                <option value="spend">เฉพาะที่ใช้ไป (-)</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small" id="pointsTable">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">เลขที่อ้างอิง</th>
                    <th>วันที่ทำรายการ</th>
                    <th>รายละเอียดการทำรายการ</th>
                    <th class="text-center">คะแนนที่ได้รับ / ใช้</th>
                    <th class="text-end pe-3">คะแนนคงเหลือ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions != null && Model.Transactions.Any())
                {
                    foreach (var txn in Model.Transactions)
                    {
                        var isReceive = txn.Type == "receive";
                        <tr data-type="@txn.Type" data-search="@(txn.ReferenceCode.ToLower()) @(txn.Description.ToLower())">
                            <td class="ps-3 fw-bold text-dark font-monospace">@txn.ReferenceCode</td>
                            <td>@txn.CreatedAt.ToString("d MMM yyyy, HH:mm น.", new System.Globalization.CultureInfo("th-TH"))</td>
                            <td>
                                <div class="fw-semibold text-dark">@txn.Description</div>
                                <div class="text-muted small" style="font-size: 0.7rem;">@txn.SubDescription</div>
                            </td>
                            <td class="text-center @(isReceive ? "text-success" : "text-danger") fw-bold">
                                @(isReceive ? "+" : "")@txn.Points.ToString("N0") คะแนน
                            </td>
                            <td class="text-end pe-3 fw-semibold text-dark">@txn.BalanceAfter.ToString("N0") PTS</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block text-secondary opacity-50 mb-1"></i>
                            ยังไม่มีประวัติคะแนนสะสม
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

