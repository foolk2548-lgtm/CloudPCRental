@model CloudPCRental.Models.UserMembershipInfo
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "ข้อมูลสมาชิกและคะแนนสะสม";
    var currentPts = Model.CurrentPoints;
    var nextTierPts = Model.NextTierPoints;
    var ptsNeeded = Model.PointsNeededForNextTier;
    var progressPercent = Model.ProgressPercentage;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">แดชบอร์ดลูกค้า</div>
        <h3 class="fw-bold text-dark mb-0">ข้อมูลสมาชิกและระดับสิทธิประโยชน์ (Membership & Ranks)</h3>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Machines" class="btn btn-primary rounded-3 btn-sm shadow-xs fw-semibold px-3">
            <i class="bi bi-display me-1"></i> เช่าเครื่องเพื่อสะสมคะแนน
        </a>
    </div>
</div>

<!-- 1. Membership Card & Summary Row -->
<div class="row g-3 mb-4">
    <!-- Virtual Card -->
    <div class="col-lg-4">
        <div class="p-4 rounded-4 text-white shadow-sm h-100 d-flex flex-column justify-content-between position-relative overflow-hidden" 
             style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0369a1 100%); border: 1px solid #38bdf8; min-height: 220px;">
            <!-- Background Decors -->
            <div class="position-absolute end-0 top-0 translate-middle-y me-n3 mt-n3 opacity-10">
                <i class="bi bi-gem" style="font-size: 10rem;"></i>
            </div>
            
            <div class="d-flex justify-content-between align-items-center position-relative">
                <span class="fw-bold fs-6"><i class="bi bi-cpu-fill text-info me-1"></i> CloudPC Member</span>
                <span class="badge bg-info text-dark px-3 py-1 rounded-pill fw-bold shadow-xs" style="font-size: 0.75rem; letter-spacing: 1px;">
                    <i class="bi bi-award-fill me-1"></i> @Model.TierName.ToUpper()
                </span>
            </div>

            <div class="my-3 position-relative">
                <div class="text-info-emphasis small fw-medium" style="font-size: 0.72rem;">ชื่อผู้ถือบัตรสมาชิก</div>
                <div class="fw-bold fs-5 text-white">@Model.FullName</div>
                <div class="text-secondary small font-monospace" style="font-size: 0.7rem;">MEMBER ID: #@Model.MemberNumber</div>
            </div>

            <div class="d-flex justify-content-between align-items-end position-relative pt-2 border-top border-secondary border-opacity-25">
                <div>
                    <div class="text-info-emphasis small" style="font-size: 0.72rem;">คะแนนสะสมปัจจุบัน</div>
                    <div class="fw-bold fs-4 text-warning">@Model.CurrentPoints.ToString("N0") <small class="fs-6 text-white-50">PTS</small></div>
                </div>
                <div class="text-end text-light small opacity-75" style="font-size: 0.72rem;">
                    หมดอายุ: @Model.ExpiringDate
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Stat Boxes -->
    <div class="col-lg-8">
        <div class="row g-3 h-100">
            <div class="col-md-4">
                <div class="card-cloudpc p-3 bg-white h-100 d-flex flex-column justify-content-between border rounded-3 shadow-xs">
                    <span class="text-muted small">คะแนนที่พร้อมใช้งาน <i class="bi bi-wallet2 text-primary float-end fs-5"></i></span>
                    <h3 class="fw-bold text-dark my-2">@Model.CurrentPoints.ToString("N0") <small class="fs-6 text-muted">คะแนน</small></h3>
                    <div class="text-success small fw-medium" style="font-size: 0.72rem;">
                        <i class="bi bi-check-circle-fill me-1"></i>เทียบเท่าส่วนลด @Model.DiscountValue.ToString("N2") THB
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-cloudpc p-3 bg-white h-100 d-flex flex-column justify-content-between border rounded-3 shadow-xs">
                    <span class="text-muted small">คะแนนกำลังจะหมดอายุ <i class="bi bi-hourglass-split text-danger float-end fs-5"></i></span>
                    <h3 class="fw-bold text-danger my-2">@Model.ExpiringPoints.ToString("N0") <small class="fs-6 text-muted">คะแนน</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">หมดอายุ ณ วันที่ @Model.ExpiringDate</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-cloudpc p-3 bg-white h-100 d-flex flex-column justify-content-between border rounded-3 shadow-xs" style="border-left: 4px solid #0284c7 !important;">
                    <span class="text-muted small">ระดับสมาชิกปัจจุบัน <i class="bi bi-patch-check-fill text-info float-end fs-5"></i></span>
                    <div class="d-flex align-items-baseline gap-2 my-1">
                        <h3 class="fw-bold text-primary mb-0">@Model.TierName</h3>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">ระดับ @Model.TierLevel</span>
                    </div>
                    <div class="text-muted small" style="font-size: 0.72rem;">รับคะแนนสะสมพิเศษ <strong>@(Model.Multiplier.ToString("0.0")) เท่า</strong> ทุกการเช่า</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Level Progress & Next Rank Roadmap (แถบความคืบหน้าระดับสมาชิก) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 mb-1">
                <i class="bi bi-speedometer me-1"></i> เส้นทางการเลื่อนระดับ (Rank Progression)
            </span>
            <h5 class="fw-bold text-dark mb-0">คุณอยู่ในระดับ <span class="text-primary">@Model.TierName</span> @(Model.TierLevel < 5 ? $"(ขาดอีก {ptsNeeded:N0} คะแนน เพื่อสู่ระดับ {Model.NextTierName})" : "(คุณอยู่ในระดับสูงสุดแล้ว)")</h5>
        </div>
        <div class="text-end">
            <span class="small text-muted">ความคืบหน้าสู่ @Model.NextTierName:</span>
            <strong class="text-dark font-monospace fs-6 ms-1">@progressPercent%</strong>
        </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress mb-3 shadow-xs" style="height: 14px; border-radius: 10px; background-color: #f1f5f9;">
        <div class="progress-bar progress-bar-striped progress-bar-animated bg-gradient" 
             role="progressbar" 
             style="width: @(progressPercent)%; background: linear-gradient(90deg, #0284c7 0%, #8b5cf6 100%);" 
             aria-valuenow="@progressPercent" 
             aria-valuemin="0" 
             aria-valuemax="100">
        </div>
    </div>

    <!-- 5 Rank Milestones Nodes -->
    <div class="row text-center g-2 pt-2 border-top">
        <!-- 1. Bronze -->
        <div class="col">
            <div class="p-2 rounded-3 @(Model.TierLevel == 1 ? "bg-primary-subtle border border-primary shadow-xs position-relative" : (Model.TierLevel > 1 ? "bg-light border opacity-75" : "bg-white border text-muted"))">
                @if (Model.TierLevel == 1) { <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary" style="font-size: 0.58rem;">ปัจจุบัน</span> }
                <div class="fs-5 @(Model.TierLevel == 1 ? "text-primary" : "text-secondary")"><i class="bi bi-shield"></i></div>
                <div class="fw-bold text-dark small" style="font-size: 0.75rem;">Bronze</div>
                <div class="text-muted" style="font-size: 0.68rem;">0 - 299 PTS</div>
                @if (Model.TierLevel == 1) {
                    <span class="badge bg-primary text-white mt-1 shadow-xs" style="font-size: 0.65rem;">ระดับของคุณ</span>
                } else if (Model.TierLevel > 1) {
                    <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.62rem;">ผ่านแล้ว</span>
                }
            </div>
        </div>

        <!-- 2. Silver -->
        <div class="col">
            <div class="p-2 rounded-3 @(Model.TierLevel == 2 ? "bg-primary-subtle border border-primary shadow-xs position-relative" : (Model.TierLevel > 2 ? "bg-light border opacity-75" : "bg-white border text-muted"))">
                @if (Model.TierLevel == 2) { <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary" style="font-size: 0.58rem;">ปัจจุบัน</span> }
                <div class="fs-5 @(Model.TierLevel == 2 ? "text-primary" : "text-secondary")"><i class="bi bi-shield-fill"></i></div>
                <div class="fw-bold text-dark small" style="font-size: 0.75rem;">Silver</div>
                <div class="text-muted" style="font-size: 0.68rem;">300 - 699 PTS</div>
                @if (Model.TierLevel == 2) {
                    <span class="badge bg-primary text-white mt-1 shadow-xs" style="font-size: 0.65rem;">ระดับของคุณ</span>
                } else if (Model.TierLevel > 2) {
                    <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.62rem;">ผ่านแล้ว</span>
                } else if (Model.TierLevel == 1) {
                    <span class="badge bg-info-subtle text-info border mt-1" style="font-size: 0.62rem;">เป้าหมายถัดไป</span>
                }
            </div>
        </div>

        <!-- 3. Gold -->
        <div class="col">
            <div class="p-2 rounded-3 @(Model.TierLevel == 3 ? "bg-primary-subtle border border-primary shadow-xs position-relative" : (Model.TierLevel > 3 ? "bg-light border opacity-75" : "bg-white border text-muted"))">
                @if (Model.TierLevel == 3) { <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary" style="font-size: 0.58rem;">ปัจจุบัน</span> }
                <div class="fs-5 @(Model.TierLevel == 3 ? "text-primary" : "text-warning")"><i class="bi bi-shield-shaded"></i></div>
                <div class="fw-bold text-dark small" style="font-size: 0.75rem;">Gold</div>
                <div class="text-muted" style="font-size: 0.68rem;">700 - 1,199 PTS</div>
                @if (Model.TierLevel == 3) {
                    <span class="badge bg-primary text-white mt-1 shadow-xs" style="font-size: 0.65rem;">ระดับของคุณ</span>
                } else if (Model.TierLevel > 3) {
                    <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.62rem;">ผ่านแล้ว</span>
                } else if (Model.TierLevel == 2) {
                    <span class="badge bg-info-subtle text-info border mt-1" style="font-size: 0.62rem;">เป้าหมายถัดไป</span>
                }
            </div>
        </div>

        <!-- 4. Platinum (Current for 1,200+) -->
        <div class="col">
            <div class="p-2 rounded-3 @(Model.TierLevel == 4 ? "bg-primary-subtle border border-primary shadow-xs position-relative" : (Model.TierLevel > 4 ? "bg-light border opacity-75" : "bg-white border text-muted"))">
                @if (Model.TierLevel == 4) { <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-primary" style="font-size: 0.58rem;">ปัจจุบัน</span> }
                <div class="fs-5 text-primary"><i class="bi bi-gem"></i></div>
                <div class="fw-bold text-primary small" style="font-size: 0.78rem;">Platinum</div>
                <div class="text-dark fw-semibold" style="font-size: 0.68rem;">1,200 - 2,499 PTS</div>
                @if (Model.TierLevel == 4) {
                    <span class="badge bg-primary text-white mt-1 shadow-xs" style="font-size: 0.65rem;">ระดับของคุณ</span>
                } else if (Model.TierLevel > 4) {
                    <span class="badge bg-secondary-subtle text-secondary border mt-1" style="font-size: 0.62rem;">ผ่านแล้ว</span>
                } else if (Model.TierLevel == 3) {
                    <span class="badge bg-info-subtle text-info border mt-1" style="font-size: 0.62rem;">เป้าหมายถัดไป</span>
                }
            </div>
        </div>

        <!-- 5. Diamond (Next) -->
        <div class="col">
            <div class="p-2 rounded-3 @(Model.TierLevel == 5 ? "bg-purple-subtle border border-purple shadow-xs position-relative" : "bg-white border border-dashed text-purple hover-shadow")" style="border-color: #8b5cf6 !important;">
                @if (Model.TierLevel == 5) { <span class="position-absolute top-0 start-50 translate-middle badge rounded-pill bg-purple text-white" style="font-size: 0.58rem; background: #8b5cf6;">ปัจจุบัน</span> }
                <div class="fs-5" style="color: #8b5cf6;"><i class="bi bi-trophy-fill"></i></div>
                <div class="fw-bold text-dark small" style="font-size: 0.75rem;">Diamond</div>
                <div class="text-muted" style="font-size: 0.68rem;">2,500+ PTS</div>
                @if (Model.TierLevel == 5) {
                    <span class="badge text-white mt-1 shadow-xs" style="font-size: 0.65rem; background: #8b5cf6;">ระดับของคุณ</span>
                } else {
                    <span class="badge bg-purple-subtle text-purple border mt-1" style="font-size: 0.62rem; color: #8b5cf6; background: #f3e8ff;">เป้าหมายถัดไป</span>
                }
            </div>
        </div>
    </div>
</div>
</div>

<!-- 3. Interactive Tier Privilege Showcase (เลือกดูสิทธิพิเศษของแต่ละระดับ) -->
<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-stars text-warning me-1"></i> รายละเอียดสิทธิประโยชน์แยกตามระดับ
            </h5>
            <small class="text-muted">คลิกเลือกระดับด้านล่างเพื่อตรวจสอบสิทธิพิเศษที่จะได้รับในแต่ละขั้น</small>
        </div>

        <!-- Tab Pills to Switch Ranks -->
        <div class="btn-group p-1 bg-light rounded-pill border" role="group">
            <button type="button" class="btn btn-sm rounded-pill px-3 tier-tab-btn" onclick="switchTierView('bronze', this)">
                <i class="bi bi-shield text-secondary me-1"></i>Bronze
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 tier-tab-btn" onclick="switchTierView('silver', this)">
                <i class="bi bi-shield-fill text-muted me-1"></i>Silver
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 tier-tab-btn" onclick="switchTierView('gold', this)">
                <i class="bi bi-shield-shaded text-warning me-1"></i>Gold
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 tier-tab-btn active btn-primary fw-semibold shadow-xs" onclick="switchTierView('platinum', this)">
                <i class="bi bi-gem me-1"></i>Platinum (ปัจจุบัน)
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 tier-tab-btn" onclick="switchTierView('diamond', this)">
                <i class="bi bi-trophy-fill text-purple me-1" style="color: #8b5cf6;"></i>Diamond
            </button>
        </div>
    </div>

    <!-- Dynamic Tier Cards Container -->
    <div id="tierContentContainer">
        <!-- Rendered by JavaScript: Default to Platinum -->
    </div>
</div>

<!-- 4. Tier Comparison Matrix (ตารางเปรียบเทียบสิทธิพิเศษทุกระดับชั้นแบบละเอียด) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-table text-primary me-2"></i>ตารางเปรียบเทียบสิทธิพิเศษทุกระดับ (Tier Comparison Table)
            </h5>
            <small class="text-muted">เปรียบเทียบสิทธิประโยชน์และความคุ้มค่าในแต่ละขั้นอย่างชัดเจน</small>
        </div>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">
            <i class="bi bi-info-circle me-1 text-primary"></i> ปรับระดับอัตโนมัติทันทีที่คะแนนถึงเกณฑ์
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle text-center mb-0 small">
            <thead class="table-light">
                <tr>
                    <th class="text-start ps-3 py-3" style="width: 25%;">สิทธิประโยชน์ / บริการ</th>
                    <th style="width: 15%;">🥉 Bronze</th>
                    <th style="width: 15%;">🥈 Silver</th>
                    <th style="width: 15%;">🥇 Gold</th>
                    <th style="width: 16%; background-color: #e0f2fe; border: 2px solid #0284c7; color: #0369a1;" class="position-relative">
                        <span class="badge bg-primary text-white position-absolute top-0 start-50 translate-middle" style="font-size: 0.6rem;">ระดับของคุณ</span>
                        💎 Platinum
                    </th>
                    <th style="width: 14%; background-color: #faf5ff; color: #7e22ce;">👑 Diamond</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-trophy me-2 text-warning"></i>เกณฑ์คะแนนสะสม
                    </td>
                    <td>0 - 299 PTS</td>
                    <td>300 - 699 PTS</td>
                    <td>700 - 1,199 PTS</td>
                    <td class="fw-bold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">1,200 - 2,499 PTS</td>
                    <td class="fw-bold" style="color: #8b5cf6;">2,500+ PTS ขึ้นไป</td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-percent me-2 text-danger"></i>ส่วนลดค่าเช่าทุกสเปก
                    </td>
                    <td class="text-muted">-</td>
                    <td><span class="badge bg-light text-dark border">ลด 5%</span></td>
                    <td><span class="badge bg-warning-subtle text-dark border border-warning-subtle fw-semibold">ลด 10%</span></td>
                    <td class="fw-bold text-success fs-6" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">ลดทันที 15%</td>
                    <td class="fw-bold fs-6" style="color: #7e22ce;">ลดสูงสุด 25%</td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-coin me-2 text-warning"></i>ตัวคูณคะแนนสะสม (Multiplier)
                    </td>
                    <td>x1.0 เท่า</td>
                    <td>x1.2 เท่า</td>
                    <td>x1.3 เท่า</td>
                    <td class="fw-bold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">x1.5 เท่า</td>
                    <td class="fw-bold" style="color: #8b5cf6;">x2.0 เท่า (คูณสอง)</td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-speedometer2 me-2 text-info"></i>ความเร็วอินเทอร์เน็ตเครื่อง (Bandwidth)
                    </td>
                    <td>100 Mbps</td>
                    <td>200 Mbps</td>
                    <td>500 Mbps</td>
                    <td class="fw-bold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">1 Gbps (ฟรี)</td>
                    <td class="fw-bold" style="color: #8b5cf6;">2 Gbps ไม่จำกัด (ฟรี)</td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-hdd-network me-2 text-primary"></i>พื้นที่ Cloud Storage ฟรี
                    </td>
                    <td>10 GB</td>
                    <td>25 GB</td>
                    <td>50 GB</td>
                    <td class="fw-bold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">100 GB</td>
                    <td class="fw-bold" style="color: #8b5cf6;">250 GB สำหรับเก็บเกม/งาน</td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-shield-check me-2 text-success"></i>สิทธิ์จองคิวด่วนพิเศษ
                    </td>
                    <td class="text-muted"><i class="bi bi-dash"></i></td>
                    <td>จองล่วงหน้า 1 วัน</td>
                    <td>จองล่วงหน้า 3 วัน</td>
                    <td class="fw-bold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">
                        <i class="bi bi-check-circle-fill text-primary me-1"></i> คิวด่วนพิเศษ
                    </td>
                    <td class="fw-bold" style="color: #8b5cf6;">
                        <i class="bi bi-star-fill text-warning me-1"></i> VIP ล็อคเครื่องล่วงหน้า 7 วัน
                    </td>
                </tr>
                <tr>
                    <td class="text-start ps-3 fw-semibold text-dark">
                        <i class="bi bi-headset me-2 text-secondary"></i>ช่องทางดูแลช่วยเหลือพิเศษ
                    </td>
                    <td>แชทในเวลาทำการ</td>
                    <td>ตอบกลับใน 1 ชม.</td>
                    <td>แชทด่วนพิเศษ</td>
                    <td class="fw-semibold text-primary" style="background-color: #f0f9ff; border-left: 2px solid #0284c7; border-right: 2px solid #0284c7;">เจ้าหน้าที่ดูแลเฉพาะ</td>
