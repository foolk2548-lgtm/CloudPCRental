@model CloudPCRental.Models.Machine
@{
    ViewData["Title"] = "ชำระเงินสำเร็จแล้ว - CloudPC";
    var customerName = ViewBag.CustomerName ?? "ธนพล ดีสมเกียรติ";
    var customerEmail = ViewBag.CustomerEmail ?? "thanapol@example.com";
    var txnNumber = ViewBag.TxnNumber ?? ("TXN-" + DateTime.Now.ToString("yyyyMMdd") + "-9812");
    var txnDate = ViewBag.TxnDate ?? CloudPCRental.Models.MockDataStore.GetCurrentThaiDateTime();
    decimal total = (Model?.PricePerHour ?? 15.00m) * 2;
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card-cloudpc p-4 p-md-5 bg-white text-center">
            <!-- Icon Success (Wireframe Page 6) -->
            <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle mb-3" style="width: 64px; height: 64px;">
                <i class="bi bi-check-lg fs-1"></i>
            </div>

            <h4 class="fw-bold text-dark mb-1">ชำระเงินสำเร็จแล้ว</h4>
            <p class="text-muted small mb-4">ระบบได้ส่งรายละเอียดไปที่อีเมลของคุณเรียบร้อยแล้ว</p>

            <!-- Receipt Card -->
            <div class="border rounded-3 p-3 bg-light text-start mb-4 small">
                <div class="fw-bold text-dark mb-3 text-center border-bottom pb-2">ใบเสร็จรับเงินออนไลน์</div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">เลขที่รายการ</span>
                    <span class="fw-semibold text-dark">@txnNumber</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">วันที่และเวลาที่ทำรายการ</span>
                    <span class="text-dark">@txnDate</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">รายละเอียดลูกค้า</span>
                    <span class="text-dark">@customerName (@customerEmail)</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">เครื่องคอมพิวเตอร์ออนไลน์</span>
                    <span class="text-primary fw-bold">@(Model?.MachineName ?? "PRO 01")</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">ระยะเวลาจองใช้งาน</span>
                    <span class="text-dark">@(ViewBag.BookingDate ?? CloudPCRental.Models.MockDataStore.GetTodayThaiDate()) @(ViewBag.TimeRange ?? "(09:00 - 11:00 น.)")</span>
                </div>

                <div class="border-top pt-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">ช่องทางที่ใช้ชำระเงิน</span>
                        <span class="fw-bold text-dark">
                            @if (ViewBag.PayMethod == "pm-wallet" || ViewBag.PayMethod == "wallet")
                            {
                                <span class="text-primary"><i class="bi bi-wallet2 me-1"></i> กระเป๋าเงิน CloudPC Wallet (ตัดเครดิตทันที)</span>
                            }
                            else if (ViewBag.PayMethod == "pm-qr")
                            {
                                <span><i class="bi bi-qr-code me-1"></i> พร้อมเพย์ QR Code</span>
                            }
                            else
                            {
                                <span><i class="bi bi-credit-card-2-front me-1"></i> บัตรเครดิต/เดบิต</span>
                            }
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">ยอดสุทธิที่ตัดชำระ</span>
                        <span class="text-danger fw-bold">-@(((decimal)(ViewBag.PaidAmount ?? total)).ToString("N2")) บาท</span>
                    </div>
                    @if (ViewBag.PayMethod == "pm-wallet" || ViewBag.PayMethod == "wallet")
                    {
                        <div class="d-flex justify-content-between mb-2 p-2 bg-success-subtle text-success rounded-2">
                            <span><i class="bi bi-wallet-fill me-1"></i> เครดิตคงเหลือในกระเป๋าล่าสุด:</span>
                            <strong>@(((decimal)(ViewBag.RemainingBal ?? 0)).ToString("N2")) THB</strong>
                        </div>
                    }
                    @if (ViewBag.EarnedPoints != null && (int)ViewBag.EarnedPoints > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 p-2 bg-warning-subtle text-dark rounded-2 border border-warning-subtle">
                            <span class="fw-semibold"><i class="bi bi-star-fill text-warning me-1"></i> ได้รับคะแนนสะสม (Platinum x1.5):</span>
                            <strong class="text-primary">+@(((int)ViewBag.EarnedPoints).ToString("N0")) PTS</strong>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fw-bold text-dark">สถานะรายการ</span>
                        <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-check2-circle me-1"></i> ชำระเงินสำเร็จ</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <button type="button" class="btn btn-outline-secondary w-100 rounded-3 mb-2 small fw-semibold bg-white" onclick="window.print()">
                <i class="bi bi-download me-1"></i> ดาวน์โหลดใบเสร็จรับเงิน (PDF)
            </button>

            <a asp-action="MyBookings" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold mb-3">
                <i class="bi bi-pc-display me-1"></i> ไปยังหน้ารายการการจองและจัดการเครื่องคอมพิวเตอร์
            </a>

            <div>
                <a asp-action="Index" class="text-secondary small text-decoration-none">
                    กลับสู่หน้าแรก
                </a>
            </div>
        </div>
    </div>
</div>

