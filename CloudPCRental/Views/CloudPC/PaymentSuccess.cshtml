@model CloudPCRental.Models.Machine
@{
    ViewData["Title"] = "ชำระเงินสำเร็จแล้ว - CloudPC";
    var customerName = (string)(ViewBag.CustomerName ?? "ผู้ใช้งาน");
    var customerEmail = (string)(ViewBag.CustomerEmail ?? "");
    var txnNumber = (string)(ViewBag.TxnNumber ?? ("REC-" + DateTime.Now.ToString("yyyyMMdd") + "-9812"));
    var txnDate = (string)(ViewBag.TxnDate ?? CloudPCRental.Models.MockDataStore.GetCurrentThaiDateTime());
    int hours = (int)(ViewBag.Hours ?? 2);
    decimal paidAmount = (decimal)(ViewBag.PaidAmount ?? ((Model?.PricePerHour ?? 15.00m) * hours));
    decimal unitPrice = Model?.PricePerHour ?? (paidAmount / Math.Max(1, hours));
    decimal vatAmount = Math.Round(paidAmount * 7m / 107m, 2);
    decimal subtotalBeforeVat = paidAmount - vatAmount;

    string payMethod = (string)(ViewBag.PayMethod ?? "pm-wallet");
    string payMethodTitle = payMethod switch
    {
        "pm-wallet" or "wallet" => "กระเป๋าเงิน CloudPC Wallet (ตัดบัญชีสำเร็จ)",
        "pm-qr" => "พร้อมเพย์ QR Code (ชำระเงินสำเร็จ)",
        _ => "บัตรเครดิต / เดบิต (ชำระเงินสำเร็จ)"
    };

    string bookingDate = (string)(ViewBag.BookingDate ?? CloudPCRental.Models.MockDataStore.GetTodayThaiDate());
    string timeRange = (string)(ViewBag.TimeRange ?? "(09:00 - 11:00 น.)");
    int userId = (int)(ViewBag.UserId ?? 0);

    string customerDisplay = !string.IsNullOrWhiteSpace(customerName) && customerName != customerEmail
        ? customerName
        : (!string.IsNullOrWhiteSpace(customerEmail) ? customerEmail : "ลูกค้าผู้ใช้บริการ");
}

<style>
    /* =======================================================
       สไตล์สำหรับการพิมพ์ / บันทึก PDF (Official A4 Tax Receipt)
       ======================================================= */
    @@media print {
        /* ซ่อนส่วนประกอบของหน้าเว็บทั้งหมด */
        body > header,
        body > footer,
        nav,
        .navbar,
        .alert,
        .btn,
        #liveChatWidget,
        .chat-widget,
        .d-print-none,
        .navbar-clock-pill {
            display: none !important;
            visibility: hidden !important;
        }

        body, html {
            background: #ffffff !important;
            color: #111827 !important;
            margin: 0 !important;
            padding: 0 !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Sarabun", sans-serif !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .container, main, .main-content {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
        }

        /* แสดงเฉพาะใบเสร็จรับเงินทางการ ป้องกันการตัดหน้าขึ้น 2 หน้า */
        #officialPrintReceipt {
            display: block !important;
            visibility: visible !important;
            width: 100% !important;
            max-width: 780px !important;
            margin: 0 auto !important;
            padding: 15px 20px !important;
            background: #ffffff !important;
            box-sizing: border-box !important;
            page-break-inside: avoid !important;
            page-break-after: avoid !important;
        }

        @@page {
            size: A4 portrait;
            margin: 8mm 12mm;
        }
    }

    /* สไตล์สำหรับการแสดงผลใบเสร็จทางการ */
    .receipt-border-box {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background-color: #ffffff;
    }
    .receipt-table th {
        background-color: #f8fafc !important;
        color: #334155;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 8px 10px;
        border-bottom: 2px solid #cbd5e1;
    }
    .receipt-table td {
        padding: 10px;
        font-size: 0.85rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
</style>

<!-- ========================================================
     1. หน้าจอยืนยันสำหรับผู้ใช้งานบนหน้าเว็บ (Web Screen View)
     ======================================================== -->
<div class="row justify-content-center py-4 d-print-none">
    <div class="col-md-7 col-lg-5">
        <div class="card-cloudpc p-4 p-md-5 bg-white text-center shadow-sm rounded-4 border">
            <!-- Icon Success (Wireframe Page 6) -->
            <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle mb-3 shadow-xs" style="width: 64px; height: 64px;">
                <i class="bi bi-check-lg fs-1"></i>
            </div>

            <h4 class="fw-bold text-dark mb-1">ชำระเงินสำเร็จแล้ว</h4>
            <p class="text-muted small mb-4">ระบบได้ทำการบันทึกและส่งรายละเอียดไปยังอีเมลของคุณเรียบร้อยแล้ว</p>

            <!-- Receipt Summary Card on Web -->
            <div class="border rounded-3 p-3 bg-light text-start mb-4 small shadow-xs">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <span class="fw-bold text-dark"><i class="bi bi-receipt me-1 text-primary"></i> ใบเสร็จรับเงินออนไลน์</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> ชำระเงินสำเร็จ</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">เลขที่ใบเสร็จ</span>
                    <span class="fw-bold text-dark font-monospace">@txnNumber</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">วันที่และเวลา</span>
                    <span class="text-dark">@txnDate</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">ผู้ชำระเงิน</span>
                    <span class="text-dark fw-semibold">@customerDisplay</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">เครื่องที่เลือก</span>
                    <span class="text-primary fw-bold">@(Model?.MachineName ?? "PRO 01") (PC-@((Model?.MachineId ?? 1).ToString("D3")))</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">ช่วงเวลาใช้งาน</span>
                    <span class="text-dark">@bookingDate @timeRange</span>
                </div>

                <div class="border-top pt-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">ช่องทางที่ชำระ</span>
                        <span class="fw-semibold text-dark small">@payMethodTitle</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">ยอดสุทธิที่ชำระ</span>
                        <span class="text-danger fw-bold fs-6">@paidAmount.ToString("N2") บาท</span>
                    </div>
                    @if (ViewBag.PayMethod == "pm-wallet" || ViewBag.PayMethod == "wallet")
                    {
                        <div class="d-flex justify-content-between mb-2 p-2 bg-success-subtle text-success rounded-2 small">
                            <span><i class="bi bi-wallet-fill me-1"></i> ยอดคงเหลือในกระเป๋า:</span>
                            <strong>@(((decimal)(ViewBag.RemainingBal ?? 0)).ToString("N2")) THB</strong>
                        </div>
                    }
                    @if (ViewBag.EarnedPoints != null && (int)ViewBag.EarnedPoints > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 p-2 bg-warning-subtle text-dark rounded-2 border border-warning-subtle small">
                            <span class="fw-semibold"><i class="bi bi-star-fill text-warning me-1"></i> ได้รับคะแนนสะสม:</span>
                            <strong class="text-primary">+@(((int)ViewBag.EarnedPoints).ToString("N0")) PTS</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <button type="button" class="btn btn-outline-primary w-100 rounded-3 py-2 mb-2 fw-semibold shadow-xs bg-white" onclick="window.print()">
                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> ดาวน์โหลด / พิมพ์ใบเสร็จรับเงิน (PDF)
            </button>

            <a asp-action="MyBookings" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold mb-3 shadow-xs">
                <i class="bi bi-pc-display me-1"></i> ไปยังหน้ารายการการจองและจัดการเครื่องคอมพิวเตอร์
            </a>

            <div>
                <a asp-action="Index" class="text-secondary small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> กลับสู่หน้าแรก
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     2. แบบฟอร์มใบเสร็จรับเงินทางการ (Official Formal A4 Receipt for PDF/Print)
     ======================================================== -->
<div id="officialPrintReceipt" class="d-none d-print-block">
    <div class="receipt-border-box p-4">
        <!-- 1. Header บริษัท และ ประเภทเอกสาร -->
        <div class="row align-items-start border-bottom pb-3 mb-3">
            <div class="col-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="bg-primary text-white px-2 py-1 rounded fw-bold fs-5">CloudPC</span>
                    <span class="fs-5 fw-bold text-dark">บริษัท คลาวด์พีซี เซอร์วิสเซส (ประเทศไทย) จำกัด</span>
                </div>
                <div class="small text-muted" style="line-height: 1.5; font-size: 0.78rem;">
                    <div>เลขที่ 88 อาคารเอ็กซ์เชนจ์ ทาวเวอร์ ชั้น 22 ถนนสุขุมวิท แขวงคลองเตย เขตคลองเตย กรุงเทพมหานคร 10110</div>
                    <div>เลขประจำตัวผู้เสียภาษีอากร: <strong>0105566098124</strong> (สำนักงานใหญ่)</div>
                    <div>เบอร์โทรศัพท์: 02-098-8900 | อีเมล: billing@cloudpc.in.th | เว็บไซต์: www.cloudpc.in.th</div>
                </div>
            </div>
            <div class="col-5 text-end">
                <h4 class="fw-bold text-dark mb-1">ใบเสร็จรับเงิน</h4>
                <div class="text-secondary fw-semibold small mb-2">RECEIPT / TAX INVOICE (e-Tax)</div>
                <div class="small bg-light p-2 rounded border text-start d-inline-block" style="min-width: 220px; font-size: 0.78rem;">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">เลขที่ (No.):</span>
                        <strong class="font-monospace text-dark">@txnNumber</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">วันที่ (Date):</span>
                        <span class="text-dark">@txnDate</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">สถานะ:</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0">ชำระเงินเรียบร้อย (PAID)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. ข้อมูลลูกค้า (Customer Info) -->
        <div class="bg-light p-3 rounded-2 border mb-3">
            <div class="row g-2 small" style="font-size: 0.82rem;">
                <div class="col-7">
                    <div class="text-muted mb-1">ข้อมูลผู้รับบริการ / ลูกค้า (Customer):</div>
                    <div class="fw-bold text-dark fs-6 mb-1">@customerDisplay</div>
                    @if (!string.IsNullOrWhiteSpace(customerEmail))
                    {
                        <div class="text-secondary"><i class="bi bi-envelope me-1"></i> อีเมล: @customerEmail</div>
                    }
                </div>
                <div class="col-5 text-end">
                    <div class="text-muted mb-1">ช่องทางชำระเงิน (Payment Method):</div>
                    <div class="fw-semibold text-dark">@payMethodTitle</div>
                    <div class="text-muted small mt-1">รหัสสมาชิก: #MEM-@((userId > 0 ? userId : 1001).ToString("D4"))</div>
                </div>
            </div>
        </div>

        <!-- 3. ตารางรายการบริการ (Itemized Table) -->
        <table class="table table-bordered receipt-table mb-3">
            <thead>
                <tr>
                    <th class="text-center" style="width: 8%;">ลำดับ<br><span class="text-muted fw-normal" style="font-size: 0.7rem;">Item</span></th>
                    <th style="width: 44%;">รายการบริการ<br><span class="text-muted fw-normal" style="font-size: 0.7rem;">Description</span></th>
                    <th class="text-center" style="width: 24%;">ช่วงเวลาที่ใช้งาน<br><span class="text-muted fw-normal" style="font-size: 0.7rem;">Rental Period</span></th>
                    <th class="text-center" style="width: 10%;">จำนวน<br><span class="text-muted fw-normal" style="font-size: 0.7rem;">Hours</span></th>
                    <th class="text-end" style="width: 14%;">จำนวนเงิน (บาท)<br><span class="text-muted fw-normal" style="font-size: 0.7rem;">Amount (THB)</span></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center fw-semibold">1</td>
                    <td>
                        <div class="fw-bold text-dark">บริการเช่าเครื่องคอมพิวเตอร์ Cloud PC ประสิทธิภาพสูง</div>
                        <div class="text-primary small fw-semibold">@(Model?.MachineName ?? "PRO 01") (รหัสเครื่อง: PC-@((Model?.MachineId ?? 1).ToString("D3")))</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">
                            สเปก: @(Model?.CPU ?? "High-end CPU") | @(Model?.RAM ?? "RAM") | @(Model?.GPU ?? "GPU")
                        </div>
                    </td>
                    <td class="text-center small">
                        <div>@bookingDate</div>
                        <div class="text-secondary fw-semibold">@timeRange</div>
                    </td>
                    <td class="text-center">@hours ชม.</td>
                    <td class="text-end fw-bold">@paidAmount.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- 4. สรุปยอดเงิน (Financial Totals) -->
        <div class="row align-items-start mb-4">
            <div class="col-7">
                <div class="p-3 border rounded-2 bg-light small text-secondary" style="font-size: 0.78rem; line-height: 1.6;">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-info-circle me-1"></i> หมายเหตุ / ข้อมูลกำกับ:</div>
                    <div>• เอกสารนี้จัดทำและส่งมอบด้วยระบบอิเล็กทรอนิกส์ (e-Receipt) ตามมาตรฐานกรมสรรพากร</div>
                    <div>• ค่าบริการรวมภาษีมูลค่าเพิ่ม 7% (VAT Included) เรียบร้อยแล้ว</div>
                    <div>• หากมีข้อสอบถามเกี่ยวกับใบเสร็จ สามารถแจ้งเลขที่รายการได้ที่ศูนย์บริการลูกค้าตลอด 24 ชม.</div>
                </div>
            </div>
            <div class="col-5">
                <div class="border rounded-2 p-3 bg-white">
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>มูลค่าก่อนภาษี (Subtotal):</span>
                        <span class="text-dark">@subtotalBeforeVat.ToString("N2") ฿</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>ภาษีมูลค่าเพิ่ม 7% (VAT):</span>
                        <span class="text-dark">@vatAmount.ToString("N2") ฿</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-2">
                        <span>ส่วนลด (Discount):</span>
                        <span class="text-dark">0.00 ฿</span>
                    </div>
                    <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">ยอดสุทธิชำระทั้งสิ้น:</span>
                        <span class="fs-5 fw-bold text-primary">@paidAmount.ToString("N2") THB</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. ลายมือชื่ออิเล็กทรอนิกส์และการรับรอง (Signatures) -->
        <div class="row pt-3 border-top text-center small text-muted" style="font-size: 0.75rem;">
            <div class="col-6 text-start">
                <div>ผู้ออกเอกสาร: <strong>ระบบจัดเก็บรายได้ CloudPC Automated Billing</strong></div>
                <div>ออกเอกสารเมื่อ: @txnDate</div>
            </div>
            <div class="col-6 text-end">
                <div class="fw-bold text-dark mb-1">เจ้าหน้าที่การเงินและบัญชี</div>
                <div class="text-success fw-semibold"><i class="bi bi-patch-check-fill me-1"></i> ตรวจสอบและรับรองความถูกต้องทางอิเล็กทรอนิกส์แล้ว</div>
            </div>
        </div>
    </div>
</div>
