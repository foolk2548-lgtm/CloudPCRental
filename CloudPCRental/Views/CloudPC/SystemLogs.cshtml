@model IEnumerable<CloudPCRental.Models.SystemLog>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "บันทึกระบบ";

    var logsList = Model?.ToList() ?? new List<CloudPCRental.Models.SystemLog>();
    string selectedDate = ViewBag.SelectedDate as string ?? "";
    string searchKeyword = ViewBag.SearchKeyword as string ?? "";
    string selectedCat = ViewBag.SelectedCategory as string ?? "ประเภททั้งหมด";
    string selectedSev = ViewBag.SelectedSeverity as string ?? "ระดับความรุนแรงทั้งหมด";
}

<!-- Header (Wireframe Page 29) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">ตรวจสอบประวัติกิจกรรมการทำงานและการตรวจจับด้านความปลอดภัยของเครื่องและแอดมินทั้งหมด</div>
        <h3 class="fw-bold text-dark mb-0">บันทึกระบบ (System &amp; Audit Logs)</h3>
    </div>
    <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
        <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
        <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
    </div>
</div>

<!-- Advanced Filter Card (Wireframe Page 29 - Working Search Form) -->
<div class="card-cloudpc bg-white p-4 mb-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-funnel me-1 text-primary"></i>ตัวกรองขั้นสูง</h6>
        @if (!string.IsNullOrEmpty(selectedDate) || !string.IsNullOrEmpty(searchKeyword) || selectedCat != "ประเภททั้งหมด" || selectedSev != "ระดับความรุนแรงทั้งหมด")
        {
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">กำลังใช้ตัวกรอง</span>
        }
    </div>
    <form method="get" asp-action="SystemLogs">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small text-secondary">เลือกวันที่</label>
                <input type="date" name="date" class="form-control form-control-sm" value="@selectedDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary">ค้นหาผู้ดำเนินการ/ผู้ใช้/IP</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="ระบุชื่อบัญชี อีเมล หรือ IP..." value="@searchKeyword" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary">ประเภทเหตุการณ์</label>
                <select name="category" class="form-select form-select-sm">
                    <!option value="ประเภททั้งหมด" @(selectedCat == "ประเภททั้งหมด" ? "selected" : "")>ประเภททั้งหมด</!option>
                    <!option value="Security" @(selectedCat == "Security" ? "selected" : "")>Security</!option>
                    <!option value="Booking" @(selectedCat == "Booking" ? "selected" : "")>Booking</!option>
                    <!option value="Hardware" @(selectedCat == "Hardware" ? "selected" : "")>Hardware</!option>
                    <!option value="Login" @(selectedCat == "Login" ? "selected" : "")>Login</!option>
                    <!option value="Payment" @(selectedCat == "Payment" ? "selected" : "")>Payment</!option>
                    <!option value="System" @(selectedCat == "System" ? "selected" : "")>System</!option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-secondary">ระดับความรุนแรง</label>
                <select name="severity" class="form-select form-select-sm">
                    <!option value="ระดับความรุนแรงทั้งหมด" @(selectedSev == "ระดับความรุนแรงทั้งหมด" ? "selected" : "")>ระดับความรุนแรงทั้งหมด</!option>
                    <!option value="ข้อมูลทั่วไป" @(selectedSev == "ข้อมูลทั่วไป" ? "selected" : "")>ข้อมูลทั่วไป</!option>
                    <!option value="สำคัญ" @(selectedSev == "สำคัญ" ? "selected" : "")>สำคัญ</!option>
                    <!option value="วิกฤต" @(selectedSev == "วิกฤต" ? "selected" : "")>วิกฤต</!option>
                </select>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
            <a asp-action="SystemLogs" class="btn btn-light btn-sm px-3 rounded-2 text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> ล้างตัวกรอง
            </a>
            <button type="submit" class="btn btn-primary btn-sm px-3 rounded-2 fw-semibold">
                <i class="bi bi-search me-1"></i> ค้นหาข้อมูลบันทึก
            </button>
        </div>
    </form>
</div>

<!-- Logs Table Card (Wireframe Page 29 - Real-Time Dynamic Data) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3" style="min-width: 130px;">เวลาบันทึก</th>
                    <th style="min-width: 150px;">ผู้ดำเนินการ</th>
                    <th style="min-width: 100px;">หมวดหมู่</th>
                    <th>รายละเอียดบันทึกความปลอดภัย / ระบบ</th>
                    <th style="min-width: 90px;">ระดับ</th>
                    <th class="text-end pe-3" style="min-width: 110px;">IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (logsList.Any())
                {
                    @foreach (var log in logsList)
                    {
                        var isToday = log.Timestamp.Date == DateTime.Today;
                        string timeDisplay = isToday ? log.Timestamp.ToString("HH:mm:ss") : log.Timestamp.ToString("dd/MM/yy HH:mm");
                        
                        string catBadgeClass = log.Category switch
                        {
                            "Security" => "bg-dark text-white",
                            "Booking" => "bg-primary-subtle text-primary border border-primary-subtle",
                            "Hardware" => "bg-danger-subtle text-danger border border-danger-subtle",
                            "Login" => "bg-info-subtle text-info border border-info-subtle",
                            "Payment" => "bg-success-subtle text-success border border-success-subtle",
                            _ => "bg-secondary-subtle text-secondary border"
                        };

                        string sevBadgeClass = log.Severity switch
                        {
                            "วิกฤต" => "bg-danger text-white",
                            "สำคัญ" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-semibold",
                            _ => "bg-info-subtle text-info border border-info-subtle"
                        };

                        <tr>
                            <td class="ps-3 text-muted">
                                <span class="font-monospace">@timeDisplay</span>
                                @if (!isToday)
                                {
                                    <span class="d-block text-secondary" style="font-size: 0.68rem;">@log.Timestamp.ToString("d MMMM", new System.Globalization.CultureInfo("th-TH"))</span>
                                }
                            </td>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-secondary me-1"></i>@log.PerformedBy
                            </td>
                            <td>
                                <span class="badge @catBadgeClass" style="font-size: 0.72rem;">@log.Category</span>
                            </td>
                            <td class="text-dark">
                                @log.Detail
                            </td>
                            <td>
                                <span class="badge @sevBadgeClass" style="font-size: 0.7rem;">@log.Severity</span>
                            </td>
                            <td class="text-end pe-3 font-monospace text-muted">
                                @log.IpAddress
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard-x fs-1 d-block mb-2 text-secondary"></i>
                            <div class="fw-semibold">ไม่พบข้อมูลบันทึกระบบที่ตรงกับเงื่อนไขการค้นหา</div>
                            <div class="small">ลองเปลี่ยนวันที่หรือล้างคำค้นหาเพื่อดูบันทึกเหตุการณ์ทั้งหมด</div>
                            <a asp-action="SystemLogs" class="btn btn-outline-primary btn-sm rounded-pill mt-3">
                                ดูบันทึกระบบทั้งหมด
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top small text-muted">
        <span>แสดงรายการบันทึกระบบทั้งหมด <strong>@logsList.Count</strong> รายการ</span>
        <span class="text-success"><i class="bi bi-activity me-1"></i> ระบบตรวจสอบและบันทึกอัตโนมัติ 100%</span>
    </div>
</div>
