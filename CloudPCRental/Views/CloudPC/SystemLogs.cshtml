@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "บันทึกระบบ";
}

<!-- Header (Wireframe Page 29) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="text-muted small">ตรวจสอบประวัติกิจกรรมการทำงานและการตรวจจับด้านความปลอดภัยของเครื่องและแอดมินทั้งหมด</div>
        <h3 class="fw-bold text-dark mb-0">บันทึกระบบ</h3>
    </div>
    <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
        <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
        <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
    </div>
</div>

<!-- Advanced Filter Card (Wireframe Page 29) -->
<div class="card-cloudpc bg-white p-4 mb-4">
    <h6 class="fw-bold text-dark mb-3">ตัวกรองขั้นสูง</h6>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label small text-secondary">เลือกวันที่</label>
            <input type="date" class="form-control form-control-sm" value="2024-01-25" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">ค้นหาผู้ดำเนินการ/ผู้ใช้</label>
            <input type="text" class="form-control form-control-sm" placeholder="ระบุชื่อบัญชีหรืออีเมล..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">ประเภทเหตุการณ์</label>
            <select class="form-select form-select-sm">
                <option selected>ประเภททั้งหมด</option>
                <option>Security</option>
                <option>Booking</option>
                <option>Hardware</option>
                <option>Login</option>
                <option>Payment</option>
                <option>System</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-secondary">ระดับความรุนแรง</label>
            <select class="form-select form-select-sm">
                <option selected>ระดับความรุนแรงทั้งหมด</option>
                <option>ข้อมูลทั่วไป</option>
                <option>สำคัญ</option>
                <option>วิกฤต</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
        <button type="button" class="btn btn-light btn-sm px-3 rounded-2">ล้างตัวกรอง</button>
        <button type="button" class="btn btn-primary btn-sm px-3 rounded-2 fw-semibold">ค้นหาข้อมูลบันทึก</button>
    </div>
</div>

