@model CloudPCRental.Models.Machine
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แก้ไขข้อมูลเครื่องคอมพิวเตอร์";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0">แก้ไขข้อมูลเครื่องคอมพิวเตอร์</h4>
                <small class="text-muted">รหัสเครื่อง: PC-@Model.MachineId.ToString("D3")</small>
            </div>
            <a asp-action="ManageMachines" class="btn btn-outline-secondary rounded-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.RepairNote))
        {
            <div class="alert border-0 shadow-sm mb-4" style="background-color: #fffbeb; border-left: 4px solid #f59e0b !important; color: #92400e; border-radius: 10px;">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill fs-5 mt-1 text-warning"></i>
                    <div>
                        <div class="fw-bold">ประวัติการแจ้งซ่อมของเครื่องนี้:</div>
                        <div class="mt-1">@Model.RepairNote</div>
                        <div class="small mt-1 text-muted" style="font-size: 0.8rem;">
                            ผู้รายงาน: <strong>@(Model.ReportedBy ?? "พนักงานหน้าร้าน")</strong> | 
                            วันที่แจ้ง: @(Model.ReportedAt?.ToString("dd/MM/yyyy HH:mm") ?? "ไม่ระบุ")
                            @if (!string.IsNullOrEmpty(Model.ApprovedBy))
                            {
                                <span> | ผู้อนุมัติ: <strong>@Model.ApprovedBy</strong></span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card-cloudpc p-4 p-md-5 bg-white">
            <form asp-action="EditMachine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MachineId" />

                <div class="mb-3">
                    <label asp-for="MachineName" class="form-label small fw-semibold text-secondary">ชื่อเครื่องคอมพิวเตอร์</label>
                    <input asp-for="MachineName" class="form-control" autofocus required />
                    <span asp-validation-for="MachineName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CPU" class="form-label small fw-semibold text-secondary">หน่วยประมวลผล (CPU)</label>
                        <input asp-for="CPU" class="form-control" required />
                        <span asp-validation-for="CPU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RAM" class="form-label small fw-semibold text-secondary">หน่วยความจำ (RAM)</label>
                        <input asp-for="RAM" class="form-control" required />
                        <span asp-validation-for="RAM" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="GPU" class="form-label small fw-semibold text-secondary">การ์ดจอ (GPU)</label>
                        <input asp-for="GPU" class="form-control" required />
                        <span asp-validation-for="GPU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PricePerHour" class="form-label small fw-semibold text-secondary">ราคาต่อชั่วโมง (บาท)</label>
                        <input asp-for="PricePerHour" type="number" step="0.5" class="form-control" required />
                        <span asp-validation-for="PricePerHour" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Status" class="form-label small fw-semibold text-secondary">สถานะเครื่อง</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Available">พร้อมใช้งาน (Available)</option>
                        <option value="Rented">กำลังใช้งาน (Rented)</option>
                        <option value="PendingRepair">รอผู้จัดการอนุมัติซ่อม (PendingRepair)</option>
                        <option value="Maintenance">กำลังซ่อมบำรุง / ช่างกำลังดำเนินการ (Maintenance)</option>
                    </select>
                    <div class="form-text text-muted small mt-1">
                        <i class="bi bi-shield-lock me-1"></i> เฉพาะผู้จัดการหรือแอดมินเท่านั้นที่มีสิทธิ์แก้ไขข้อมูลสเปกและสถานะเครื่องโดยตรง
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="ManageMachines" class="btn btn-light rounded-3 px-4">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                        บันทึกการแก้ไข
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
