@{
    ViewData["Title"] = "วิธีใช้งานระบบเช่าคอมพิวเตอร์ - CloudPC";
}

<div class="py-3">
    <!-- Header Hero -->
    <div class="text-center mb-5 pb-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold mb-2" style="font-size: 0.8rem;">
            <i class="bi bi-info-circle-fill me-1"></i> คู่มือเริ่มต้นใช้งาน
        </span>
        <h1 class="fw-bold text-dark mt-2 mb-3" style="font-size: 2.3rem; letter-spacing: -0.5px;">
            วิธีใช้งานระบบเช่าคอมพิวเตอร์ CloudPC
        </h1>
        <p class="text-muted mx-auto" style="max-width: 650px; font-size: 1.05rem; line-height: 1.6;">
            เข้าถึงคอมพิวเตอร์สเปกแรงสำหรับเล่นเกม ตัดต่อกราฟิก หรือประมวลผลข้อมูลระดับสูงได้ง่ายๆ ใน 4 ขั้นตอน ไม่ต้องติดตั้งอุปกรณ์ฮาร์ดแวร์ราคาแพง
        </p>
    </div>

    <!-- 4 Steps Visual Flow -->
    <div class="row g-4 mb-5">
        <!-- Step 1 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white position-relative" style="border-color: #e2e8f0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-5" style="width: 44px; height: 44px;">
                        1
                    </div>
                    <span class="text-primary"><i class="bi bi-pc-display fs-2"></i></span>
                </div>
                <h5 class="fw-bold text-dark mb-2">เลือกสเปกเครื่อง</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.6;">
                    ค้นหาคอมพิวเตอร์จากหมวดหมู่ที่ต้องการ เช่น สายเกมมิ่ง, งานตัดต่อเรนเดอร์ 3D, ประมวลผล AI หรืองานออฟฟิศทั่วไป ตรวจสอบสเปก CPU, RAM, การ์ดจอ และราคาได้อย่างโปร่งใส
                </p>
                <div class="mt-auto pt-2 border-top">
                    <span class="badge bg-light text-muted border px-2 py-1 small">
                        <i class="bi bi-check2 text-success me-1"></i> สเปกแรงเริ่ม 5 บาท/ชม.
                    </span>
                </div>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white position-relative" style="border-color: #e2e8f0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-5" style="width: 44px; height: 44px;">
                        2
                    </div>
                    <span class="text-primary"><i class="bi bi-calendar3 fs-2"></i></span>
                </div>
                <h5 class="fw-bold text-dark mb-2">กำหนดวันและเวลา</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.6;">
                    เลือกวันที่ต้องการใช้งานบนปฏิทินอัจฉริยะ และคลิกเลือกช่วงเวลา (Slot) ได้ตามใจชอบ ระบบจะคำนวณจำนวนชั่วโมงและราคารวมให้อัตโนมัติ พร้อมใส่คูปองส่วนลดพิเศษ
                </p>
                <div class="mt-auto pt-2 border-top">
                    <span class="badge bg-light text-muted border px-2 py-1 small">
                        <i class="bi bi-clock-history text-primary me-1"></i> จองล่วงหน้าหรือทันที
                    </span>
                </div>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white position-relative" style="border-color: #e2e8f0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-5" style="width: 44px; height: 44px;">
                        3
                    </div>
                    <span class="text-primary"><i class="bi bi-credit-card-2-front fs-2"></i></span>
                </div>
                <h5 class="fw-bold text-dark mb-2">ชำระเงินสะดวกรวดเร็ว</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.6;">
                    รองรับการชำระเงินหลากหลายรูปแบบ เช่น สแกน QR PromptPay ทันใจ, บัตรเครดิต/เดบิต หรือยอดเงินในกระเป๋า CloudPC Wallet ระบบตรวจรับยอดชำระแบบเรียลไทม์
                </p>
                <div class="mt-auto pt-2 border-top">
                    <span class="badge bg-light text-muted border px-2 py-1 small">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> ปลอดภัย 100%
                    </span>
                </div>
            </div>
        </div>

        <!-- Step 4 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white position-relative" style="border-color: #e2e8f0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary text-white fw-bold fs-5" style="width: 44px; height: 44px;">
                        4
                    </div>
                    <span class="text-primary"><i class="bi bi-display fs-2"></i></span>
                </div>
                <h5 class="fw-bold text-dark mb-2">เชื่อมต่อเข้าใช้งาน</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.6;">
                    รับ IP Address และรหัสผ่านเข้าเครื่องได้ทันที กดปุ่ม "เข้ารีโมท" เพื่อควบคุมเครื่องเสมือนนั่งอยู่หน้าคอมพิวเตอร์จริง มีแผงจัดการเปิด/ปิด/รีสตาร์ทเครื่องได้ตลอด 24 ชม.
                </p>
                <div class="mt-auto pt-2 border-top">
                    <span class="badge bg-light text-muted border px-2 py-1 small">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> เริ่มใช้งานได้ใน 1 คลิก
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Supported Applications & Requirements -->
    <div class="row g-4 mb-5">
        <!-- Requirements Left -->
        <div class="col-lg-6">
            <div class="card border rounded-4 p-4 bg-white shadow-sm h-100" style="border-color: #e2e8f0 !important;">
                <h4 class="fw-bold text-dark mb-3 d-flex align-items-center">
                    <i class="bi bi-laptop text-primary me-2"></i> อุปกรณ์ที่รองรับการใช้งาน
                </h4>
                <p class="text-muted small mb-4">
                    CloudPC สามารถสตรีมมิ่งภาพและเสียงไปยังทุกอุปกรณ์ของคุณโดยไม่จำกัด ไม่จำเป็นต้องมีคอมพิวเตอร์สเปกแรงก็ใช้งานซอฟต์แวร์หนักๆ ได้
                </p>

                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light border">
                        <i class="bi bi-windows text-primary fs-3 me-3"></i>
                        <div>
                            <div class="fw-bold text-dark">คอมพิวเตอร์ Windows &amp; macOS</div>
                            <div class="text-muted small">ใช้งานผ่าน Web Browser หรือเชื่อมต่อผ่าน Moonlight, Parsec, Windows Remote Desktop</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light border">
                        <i class="bi bi-tablet-landscape text-success fs-3 me-3"></i>
                        <div>
                            <div class="fw-bold text-dark">แท็บเล็ตและไอแพด (iPadOS &amp; Android)</div>
                            <div class="text-muted small">รองรับการต่อคีย์บอร์ด เมาส์ และปากกา Stylus ทำงานนอกสถานที่ได้อย่างคล่องตัว</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center p-3 rounded-3 bg-light border">
                        <i class="bi bi-phone text-warning fs-3 me-3"></i>
                        <div>
                            <div class="fw-bold text-dark">สมาร์ทโฟนและสมาร์ททีวี</div>
                            <div class="text-muted small">ตรวจสอบงาน เรนเดอร์ไฟล์ หรือเปิดบอททิ้งไว้ ตรวจสอบสถานะได้ทุกที่ 24 ชั่วโมง</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Connection Benchmark / Tips Right -->
        <div class="col-lg-6">
            <div class="card border rounded-4 p-4 bg-white shadow-sm h-100" style="border-color: #e2e8f0 !important;">
                <h4 class="fw-bold text-dark mb-3 d-flex align-items-center">
                    <i class="bi bi-speedometer2 text-primary me-2"></i> คำแนะนำความเร็วอินเทอร์เน็ต
                </h4>
                <p class="text-muted small mb-4">
                    เพื่อประสบการณ์การควบคุมที่ลื่นไหลไร้อาการหน่วง (Low Latency) แนะนำให้ตรวจสอบความเร็วเน็ตดังนี้
                </p>

                <div class="mb-4">
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span>งานเอกสาร / ท่องเว็บ / บอท (15-25 Mbps)</span>
                        <span class="text-muted">Ping &lt; 50ms</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-info" style="width: 30%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span>ตัดต่อวิดีโอ 1080p / กราฟิก Photoshop (30-50 Mbps)</span>
                        <span class="text-muted">Ping &lt; 30ms</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" style="width: 60%"></div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between small fw-semibold mb-1">
                        <span>เล่นเกม 2K/4K 60-120 FPS / เรนเดอร์ 3D (100+ Mbps)</span>
                        <span class="text-success fw-bold">Ping &lt; 15ms (แนะนำ)</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: 95%"></div>
                    </div>
                </div>

                <!-- Interactive Connection Test Simulator -->
                <div class="p-3 rounded-3 border bg-light mt-auto">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-dark"><i class="bi bi-router me-1 text-primary"></i> ทดสอบความพร้อมเครือข่ายของคุณ</span>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" id="btnTestNetwork" onclick="testNetworkSpeed()">
                            <i class="bi bi-arrow-repeat me-1"></i> เริ่มทดสอบ
                        </button>
                    </div>
                    <div id="testResultBox" class="small text-muted">
                        คลิกปุ่มเพื่อทดสอบค่า Latency (Ping) ไปยัง CloudPC Bangkok Server Node
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action Banner -->
    <div class="card rounded-4 p-5 text-center text-white border-0 shadow-sm" style="background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);">
        <h2 class="fw-bold mb-2">พร้อมเริ่มต้นใช้งานแล้วหรือยัง?</h2>
        <p class="text-white-50 mx-auto mb-4" style="max-width: 600px;">
            เลือกเครื่องสเปกในฝันของคุณและเชื่อมต่อเพื่อเริ่มทำงานหรือเล่นเกมได้ทันทีในไม่กี่นาที
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Machines" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm">
                <i class="bi bi-pc-display me-1"></i> ค้นหาเครื่องและจองเลย
            </a>
            <a asp-action="Help" class="btn btn-outline-light fw-bold px-4 py-2 rounded-3">
                <i class="bi bi-question-circle me-1"></i> ศูนย์ช่วยเหลือและ FAQ
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function testNetworkSpeed() {
        const btn = document.getElementById('btnTestNetwork');
        const box = document.getElementById('testResultBox');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> กำลังทดสอบ...';
        box.innerHTML = '<span class="text-primary"><i class="bi bi-hourglass-split"></i> กำลังส่งสัญญาณ Ping ไปยัง Bangkok Data Center...</span>';

        setTimeout(() => {
            const ping = Math.floor(Math.random() * 8) + 12; // 12-20 ms
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> ทดสอบอีกครั้ง';
            box.innerHTML = `
                <div class="d-flex align-items-center justify-content-between text-success fw-bold">
                    <span><i class="bi bi-check-circle-fill me-1"></i> การเชื่อมต่อยอดเยี่ยม!</span>
                    <span class="badge bg-success text-white">Latency: ${ping} ms</span>
                </div>
                <div class="text-muted small mt-1">เครือข่ายของคุณเหมาะสมมากสำหรับการสตรีมมิ่งเกม 60 FPS และงานตัดต่อกราฟิกความละเอียดสูง</div>
            `;
        }, 1200);
    }
</script>
}
