@model CloudPCRental.Models.AccountSettingsViewModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "ตั้งค่าบัญชี";
    var memberInfo = CloudPCRental.Models.MockDataStore.GetUserMembershipInfo(Model.UserId, Model.Username);
    string tierClass = memberInfo.TierName switch
    {
        "Diamond" => "badge-tier-diamond",
        "Platinum" => "badge-tier-platinum",
        "Gold" => "badge-tier-gold",
        "Silver" => "badge-tier-silver",
        _ => "badge-tier-bronze"
    };
    string memberCode = memberInfo.MemberNumber;
}

<!-- Header -->
<div class="mb-4">
    <div class="text-muted small">แดชบอร์ดลูกค้า</div>
    <h3 class="fw-bold text-dark mb-0">ตั้งค่าบัญชีผู้ใช้งาน</h3>
</div>

<div class="row g-4">
    <!-- Left Column: Profile Card & Information -->
    <div class="col-lg-7">
        <div class="card-cloudpc p-4 bg-white mb-4">
            <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                <div class="p-3 bg-primary-subtle text-primary rounded-circle me-3 border border-primary-subtle">
                    <i class="bi bi-person-fill fs-2"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                    <div class="text-muted small d-flex align-items-center flex-wrap gap-2">
                        <span>รหัสสมาชิก: <strong class="text-primary font-monospace">ID: @memberCode</strong></span>
                        <span class="text-muted opacity-50">|</span>
                        <span class="d-inline-flex align-items-center">
                            ระดับ: 
                            <a asp-controller="CloudPC" asp-action="Membership" class="text-decoration-none ms-1">
                                <span class="@tierClass" title="คลิกเพื่อดูสิทธิประโยชน์ระดับ @memberInfo.TierName">
                                    <i class="bi bi-award"></i> @memberInfo.TierName Member
                                </span>
                            </a>
                        </span>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-person-lines-fill text-primary me-2"></i> ข้อมูลส่วนตัว</h6>

            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label small fw-semibold text-secondary">ชื่อ - นามสกุล</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label small fw-semibold text-secondary">ชื่อผู้ใช้งาน (Username)</label>
                        <input asp-for="Username" class="form-control" required />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary">
                            เบอร์โทรศัพท์ติดต่อ <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-telephone"></i>
                            </span>
                            <input asp-for="PhoneNumber" 
                                   id="userPhoneNumber"
                                   type="tel" 
                                   class="form-control border-start-0" 
                                   placeholder="0XX-XXX-XXXX" 
                                   maxlength="12" 
                                   pattern="0[0-9]{2}-[0-9]{3}-[0-9]{4}" 
                                   autocomplete="tel"
                                   required />
                        </div>
                        <div class="form-text text-muted" style="font-size: 0.74rem;">
                            <i class="bi bi-info-circle me-1"></i> เฉพาะตัวเลข 10 หลักตามเบอร์จริง (เช่น 081-234-5678)
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">อีเมลสำหรับรับข้อมูลและใบเสร็จ</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-save me-1"></i> บันทึกข้อมูลส่วนตัว
                </button>
            </form>
        </div>

        <!-- Notification Preferences -->
        <div class="card-cloudpc p-4 bg-white">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bell-fill text-secondary me-2"></i> การแจ้งเตือนของระบบ</h6>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="notifyEmail" checked>
                <label class="form-check-label small" for="notifyEmail">
                    <strong>แจ้งเตือนผ่านอีเมล</strong>
                    <div class="text-muted" style="font-size: 0.75rem;">รับใบเสร็จรับเงินออนไลน์และการยืนยันการจอง</div>
                </label>
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="notifyExpiring" checked>
                <label class="form-check-label small" for="notifyExpiring">
                    <strong>แจ้งเตือนเมื่อเวลาการใช้งานใกล้หมด (15 นาทีก่อนหมดเวลา)</strong>
                    <div class="text-muted" style="font-size: 0.75rem;">แจ้งเตือนในหน้าแดชบอร์ดเพื่อให้ต่อเวลาได้ทันท่วงที</div>
                </label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="notifyPromo">
                <label class="form-check-label small" for="notifyPromo">
                    <strong>ข่าวสารโปรโมชั่นและส่วนลดพิเศษ</strong>
                    <div class="text-muted" style="font-size: 0.75rem;">รับคูปองส่วนลดค่าเช่าเครื่องรายสัปดาห์</div>
                </label>
            </div>
        </div>
    </div>

    <!-- Right Column: Change Password & Security -->
    <div class="col-lg-5">
        <div class="card-cloudpc p-4 bg-white mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock-fill text-warning me-2"></i> เปลี่ยนรหัสผ่านเข้าสู่ระบบ</h6>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary">รหัสผ่านปัจจุบัน</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="กรอกรหัสผ่านเดิม" required />
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary">รหัสผ่านใหม่</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="กำหนดรหัสผ่านใหม่" required />
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-secondary">ยืนยันรหัสผ่านใหม่</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" required />
                </div>

                <button type="submit" class="btn btn-outline-primary rounded-3 px-4 py-2 fw-semibold w-100">
                    <i class="bi bi-key-fill me-1"></i> อัปเดตรหัสผ่าน
                </button>
            </form>
        </div>

        <!-- Membership & PTS Quick Card -->
        <div class="card-cloudpc p-3 mb-3 border shadow-xs" style="background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%); border-color: #bae6fd !important;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center">
                    <span class="@tierClass me-2">
                        <i class="bi bi-award text-primary"></i> @memberInfo.TierName
                    </span>
                    <strong class="text-dark small">ระดับสมาชิกของคุณ</strong>
                </div>
                <span class="badge bg-primary text-white font-monospace px-2 py-1">@memberInfo.CurrentPoints.ToString("N0") PTS</span>
            </div>
            <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                สิทธิประโยชน์ปัจจุบัน: ส่วนลดค่าเช่า @(memberInfo.TierName == "Bronze" ? "5%" : memberInfo.TierName == "Silver" ? "8%" : memberInfo.TierName == "Gold" ? "12%" : memberInfo.TierName == "Platinum" ? "15%" : "20%"), อัปเกรดเน็ตความเร็วสูง, สิทธิ์สะสมพอยต์แลกชั่วโมงฟรี
            </p>
            <a asp-controller="CloudPC" asp-action="Membership" class="btn btn-sm btn-outline-primary w-100 fw-semibold rounded-2" style="font-size: 0.78rem;">
                <i class="bi bi-award me-1"></i> ดูสิทธิพิเศษและตารางแรงก์ทั้งหมด
            </a>
        </div>

        <!-- Security status info -->
        <div class="card-cloudpc p-3 bg-light border">
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-shield-check text-success fs-4 me-2"></i>
                <strong class="text-dark small">ความปลอดภัยของบัญชี: ดีเยี่ยม</strong>
            </div>
            <p class="text-muted small mb-0" style="font-size: 0.78rem;">
                บัญชีของคุณมีการเข้ารหัสแบบ SSL/TLS 256-bit และเปิดระบบป้องกันการล็อกอินผิดซ้ำ หากมีข้อสงสัยกรุณาติดต่อทีมสนับสนุน
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const phoneInput = document.getElementById("userPhoneNumber");
            if (phoneInput) {
                function formatPhoneValue(val) {
                    let digits = val.replace(/\D/g, "");
                    if (digits.length > 10) {
                        digits = digits.substring(0, 10);
                    }
                    if (digits.length > 6) {
                        return digits.substring(0, 3) + "-" + digits.substring(3, 6) + "-" + digits.substring(6, 10);
                    } else if (digits.length > 3) {
                        return digits.substring(0, 3) + "-" + digits.substring(3, 6);
                    } else {
                        return digits;
                    }
                }

                phoneInput.addEventListener("input", function () {
                    this.value = formatPhoneValue(this.value);
                });

                phoneInput.addEventListener("keypress", function (e) {
                    if (!/\d/.test(e.key)) {
                        e.preventDefault();
                        return;
                    }
                    let digits = this.value.replace(/\D/g, "");
                    if (digits.length >= 10 && this.selectionStart === this.selectionEnd) {
                        e.preventDefault();
                    }
                });

                phoneInput.addEventListener("paste", function (e) {
                    e.preventDefault();
                    let pasteText = (e.clipboardData || window.clipboardData).getData("text");
                    this.value = formatPhoneValue(pasteText);
                });
            }
        });
    </script>
}

