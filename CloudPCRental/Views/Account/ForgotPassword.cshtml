@model CloudPCRental.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "กู้คืนรหัสผ่าน - CloudPC";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card-cloudpc p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-dark mb-1">กู้คืนรหัสผ่าน</h4>
                <p class="text-muted small">กรอกอีเมลของคุณเพื่อกำหนดรหัสผ่านใหม่สำหรับเข้าใช้งาน</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small" role="alert">
                    @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">อีเมลที่ใช้ลงทะเบียน</label>
                    <input asp-for="Email" class="form-control" placeholder="กรอกอีเมลที่ผูกกับบัญชี" autofocus required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary">รหัสผ่านใหม่</label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="กำหนดรหัสผ่านใหม่" required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label small fw-semibold text-secondary">ยืนยันรหัสผ่านใหม่</label>
                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="ยืนยันรหัสผ่านใหม่อีกครั้ง" required />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary btn-lg py-2 rounded-3 fw-semibold">
                        ยืนยันการเปลี่ยนรหัสผ่าน
                    </button>
                </div>
            </form>

            <div class="text-center mt-4">
                <a asp-action="Login" class="text-primary text-decoration-none small fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> ย้อนกลับไปหน้าเข้าสู่ระบบ
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
