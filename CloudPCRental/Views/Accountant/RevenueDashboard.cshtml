@model CloudPCRental.Models.RevenueDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แดชบอร์ดรายได้และการเงิน";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">ระบบติดตามรายได้ รายงานธุรกรรม และแนวโน้มยอดขายคลาวด์คอมพิวเตอร์</div>
        <h3 class="fw-bold text-dark mb-0">แดชบอร์ดรายได้ (Revenue Dashboard)</h3>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
            <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
            <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
        </div>
        <a asp-action="PendingPayments" class="btn btn-warning rounded-3 btn-sm fw-semibold shadow-xs">
            <i class="bi bi-receipt me-1"></i> ตรวจสอบสลิป (@Model.PendingPaymentsCount)
        </a>
        <a asp-action="Refunds" class="btn btn-outline-danger rounded-3 btn-sm fw-semibold shadow-xs">
            <i class="bi bi-arrow-counterclockwise me-1"></i> คืนเงิน (@Model.PendingRefundsCount)
        </a>
    </div>
</div>

<!-- 4 Key Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">รายได้รวมทั้งหมด</span>
                <span class="text-success"><i class="bi bi-wallet2 fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-dark my-2">@Model.TotalRevenue.ToString("N0") ฿</h3>
            <div class="text-success small" style="font-size: 0.72rem;">
                <i class="bi bi-check-circle me-1"></i> คำนวณจากสลิปที่อนุมัติแล้ว
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">รายได้วันนี้</span>
                <span class="text-primary"><i class="bi bi-calendar-check fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-primary my-2">@Model.TodayRevenue.ToString("N0") ฿</h3>
            <div class="text-muted small" style="font-size: 0.72rem;">
                อัปเดตตามเวลาจริงของวันปัจจุบัน
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">รายได้เดือนนี้</span>
                <span class="text-info"><i class="bi bi-graph-up fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-dark my-2">@Model.MonthRevenue.ToString("N0") ฿</h3>
            <div class="text-muted small" style="font-size: 0.72rem;">
                ยอดสะสมประจำเดือนปัจจุบัน
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm" style="@(Model.PendingPaymentsCount > 0 ? "border-left: 4px solid #f59e0b !important;" : "")">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">รายการที่ต้องจัดการ</span>
                <span class="text-warning"><i class="bi bi-bell-fill fs-5"></i></span>
            </div>
            <h3 class="fw-bold my-2 @(Model.PendingPaymentsCount > 0 ? "text-warning" : "text-success")">
                @(Model.PendingPaymentsCount + Model.PendingRefundsCount) รายการ
            </h3>
            <div class="text-muted small" style="font-size: 0.72rem;">
                รอตรวจสลิป @Model.PendingPaymentsCount | รอคืนเงิน @Model.PendingRefundsCount
            </div>
        </div>
    </div>
</div>

<!-- Charts Section (Chart.js) -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Line Chart (รายวัน & รายสัปดาห์) -->
    <div class="col-lg-7">
        <div class="card-cloudpc bg-white p-4 h-100 border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-graph-up text-primary me-1"></i> แนวโน้มรายได้ (Line Chart)
                    </h6>
                    <small class="text-muted" id="chartPeriodSubtitle">รายได้ย้อนหลัง 7 วัน</small>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-primary active px-3" id="btnDailyChart">รายวัน</button>
                    <button type="button" class="btn btn-outline-primary px-3" id="btnWeeklyChart">รายสัปดาห์</button>
                </div>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="revenueTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Bar Chart (รายได้รายเดือน ตลอดปี) -->
    <div class="col-lg-5">
        <div class="card-cloudpc bg-white p-4 h-100 border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-bar-chart-fill text-success me-1"></i> รายได้รายเดือน (Bar Chart)
                    </h6>
                    <small class="text-muted">ปี @DateTime.Now.Year</small>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                    12 เดือน
                </span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="monthlyBarChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Transactions Table -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h6 class="fw-bold text-dark mb-0">รายการธุรกรรมล่าสุด</h6>
            <small class="text-muted">ประวัติการชำระเงินและคำขอคืนเงินทั้งหมด (@Model.TotalTransactionsCount รายการ)</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PendingPayments" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                ดูสลิปที่รอตรวจ <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">รหัสธุรกรรม</th>
                    <th>วันที่ - เวลา</th>
                    <th>ผู้ใช้งาน</th>
                    <th>เครื่องคอมพิวเตอร์</th>
                    <th>ยอดเงิน</th>
                    <th>สถานะธุรกรรม</th>
                    <th class="text-end pe-3">หลักฐาน</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                {
                    @foreach (var item in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">#BK-@item.BookingId.ToString("D4")</td>
                            <td class="text-muted">@item.PaymentDate.ToString("dd/MM/yyyy HH:mm น.")</td>
                            <td>
                                <div class="fw-semibold text-dark">@(item.User?.Username ?? $"User #{item.UserId}")</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@(item.User?.Email ?? "-")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">PC-@item.MachineId.ToString("D3")</span>
                                <span class="text-secondary ms-1">@(item.Machine?.MachineName ?? "Cloud PC")</span>
                            </td>
                            <td class="fw-bold text-dark">@item.TotalAmount.ToString("N2") ฿</td>
                            <td>
                                @if (item.PaymentStatus == "Approved")
                                {
                                    <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">
                                        <i class="bi bi-check-circle me-1"></i> อนุมัติแล้ว
                                    </span>
                                }
                                else if (item.PaymentStatus == "Pending")
                                {
                                    <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                        <i class="bi bi-hourglass-split me-1"></i> รอตรวจสลิป
                                    </span>
                                }
                                else if (item.PaymentStatus == "RefundRequested")
                                {
                                    <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> ขอคืนเงิน
                                    </span>
                                }
                                else if (item.PaymentStatus == "Refunded")
                                {
                                    <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">
                                        <i class="bi bi-check-circle me-1"></i> คืนเงินแล้ว
                                    </span>
                                }
                                else if (item.PaymentStatus == "RefundRejected")
                                {
                                    <span class="badge" style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">
                                        <i class="bi bi-x-circle me-1"></i> ปฏิเสธคืนเงิน
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.PaymentStatus</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                @if (!string.IsNullOrEmpty(item.SlipImageUrl))
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-primary py-0 px-2 btn-preview-slip" 
                                            data-slip="@item.SlipImageUrl" 
                                            data-title="สลิปโอนเงิน #BK-@item.BookingId.ToString("D4")"
                                            style="font-size: 0.75rem;">
                                        <i class="bi bi-image me-1"></i> ดูสลิป
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 0.75rem;">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">ไม่พบรายการธุรกรรมในระบบ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal ดูรูปภาพสลิป -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold" id="previewModalTitle">สลิปการโอนเงิน</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3 bg-dark bg-opacity-10">
                <img id="previewModalImg" src="" alt="Slip Preview" class="img-fluid rounded shadow-sm" style="max-height: 500px;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. จัดเตรียมข้อมูลจาก C# ViewModel แปลงเป็น JavaScript Array
        const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyLabels));
        const dailyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyRevenues));

        const weeklyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLabels));
        const weeklyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyRevenues));

        const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels));
        const monthlyRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues));

        // 2. พล็อตกราฟ Line Chart (รายได้รายวัน / รายสัปดาห์)
        const ctxTrend = document.getElementById('revenueTrendChart').getContext('2d');
        const trendGradient = ctxTrend.createLinearGradient(0, 0, 0, 260);
        trendGradient.addColorStop(0, 'rgba(37, 99, 235, 0.25)');
        trendGradient.addColorStop(1, 'rgba(37, 99, 235, 0.0)');

        let trendChart = new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: dailyLabels,
                datasets: [{
                    label: 'รายได้ (บาท)',
                    data: dailyRevenues,
                    borderColor: '#2563eb',
                    backgroundColor: trendGradient,
                    borderWidth: 2.5,
                    fill: true,
                    tension: 0.35,
                    pointBackgroundColor: '#2563eb',
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return ' ' + context.parsed.y.toLocaleString('th-TH') + ' บาท';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return value.toLocaleString('th-TH') + ' ฿';
                            }
                        },
                        grid: { borderDash: [4, 4], color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // สลับมุมมอง รายวัน / รายสัปดาห์
        const btnDaily = document.getElementById('btnDailyChart');
        const btnWeekly = document.getElementById('btnWeeklyChart');
        const subtitle = document.getElementById('chartPeriodSubtitle');

        btnDaily.addEventListener('click', function () {
            btnDaily.classList.add('active');
            btnWeekly.classList.remove('active');
            subtitle.innerText = 'รายได้ย้อนหลัง 7 วัน';
            trendChart.data.labels = dailyLabels;
            trendChart.data.datasets[0].data = dailyRevenues;
            trendChart.update();
        });

        btnWeekly.addEventListener('click', function () {
            btnWeekly.classList.add('active');
            btnDaily.classList.remove('active');
            subtitle.innerText = 'รายได้ย้อนหลัง 4 สัปดาห์';
            trendChart.data.labels = weeklyLabels;
            trendChart.data.datasets[0].data = weeklyRevenues;
            trendChart.update();
        });

        // 3. พล็อตกราฟ Bar Chart (รายได้รายเดือน)
        const ctxBar = document.getElementById('monthlyBarChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: monthlyLabels,
                datasets: [{
                    label: 'รายได้รายเดือน (บาท)',
                    data: monthlyRevenues,
                    backgroundColor: '#10b981',
                    borderRadius: 6,
                    hoverBackgroundColor: '#059669'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return ' ' + context.parsed.y.toLocaleString('th-TH') + ' บาท';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) {
                                return value.toLocaleString('th-TH') + ' ฿';
                            }
                        },
                        grid: { borderDash: [4, 4], color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 4. Modal ดูสลิป
        const previewBtns = document.querySelectorAll('.btn-preview-slip');
        const modalImg = document.getElementById('previewModalImg');
        const modalTitle = document.getElementById('previewModalTitle');
        const modalEl = document.getElementById('imagePreviewModal');
        let modal = null;
        if (modalEl && typeof bootstrap !== 'undefined') {
            modal = new bootstrap.Modal(modalEl);
        }

        previewBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                const slipUrl = this.getAttribute('data-slip');
                const title = this.getAttribute('data-title');
                if (modalImg) modalImg.src = slipUrl;
                if (modalTitle) modalTitle.innerText = title;
                if (modal) modal.show();
            });
        });
    });
</script>
}
