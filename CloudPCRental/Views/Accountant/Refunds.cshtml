@model IEnumerable<CloudPCRental.Models.Booking>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการการยกเลิกและคืนเงิน";

    var pendingRefunds = Model?.Where(b => b.PaymentStatus == "RefundRequested").OrderByDescending(b => b.PaymentDate).ToList() ?? new List<CloudPCRental.Models.Booking>();
    var historyRefunds = Model?.Where(b => b.PaymentStatus == "Refunded" || b.PaymentStatus == "RefundRejected").OrderByDescending(b => b.RefundDate ?? b.PaymentDate).ToList() ?? new List<CloudPCRental.Models.Booking>();

    int pendingRefundCount = pendingRefunds.Count;
    int historyRefundCount = historyRefunds.Count;
    int approvedRefundCount = historyRefunds.Count(b => b.PaymentStatus == "Refunded");
    int rejectedRefundCount = historyRefunds.Count(b => b.PaymentStatus == "RefundRejected");
    decimal totalPendingRefundAmount = pendingRefunds.Sum(b => b.TotalAmount);
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">ระบบตรวจสอบคำขอยกเลิกการเช่าเครื่อง ตรวจสอบข้อมูลเงื่อนไขตามนโยบาย และบันทึกประวัติการคืนเงิน</div>
        <h3 class="fw-bold text-dark mb-0">จัดการการยกเลิกและคืนเงิน (Refund Management)</h3>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
            <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
            <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
        </div>
        <a asp-action="RevenueDashboard" class="btn btn-outline-secondary rounded-3 btn-sm">
            <i class="bi bi-arrow-left me-1"></i> กลับแดชบอร์ดรายได้
        </a>
    </div>
</div>

<!-- 3 Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-4">
        <div class="card-cloudpc p-3 bg-white border rounded-3 shadow-sm" style="border-left: 4px solid #f59e0b !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">รอตรวจสอบเงื่อนไข</span>
                    <h3 class="fw-bold my-1 text-warning">@pendingRefundCount <small class="fs-6 text-muted">รายการ</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ตรวจสอบข้อมูลและพิจารณาคืนเงิน</div>
                </div>
                <div class="text-warning fs-3"><i class="bi bi-clipboard-check"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4">
        <div class="card-cloudpc p-3 bg-white border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">ยอดเงินที่ขอคืนค้างอยู่</span>
                    <h3 class="fw-bold text-dark my-1">@totalPendingRefundAmount.ToString("N2") <small class="fs-6 text-muted">บาท</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ยอดเงินรวมที่ลูกค้ายื่นคำขอคืน</div>
                </div>
                <div class="text-primary fs-3"><i class="bi bi-cash-coin"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-12 col-md-4">
        <div class="card-cloudpc p-3 bg-white border rounded-3 shadow-sm" style="border-left: 4px solid #10b981 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">ประวัติพิจารณาแล้วทั้งหมด</span>
                    <h3 class="fw-bold text-success my-1">@historyRefundCount <small class="fs-6 text-muted">รายการ</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">อนุมัติแล้ว @approvedRefundCount | ปฏิเสธ @rejectedRefundCount</div>
                </div>
                <div class="text-success fs-3"><i class="bi bi-clock-history"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Policy Notice Banner -->
<div class="alert alert-light border shadow-xs rounded-3 p-3 mb-4 d-flex align-items-center gap-3">
    <div class="p-2 bg-primary-subtle text-primary rounded-circle flex-shrink-0">
        <i class="bi bi-shield-check fs-5"></i>
    </div>
    <div class="small">
        <strong class="text-dark">เกณฑ์การพิจารณาคืนเงินของบริษัท:</strong>
        <span class="text-secondary">
            1. เครื่องมีปัญหาขัดข้องหรือจอฟ้าจากฝั่งระบบจริง &bull; 
            2. ขอยกเลิกก่อนเริ่มใช้งาน หรือใช้งานไม่เกิน 1 ชั่วโมง &bull; 
            3. ตรวจสอบข้อมูลสลิปเดิมและยอดเงินให้ตรงกับระบบก่อนกดอนุมัติคืนเงิน
        </span>
    </div>
</div>

<!-- Tab Switcher Navigation -->
<ul class="nav nav-pills mb-3 gap-2 bg-white p-2 rounded-4 shadow-sm border" id="refundTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold rounded-3 px-4 py-2" id="refund-pending-tab" data-bs-toggle="pill" data-bs-target="#tab-refund-pending" type="button" role="tab" aria-controls="tab-refund-pending" aria-selected="true">
            <i class="bi bi-hourglass-split me-1 text-warning"></i> คำขอรอตรวจสอบ 
            <span class="badge bg-warning text-dark ms-2 rounded-pill">@pendingRefundCount</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold rounded-3 px-4 py-2 text-secondary" id="refund-history-tab" data-bs-toggle="pill" data-bs-target="#tab-refund-history" type="button" role="tab" aria-controls="tab-refund-history" aria-selected="false">
            <i class="bi bi-clock-history me-1 text-primary"></i> ประวัติการคืนเงิน 
            <span class="badge bg-secondary ms-2 rounded-pill">@historyRefundCount</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="refundTabsContent">
    <!-- TAB 1: คำขอรอตรวจสอบ (Pending) -->
    <div class="tab-pane fade show active" id="tab-refund-pending" role="tabpanel" aria-labelledby="refund-pending-tab">
        <div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h6 class="fw-bold text-dark mb-0">รายการคำขอคืนเงินที่รอการพิจารณา (@pendingRefundCount รายการ)</h6>
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> คลิกปุ่ม "ตรวจสอบ &amp; พิจารณา" เพื่อดูข้อมูลที่ลูกค้ายื่นมาและตรวจสอบเงื่อนไข
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-3">รหัสการจอง</th>
                            <th>วันที่ทำรายการ</th>
                            <th>ลูกค้า</th>
                            <th>เครื่องคอมพิวเตอร์</th>
                            <th>ยอดเงินขอคืน</th>
                            <th>ข้อมูล &amp; เหตุผลที่ยื่นมา</th>
                            <th>สถานะ</th>
                            <th class="text-end pe-3">การพิจารณา</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pendingRefunds.Any())
                        {
                            @foreach (var item in pendingRefunds)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary font-monospace">
                                        #BK-@item.BookingId.ToString("D4")
                                        @if (item.BookingId == 94812 || item.BookingId == 104 || item.BookingId == 103)
                                        {
                                            <div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">#CPC-94812</span>
                                            </div>
                                        }
                                        else if (item.BookingId >= 95000)
                                        {
                                            <div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">#CPC-@item.BookingId</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted">@item.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.User?.Username ?? $"User #{item.UserId}")</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@(item.User?.Email ?? "-")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">PC-@item.MachineId.ToString("D3")</span>
                                        <span class="text-secondary ms-1">@(item.Machine?.MachineName ?? "Cloud PC")</span>
                                    </td>
                                    <td><strong class="text-dark fs-6">@item.TotalAmount.ToString("N2") ฿</strong></td>
                                    <td>
                                        <div class="p-2 rounded" style="background-color: #fff8f8; border-left: 3px solid #f43f5e; max-width: 280px;">
                                            <div class="text-danger fw-medium" style="line-height: 1.3;">
                                                @(item.RefundReason ?? "ลูกค้าขอยกเลิกการใช้งาน")
                                            </div>
                                            @if (!string.IsNullOrEmpty(item.Note))
                                            {
                                                <div class="text-muted small mt-1" style="font-size: 0.7rem;">หมายเหตุ: @item.Note</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                            <i class="bi bi-hourglass-split me-1"></i> รอตรวจสอบเงื่อนไข
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <button type="button" 
                                                    class="btn btn-sm btn-primary fw-semibold rounded-3 px-3 btn-review-refund shadow-xs" 
                                                    data-id="@item.BookingId"
                                                    data-code="#BK-@item.BookingId.ToString("D4")"
                                                    data-user="@(item.User?.Username ?? "ลูกค้า")"
                                                    data-email="@(item.User?.Email ?? "-")"
                                                    data-machine="PC-@item.MachineId.ToString("D3") (@(item.Machine?.MachineName ?? "Cloud PC"))"
                                                    data-amount="@item.TotalAmount.ToString("N2")"
                                                    data-date="@item.PaymentDate.ToString("dd/MM/yyyy HH:mm")"
                                                    data-reason="@(item.RefundReason ?? "-")"
                                                    data-original-slip="@(item.SlipImageUrl ?? "")">
                                                <i class="bi bi-clipboard-check me-1"></i> ตรวจสอบ &amp; พิจารณา
                                            </button>
                                            <form asp-controller="Accountant" asp-action="ApproveRefund" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@item.BookingId" />
                                                <input type="hidden" name="note" value="ตรวจสอบเงื่อนไขตรงตามนโยบาย อนุมัติคืนเงินเต็มจำนวนเรียบร้อย (+60.00 ฿ เข้ากระเป๋าเงิน)" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2 py-1 shadow-xs" title="อนุมัติคืนเงินทันที (+@item.TotalAmount.ToString("N0") ฿)">
                                                    <i class="bi bi-check-lg me-1"></i> อนุมัติด่วน
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                                    <h6 class="fw-bold text-dark">ไม่มีคำขอคืนเงินที่รอการตรวจสอบ</h6>
                                    <p class="small mb-0">ระบบได้ตรวจสอบและพิจารณาคำขอทั้งหมดเรียบร้อยแล้ว (สามารถดูประวัติย้อนหลังได้ที่แท็บ "ประวัติการคืนเงิน")</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TAB 2: ประวัติการคืนเงิน (History) -->
    <div class="tab-pane fade" id="tab-refund-history" role="tabpanel" aria-labelledby="refund-history-tab">
        <div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h6 class="fw-bold text-dark mb-0">ประวัติการคืนเงินและคำขอที่พิจารณาแล้ว (@historyRefundCount รายการ)</h6>
                    <div class="text-muted small">บันทึกประวัติคำขอคืนเงินทั้งหมดที่ฝ่ายบัญชีได้อนุมัติคืนเงินหรือปฏิเสธแล้ว ย้อนหลังสำหรับตรวจสอบความถูกต้อง</div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-3">รหัสการจอง</th>
                            <th>วันที่ยื่นคำขอ</th>
                            <th>วันที่ดำเนินการ</th>
                            <th>ลูกค้า</th>
                            <th>เครื่องคอมพิวเตอร์</th>
                            <th>ยอดเงินขอคืน</th>
                            <th>เหตุผลของลูกค้า</th>
                            <th>สถานะการพิจารณา</th>
                            <th class="text-end pe-3">รายละเอียด</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (historyRefunds.Any())
                        {
                            @foreach (var item in historyRefunds)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary font-monospace">
                                        #BK-@item.BookingId.ToString("D4")
                                        @if (item.BookingId == 94812 || item.BookingId == 104 || item.BookingId == 103)
                                        {
                                            <div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">#CPC-94812</span>
                                            </div>
                                        }
                                        else if (item.BookingId >= 95000)
                                        {
                                            <div>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.68rem;">#CPC-@item.BookingId</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-muted">@item.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-muted">@(item.RefundDate?.ToString("dd/MM/yyyy HH:mm น.") ?? "-")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.User?.Username ?? $"User #{item.UserId}")</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@(item.User?.Email ?? "-")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">PC-@item.MachineId.ToString("D3")</span>
                                        <span class="text-secondary ms-1">@(item.Machine?.MachineName ?? "Cloud PC")</span>
                                    </td>
                                    <td><strong class="text-dark fs-6">@item.TotalAmount.ToString("N2") ฿</strong></td>
                                    <td>
                                        <div class="p-2 rounded bg-light border" style="max-width: 250px;">
                                            <div class="text-dark small" style="line-height: 1.3;">
                                                @(item.RefundReason ?? "ลูกค้าขอยกเลิกการใช้งาน")
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.PaymentStatus == "Refunded")
                                        {
                                            <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">
                                                <i class="bi bi-check-circle-fill me-1"></i> อนุมัติคืนเงินแล้ว
                                            </span>
                                        }
                                        else if (item.PaymentStatus == "RefundRejected")
                                        {
                                            <span class="badge" style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">
                                                <i class="bi bi-x-circle-fill me-1"></i> ปฏิเสธคำขอ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.PaymentStatus</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-secondary rounded-3 px-3 btn-view-decision shadow-xs" 
                                                data-code="#BK-@item.BookingId.ToString("D4")"
                                                data-status="@(item.PaymentStatus == "Refunded" ? "อนุมัติการคืนเงินเรียบร้อย" : "ปฏิเสธคำขอคืนเงิน")"
                                                data-status-class="@(item.PaymentStatus == "Refunded" ? "text-success" : "text-danger")"
                                                data-date="@(item.RefundDate?.ToString("dd/MM/yyyy HH:mm น.") ?? "-")"
                                                data-reason="@(item.RefundReason ?? "-")"
                                                data-note="@(item.Note ?? "ตรวจสอบตามขั้นตอนเรียบร้อย")">
                                            <i class="bi bi-journal-check me-1"></i> ดูผลการพิจารณา
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-clock-history fs-1 text-secondary d-block mb-2"></i>
                                    <h6 class="fw-bold text-dark">ยังไม่มีประวัติการคืนเงิน</h6>
                                    <p class="small mb-0">รายการคำขอที่ผ่านการพิจารณาจะถูกจัดเก็บไว้ที่นี่เพื่อการตรวจสอบย้อนหลัง</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: ตรวจสอบข้อมูลและพิจารณาเงื่อนไขการคืนเงิน -->
<div class="modal fade" id="reviewRefundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-bottom">
                <div>
                    <h6 class="modal-title fw-bold text-dark mb-0">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>ตรวจสอบข้อมูลและพิจารณาเงื่อนไขการคืนเงิน
                    </h6>
                    <small class="text-muted" id="modalReviewSubtitle">รหัสการจอง: -</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="refundDecisionForm" method="post" asp-controller="Accountant" asp-action="ApproveRefund">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalBookingId" name="bookingId" value="" />

                <div class="modal-body p-4">
                    <!-- ข้อมูลคำขอที่ลูกค้ายื่นมา -->
                    <div class="card border rounded-3 p-3 bg-light mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <span class="fw-bold text-dark small"><i class="bi bi-person-fill text-primary me-1"></i> ข้อมูลที่ลูกค้ายื่นคำขอเข้ามา</span>
                            <span class="badge bg-white text-primary border fw-bold" id="modalReviewCode">#BK-0000</span>
                        </div>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted">ลูกค้า:</span> 
                                <strong class="text-dark ms-1" id="modalReviewUser">-</strong>
                                <span class="text-muted ms-1" id="modalReviewEmail">(-)</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">เครื่องที่จอง:</span> 
                                <strong class="text-dark ms-1" id="modalReviewMachine">-</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">วันที่ชำระเงิน:</span> 
                                <span class="text-dark ms-1" id="modalReviewDate">-</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">ยอดเงินขอคืน:</span> 
                                <strong class="text-danger fs-6 ms-1" id="modalReviewAmount">0.00 ฿</strong>
                            </div>
                        </div>

                        <!-- เหตุผลที่ลูกค้ายื่นมา -->
                        <div class="mt-3 p-3 bg-white rounded border">
                            <div class="fw-semibold text-danger small mb-1">
                                <i class="bi bi-chat-quote-fill me-1"></i> เหตุผลและรายละเอียดที่ลูกค้าระบุ:
                            </div>
                            <div id="modalReviewReason" class="text-dark small" style="line-height: 1.4;">-</div>
                        </div>

                        <!-- ปุ่มดูสลิปเดิมที่ลูกค้าโอนเข้ามา -->
                        <div class="mt-2 text-end" id="originalSlipBtnContainer">
                            <button type="button" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill" id="btnViewOriginalSlip">
                                <i class="bi bi-image me-1"></i> ดูสลิปเดิมที่ลูกค้าเคยโอนชำระ
                            </button>
                        </div>
                    </div>

                    <!-- Checklist ตรวจสอบเงื่อนไขตามนโยบาย -->
                    <div class="card border rounded-3 p-3 mb-3" style="background-color: #f8fafc;">
                        <h6 class="fw-bold text-dark small mb-2 d-flex align-items-center gap-1">
                            <i class="bi bi-check2-square text-success"></i> ตรวจสอบเงื่อนไขการคืนเงิน (Checklist):
                        </h6>
                        <div class="list-group list-group-flush small bg-transparent">
                            <label class="list-group-item d-flex gap-2 bg-transparent border-0 px-0 py-1 cursor-pointer">
                                <input class="form-check-input flex-shrink-0" type="checkbox" id="chkTime" checked>
                                <span>1. ขอยกเลิกภายในระยะเวลาที่กำหนด (ก่อนเริ่มใช้งาน หรือเริ่มใช้ไม่เกิน 1 ชั่วโมง)</span>
                            </label>
                            <label class="list-group-item d-flex gap-2 bg-transparent border-0 px-0 py-1 cursor-pointer">
                                <input class="form-check-input flex-shrink-0" type="checkbox" id="chkReason" checked>
                                <span>2. สาเหตุตรงตามเกณฑ์ (เครื่องมีปัญหาจอฟ้า, ฮาร์ดแวร์ขัดข้อง, หรือระบบใช้งานไม่ได้จริง)</span>
                            </label>
                            <label class="list-group-item d-flex gap-2 bg-transparent border-0 px-0 py-1 cursor-pointer">
                                <input class="form-check-input flex-shrink-0" type="checkbox" id="chkAmount" checked>
                                <span>3. ยอดเงินขอคืนตรงกับประวัติการชำระเงินจริงในระบบ</span>
                            </label>
                        </div>
                    </div>

                    <!-- หมายเหตุ / เหตุผลการพิจารณาของฝ่ายบัญชี -->
                    <div class="mb-3">
                        <label for="modalDecisionNote" class="form-label small fw-bold text-dark">
                            ผลการพิจารณา / หมายเหตุของฝ่ายบัญชี:
                        </label>
                        <!-- Quick Reason Pills -->
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <button type="button" class="btn btn-xs btn-outline-success py-1 px-2 rounded-pill quick-note-btn" 
                                    data-note="ตรวจสอบเงื่อนไขตรงตามนโยบาย: เครื่องขัดข้องจริง อนุมัติคืนเงินเต็มจำนวน">
                                + เครื่องขัดข้องจริง (อนุมัติ)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-success py-1 px-2 rounded-pill quick-note-btn" 
                                    data-note="ตรวจสอบเงื่อนไขตรงตามนโยบาย: แจ้งยกเลิกก่อนเริ่มใช้งาน อนุมัติคืนเงิน">
                                + แจ้งก่อนเริ่มใช้ (อนุมัติ)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-danger py-1 px-2 rounded-pill quick-note-btn" 
                                    data-note="ไม่เข้าเงื่อนไข: ลูกค้าเข้าใช้งานเกิน 3 ชั่วโมงและระบบทำงานปกติ ปฏิเสธคำขอ">
                                - ใช้งานเกินเวลา (ปฏิเสธ)
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-danger py-1 px-2 rounded-pill quick-note-btn" 
                                    data-note="ไม่เข้าเงื่อนไข: ตรวจสอบพบปัญหาเกิดจากสัญญาณอินเทอร์เน็ตของลูกค้า ปฏิเสธคำขอ">
                                - ปัญหาเน็ตลูกค้า (ปฏิเสธ)
                            </button>
                        </div>
                        <textarea id="modalDecisionNote" name="note" class="form-control small" rows="2" 
                                  placeholder="พิมพ์หมายเหตุผลการตรวจสอบเงื่อนไข เช่น ตรวจสอบเงื่อนไขตรงตามนโยบาย อนุมัติคืนเงินเข้าบัญชีลูกค้า"></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light d-flex justify-content-between">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                    <div class="d-flex gap-2">
                        <!-- ปุ่มปฏิเสธคำขอ -->
                        <button type="submit" 
                                formaction="@Url.Action("RejectRefund", "Accountant")" 
                                class="btn btn-outline-danger rounded-3 px-3 fw-semibold">
                            <i class="bi bi-x-circle me-1"></i> ปฏิเสธคำขอ
                        </button>
                        <!-- ปุ่มอนุมัติคืนเงิน -->
                        <button type="submit" 
                                formaction="@Url.Action("ApproveRefund", "Accountant")" 
                                class="btn btn-success rounded-3 px-4 fw-semibold shadow-xs">
                            <i class="bi bi-check-circle me-1"></i> อนุมัติคืนเงิน
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: ดูผลการพิจารณา (สำหรับรายการที่ตัดสินใจแล้ว) -->
<div class="modal fade" id="decisionViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <div>
                    <h6 class="modal-title fw-bold text-dark mb-0" id="viewDecisionTitle">ผลการพิจารณาคำขอคืนเงิน</h6>
                    <small class="text-muted" id="viewDecisionDate"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <div class="fw-bold fs-5" id="viewDecisionStatus">-</div>
                </div>

                <div class="card bg-light border-0 p-3 rounded-3 mb-3 small">
                    <div class="text-muted mb-1">เหตุผลที่ลูกค้ายื่นมา:</div>
                    <div class="fw-semibold text-dark" id="viewDecisionCustomerReason">-</div>
                </div>

                <div class="card border p-3 rounded-3 small">
                    <div class="text-muted mb-1"><i class="bi bi-clipboard-data text-primary me-1"></i> ผลการตรวจสอบและหมายเหตุฝ่ายบัญชี:</div>
                    <div class="fw-bold text-dark" id="viewDecisionNote">-</div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-3 px-3" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: ดูสลิปเดิมของลูกค้า -->
<div class="modal fade" id="originalSlipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold">สลิปการโอนเงินเดิมของลูกค้า</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-3 bg-dark bg-opacity-10">
                <img id="originalSlipImg" src="" alt="Customer Original Slip" class="img-fluid rounded shadow-sm" style="max-height: 500px;" />
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-3 px-3" data-bs-dismiss="modal">ปิด</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Modal ตรวจสอบและพิจารณาคืนเงิน
        const reviewModalEl = document.getElementById("reviewRefundModal");
        let reviewModal = null;
        if (reviewModalEl && typeof bootstrap !== "undefined") {
            reviewModal = new bootstrap.Modal(reviewModalEl);
        }

        // 2. Modal ดูสลิปเดิม
        const originalSlipModalEl = document.getElementById("originalSlipModal");
        let originalSlipModal = null;
        if (originalSlipModalEl && typeof bootstrap !== "undefined") {
            originalSlipModal = new bootstrap.Modal(originalSlipModalEl);
        }

        let currentOriginalSlip = "";

        document.querySelectorAll(".btn-review-refund").forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const code = this.getAttribute("data-code");
                const user = this.getAttribute("data-user");
                const email = this.getAttribute("data-email");
                const machine = this.getAttribute("data-machine");
                const amount = this.getAttribute("data-amount");
                const date = this.getAttribute("data-date");
                const reason = this.getAttribute("data-reason");
                currentOriginalSlip = this.getAttribute("data-original-slip") || "";

                document.getElementById("modalBookingId").value = id;
                document.getElementById("modalReviewSubtitle").innerText = "รหัสรายการ: " + code;
                document.getElementById("modalReviewCode").innerText = code;
                document.getElementById("modalReviewUser").innerText = user;
                document.getElementById("modalReviewEmail").innerText = "(" + email + ")";
                document.getElementById("modalReviewMachine").innerText = machine;
                document.getElementById("modalReviewDate").innerText = date;
                document.getElementById("modalReviewAmount").innerText = amount + " ฿";
                document.getElementById("modalReviewReason").innerText = reason;
                document.getElementById("modalDecisionNote").value = "ตรวจสอบเงื่อนไขตรงตามนโยบาย: เครื่องขัดข้องจริง อนุมัติคืนเงินเต็มจำนวน";

                // จัดการปุ่มดูสลิปเดิม
                const slipContainer = document.getElementById("originalSlipBtnContainer");
                if (currentOriginalSlip && currentOriginalSlip.trim() !== "") {
                    slipContainer.style.display = "block";
                } else {
                    slipContainer.style.display = "none";
                }

                if (reviewModal) reviewModal.show();
            });
        });

        // คลิกดูสลิปเดิม
        const btnViewSlip = document.getElementById("btnViewOriginalSlip");
        if (btnViewSlip) {
            btnViewSlip.addEventListener("click", function () {
                if (currentOriginalSlip) {
                    document.getElementById("originalSlipImg").src = currentOriginalSlip;
                    if (originalSlipModal) originalSlipModal.show();
                }
            });
        }

        // Quick Note Pills
        document.querySelectorAll(".quick-note-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const note = this.getAttribute("data-note");
                document.getElementById("modalDecisionNote").value = note;
            });
        });

        // 3. Modal ดูผลการพิจารณา
        const decisionModalEl = document.getElementById("decisionViewModal");
        let decisionModal = null;
        if (decisionModalEl && typeof bootstrap !== "undefined") {
            decisionModal = new bootstrap.Modal(decisionModalEl);
        }

        document.querySelectorAll(".btn-view-decision").forEach(btn => {
            btn.addEventListener("click", function () {
                const code = this.getAttribute("data-code");
                const status = this.getAttribute("data-status");
                const statusClass = this.getAttribute("data-status-class");
                const date = this.getAttribute("data-date");
                const reason = this.getAttribute("data-reason");
                const note = this.getAttribute("data-note");

                document.getElementById("viewDecisionTitle").innerText = "ผลการพิจารณา " + code;
                document.getElementById("viewDecisionDate").innerText = "วันที่พิจารณา: " + date;
                
                const statusEl = document.getElementById("viewDecisionStatus");
                statusEl.innerText = status;
                statusEl.className = "fw-bold fs-5 " + statusClass;

                document.getElementById("viewDecisionCustomerReason").innerText = reason;
                document.getElementById("viewDecisionNote").innerText = note;

                if (decisionModal) decisionModal.show();
            });
        });
    });
</script>
}
