@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "ธนพล ดีสมเกียรติ";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - แดชบอร์ดลูกค้า CloudPC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="layout-with-sidebar">
        <!-- Customer Sidebar (Wireframe Page 7 & 8) -->
        <aside class="sidebar-panel">
            <div class="mb-4 ps-2">
                <a asp-action="Index" class="navbar-brand-logo text-decoration-none">
                    <span class="bg-primary text-white p-1 px-2 rounded-2"><i class="bi bi-cpu-fill"></i></span>
                    <span class="fw-bold text-dark">CloudPC</span>
                </a>
            </div>

            <div class="heading">เมนูหลัก</div>
            <nav class="nav flex-column mb-auto">
                <a asp-action="Index" class="nav-item-link">
                    <i class="bi bi-house-door-fill"></i>
                    <span>หน้าแรก</span>
                </a>
                <a asp-action="Machines" class="nav-item-link">
                    <i class="bi bi-pc-display"></i>
                    <span>เช่าเครื่องใหม่</span>
                </a>
                <a asp-action="MyBookings" class="nav-item-link @(currentAction == "MyBookings" ? "active" : "")">
                    <i class="bi bi-calendar-check-fill"></i>
                    <span>ประวัติการจองของฉัน</span>
                </a>
                <a asp-action="Membership" class="nav-item-link @(currentAction == "Membership" ? "active" : "")">
                    <i class="bi bi-award-fill"></i>
                    <span>ระบบสมาชิกและคะแนนสะสม</span>
                </a>
                <a asp-action="Wallet" class="nav-item-link @(currentAction == "Wallet" ? "active" : "")">
                    <i class="bi bi-wallet2"></i>
                    <span>กระเป๋าเงินของฉัน</span>
                </a>
                <a asp-action="AccountSettings" class="nav-item-link @(currentAction == "AccountSettings" ? "active" : "")">
                    <i class="bi bi-gear-fill"></i>
                    <span>ตั้งค่าบัญชี</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content Panel -->
        <main class="main-content-panel">
            <!-- Top bar in dashboard (Interactive Notification Bell & Real-time Wallet) -->
            @{
                var customerUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId") ?? 0;
                var realTimeBalance = customerUserId > 0 ? CloudPCRental.Models.MockDataStore.GetUserBalance(customerUserId) : 0m;
                var customerMembership = customerUserId > 0 ? CloudPCRental.Models.MockDataStore.GetUserMembershipInfo(customerUserId, username) : null;
                var customerMemberCode = customerMembership?.MemberNumber ?? (customerUserId > 0 ? $"CPC-{customerUserId * 15498 % 90000 + 10000}" : "CPC-77491");
            }
            <div class="d-flex justify-content-end align-items-center mb-4 gap-3">
                <div class="bg-white px-3 py-1 rounded-pill border small fw-semibold text-secondary shadow-xs d-flex align-items-center gap-2" title="เวลาปัจจุบันของระบบ">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span class="text-dark fw-bold font-monospace realtime-live-clock" id="customerLiveClock">--:--:--</span>
                </div>

                <a asp-action="Wallet" class="bg-white px-3 py-1 rounded-pill border small fw-semibold text-secondary text-decoration-none shadow-xs d-flex align-items-center gap-1 hover-shadow" title="คลิกเพื่อดูกระเป๋าเงินและเติมเงิน">
                    <i class="bi bi-wallet2 text-primary"></i>
                    <span>ยอดเงินคงเหลือ:</span>
                    <span class="text-dark fw-bold" id="customerNavBalance">@realTimeBalance.ToString("N0") THB</span>
                </a>

                <div class="vr my-1 text-secondary opacity-25"></div>

                <!-- กล่องแจ้งเตือน (Notification Dropdown) -->
                <div class="dropdown" id="customerNotificationDropdown">
                    <button class="btn btn-white bg-white border rounded-circle p-0 position-relative text-secondary shadow-xs d-flex align-items-center justify-content-center" 
                            type="button" 
                            id="customerNotificationBtn" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false" 
                            title="การแจ้งเตือน"
                            onclick="markCustomerNotificationsAsRead()"
                            style="width: 38px; height: 38px;">
                        <i class="bi bi-bell fs-5 text-dark"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" 
                              id="customerNotifyBadge" 
                              style="font-size: 0.65rem; padding: 0.25em 0.5em;">
                            3
                            <span class="visually-hidden">รายการใหม่</span>
                        </span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 rounded-3 mt-2" 
                         aria-labelledby="customerNotificationBtn" 
                         style="width: 350px; max-width: 92vw; z-index: 1055;">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-bell-fill text-primary"></i>
                                <span>การแจ้งเตือน</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" 
                                      id="customerNotifyHeaderBadge" 
                                      style="font-size: 0.7rem;">3 ใหม่</span>
                            </div>
                            <button type="button" class="btn btn-link text-decoration-none p-0 text-primary small fw-semibold" 
                                    id="customerMarkAllReadBtn" 
                                    onclick="markCustomerNotificationsAsRead(event)"
                                    style="font-size: 0.75rem;">
                                อ่านทั้งหมด
                            </button>
                        </div>

                        <div class="list-group list-group-flush small" id="customerNotifyList" style="max-height: 380px; overflow-y: auto;">
                            <!-- แจ้งเตือน 1: จองเครื่องสำเร็จ -->
                            <a asp-action="MyBookings" class="list-group-item list-group-item-action p-3 d-flex gap-3 align-items-start unread-item" style="background-color: #f8fafc;">
                                <div class="p-2 rounded-circle text-primary bg-primary-subtle flex-shrink-0 mt-1">
                                    <i class="bi bi-check2-circle fs-6"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark mb-1">การจองเครื่องสำเร็จแล้ว</div>
                                    <div class="text-secondary small mb-1" style="line-height: 1.4;">เครื่อง Extreme Gaming PC (#CPC-94812) พร้อมให้คุณเชื่อมต่อใช้งานได้ทันที</div>
                                    <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>10 นาทีที่แล้ว</div>
                                </div>
                                <span class="p-1 bg-primary rounded-circle mt-2 flex-shrink-0 notify-dot"></span>
                            </a>

                            <!-- แจ้งเตือน 2: วอลเล็ตเติมเงิน -->
                            <a asp-action="Wallet" class="list-group-item list-group-item-action p-3 d-flex gap-3 align-items-start unread-item" style="background-color: #f8fafc;">
                                <div class="p-2 rounded-circle text-success bg-success-subtle flex-shrink-0 mt-1">
                                    <i class="bi bi-wallet2 fs-6"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark mb-1">เติมเงินเข้าวอลเล็ตสำเร็จ</div>
                                    <div class="text-secondary small mb-1" style="line-height: 1.4;">เติมเงินเข้ากระเป๋า +500.00 THB ยอดคงเหลือปัจจุบัน 540.00 THB</div>
                                    <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>1 ชั่วโมงที่แล้ว</div>
                                </div>
                                <span class="p-1 bg-primary rounded-circle mt-2 flex-shrink-0 notify-dot"></span>
                            </a>

                            <!-- แจ้งเตือน 3: เตือนเวลาใกล้หมด -->
                            <a asp-action="MyBookings" class="list-group-item list-group-item-action p-3 d-flex gap-3 align-items-start unread-item" style="background-color: #f8fafc;">
                                <div class="p-2 rounded-circle text-warning bg-warning-subtle flex-shrink-0 mt-1">
                                    <i class="bi bi-hourglass-split fs-6"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark mb-1">แจ้งเตือนเวลาการใช้งาน</div>
                                    <div class="text-secondary small mb-1" style="line-height: 1.4;">เครื่อง PC-002 จะหมดเวลาเช่าในอีก 15 นาที คุณสามารถกดต่อเวลาได้</div>
                                    <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>3 ชั่วโมงที่แล้ว</div>
                                </div>
                                <span class="p-1 bg-primary rounded-circle mt-2 flex-shrink-0 notify-dot"></span>
                            </a>

                            <!-- แจ้งเตือน 4: สมาชิกพิเศษ -->
                            <a asp-action="Membership" class="list-group-item list-group-item-action p-3 d-flex gap-3 align-items-start">
                                <div class="p-2 rounded-circle text-info bg-info-subtle flex-shrink-0 mt-1">
                                    <i class="bi bi-award-fill fs-6"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark mb-1">สิทธิประโยชน์สมาชิก Platinum</div>
                                    <div class="text-secondary small mb-1" style="line-height: 1.4;">คุณได้รับสิทธิ์ส่วนลด 10% ทุกการจองตลอดเดือนนี้</div>
                                    <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-clock me-1"></i>เมื่อวานนี้</div>
                                </div>
                            </a>
                        </div>

                        <div class="p-2 text-center border-top bg-light rounded-bottom-3">
                            <a asp-action="MyBookings" class="text-primary text-decoration-none small fw-semibold">
                                ดูประวัติและการจองทั้งหมด <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="vr my-1 text-secondary opacity-25"></div>

                <!-- User Profile & Direct Logout on Top-Right (ขวาสุด) -->
                <div class="dropdown">
                    <button class="btn btn-white bg-white border rounded-pill px-3 py-1 d-flex align-items-center gap-2 shadow-xs dropdown-toggle text-nowrap fw-semibold text-dark" type="button" id="customerTopUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="text-start d-none d-sm-block">
                            <div class="small fw-bold text-dark lh-1">@username</div>
                            <div class="text-muted" style="font-size: 0.68rem;">ID: @customerMemberCode</div>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2 p-2" aria-labelledby="customerTopUserDropdown" style="min-width: 220px; z-index: 1060;">
                        <li class="px-3 py-2 border-bottom mb-1 bg-light rounded-2">
                            <div class="fw-bold text-dark">@username</div>
                            <div class="text-muted small" style="font-size: 0.75rem;">รหัสสมาชิก: ID: @customerMemberCode</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2 text-dark small" asp-action="AccountSettings">
                                <i class="bi bi-gear text-secondary"></i> ตั้งค่าบัญชี
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2 text-dark small" asp-action="Wallet">
                                <i class="bi bi-wallet2 text-success"></i> กระเป๋าเงินของฉัน
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2 text-dark small" asp-action="MyBookings">
                                <i class="bi bi-calendar-check text-primary"></i> ประวัติการจองของฉัน
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item py-2 rounded-2 d-flex align-items-center gap-2 text-danger small fw-semibold" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right text-danger"></i> ออกจากระบบ
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.markCustomerNotificationsAsRead = function(e) {
            if (e && e.stopPropagation) {
                e.stopPropagation();
            }
            try {
                localStorage.setItem('cloudpc_customer_notifications_read', 'true');
            } catch (err) { }

            var badge = document.getElementById("customerNotifyBadge");
            if (badge) badge.style.display = "none";

            var headerBadge = document.getElementById("customerNotifyHeaderBadge");
            if (headerBadge) {
                headerBadge.innerText = "0 ใหม่";
                headerBadge.className = "badge bg-secondary-subtle text-secondary border rounded-pill";
            }

            var unreadItems = document.querySelectorAll("#customerNotifyList .unread-item");
            unreadItems.forEach(function(item) {
                item.style.backgroundColor = "#ffffff";
            });

            var notifyDots = document.querySelectorAll("#customerNotifyList .notify-dot");
            notifyDots.forEach(function(dot) {
                dot.style.display = "none";
            });
        };

        document.addEventListener("DOMContentLoaded", function () {
            if (localStorage.getItem('cloudpc_customer_notifications_read') === 'true') {
                window.markCustomerNotificationsAsRead();
            }

            var notifWrapper = document.getElementById("customerNotificationDropdown");
            if (notifWrapper) {
                notifWrapper.addEventListener("show.bs.dropdown", function () {
                    window.markCustomerNotificationsAsRead();
                });
            }
        });
    </script>
    <partial name="_LiveChatWidget" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

