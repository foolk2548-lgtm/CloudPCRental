@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "รายงานรายรับ";
    var dailyRevenue = ViewBag.DailyRevenue as System.Collections.IEnumerable;
    var topMachines  = ViewBag.TopMachines  as System.Collections.IEnumerable;
    var recent       = ViewBag.RecentApproved as List<CloudPCRental.Models.Booking> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="text-muted small">สรุปรายรับและประสิทธิภาพการเช่าเครื่อง</div>
        <h3 class="fw-bold text-dark mb-0">รายงานรายรับ</h3>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-cloudpc bg-white p-4 text-center">
            <div class="text-muted small mb-1">รายรับรวมทั้งหมด</div>
            <div class="fs-1 fw-bold text-success">฿@((((decimal)(ViewBag.TotalRevenue ?? 0m)).ToString("N2")))</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-cloudpc bg-white p-4 text-center">
            <div class="text-muted small mb-1">จำนวนธุรกรรม</div>
            <div class="fs-1 fw-bold text-primary">@ViewBag.TotalTransactions</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-cloudpc bg-white p-4 text-center">
            <div class="text-muted small mb-1">รายรับเฉลี่ย/ครั้ง</div>
            <div class="fs-1 fw-bold text-info">฿@((((decimal)(ViewBag.AvgPerBooking ?? 0m)).ToString("N2")))</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- รายรับ 7 วัน -->
    <div class="col-md-6">
        <div class="card-cloudpc bg-white p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-fill text-primary me-1"></i>รายรับ 7 วันล่าสุด</h6>
            @if (dailyRevenue != null)
            {
                @foreach (var d in dailyRevenue)
                {
                    var dType = (dynamic)d;
                    decimal rev = (decimal)dType.Revenue;
                    decimal maxRev = 1000m; // สำหรับ bar width
                    var pct = Math.Min(rev / maxRev * 100, 100);
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">@dType.Date</span>
                            <span class="fw-semibold">฿@rev.ToString("N0")</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-success" style="width:@pct%"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Top เครื่อง -->
    <div class="col-md-6">
        <div class="card-cloudpc bg-white p-4">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-trophy-fill text-warning me-1"></i>เครื่องที่ทำรายได้สูงสุด</h6>
            @if (topMachines != null)
            {
                int rank = 1;
                @foreach (var t in topMachines)
                {
                    var tType = (dynamic)t;
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary" : "bg-light text-dark border")"
                                  style="width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center;">@rank</span>
                            <div>
                                <div class="fw-semibold" style="font-size:0.82rem;">@tType.Name</div>
                                <div class="text-muted" style="font-size:0.72rem;">@tType.Count ครั้ง</div>
                            </div>
                        </div>
                        <span class="fw-bold text-success">฿@((decimal)tType.Revenue).ToString("N0")</span>
                    </div>
                    rank++;
                }
            }
        </div>
    </div>
</div>

<!-- Recent Transactions -->
<div class="card-cloudpc bg-white p-4 mt-4">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-primary me-1"></i>ธุรกรรมล่าสุด 10 รายการ</h6>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-2">เลขที่</th>
                    <th>ลูกค้า</th>
                    <th>เครื่อง</th>
                    <th>วันที่</th>
                    <th class="text-end pe-2">ยอด (฿)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in recent)
                {
                    <tr>
                        <td class="ps-2 text-primary fw-semibold" style="font-size:0.82rem;">#CPC-@b.BookingId</td>
                        <td style="font-size:0.82rem;">@(b.User?.Username ?? $"User #{b.UserId}")</td>
                        <td style="font-size:0.82rem;">@(b.Machine?.MachineName ?? $"Machine #{b.MachineId}")</td>
                        <td style="font-size:0.8rem;" class="text-muted">@b.PaymentDate.ToString("dd/MM/yy HH:mm")</td>
                        <td class="text-end pe-2 fw-bold text-success" style="font-size:0.82rem;">@b.TotalAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
