@model IEnumerable<CloudPCRental.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการผู้ใช้งานและสิทธิ์ (เฉพาะผู้ดูแลระบบ)";
    var currentUserId = Context.Session.GetInt32("UserId");
    int totalUsers = Model?.Count() ?? 0;
    int managerCount = Model?.Count(u => u.Role == "Manager") ?? 0;
    int staffCount = Model?.Count(u => u.Role == "Staff") ?? 0;
    int accountantCount = Model?.Count(u => u.Role == "Accountant") ?? 0;
    int normalUserCount = Model?.Count(u => u.Role == "User") ?? 0;
}

<!-- Header (Wireframe Page 26) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-dark text-white px-2 py-1" style="font-size: 0.72rem;">
                <i class="bi bi-shield-lock-fill text-warning me-1"></i> สิทธิ์เฉพาะแอดมิน (Admin Only)
            </span>
            <span class="text-muted small">เพิ่ม แก้ไข และจัดการสิทธิ์ผู้ใช้งานระบบ</span>
        </div>
        <h3 class="fw-bold text-dark mb-0">จัดการผู้ใช้งานและสิทธิ์</h3>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
            <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
            <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary rounded-3 px-3 fw-semibold small shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> เพิ่มผู้ใช้งานใหม่
        </a>
    </div>
</div>

<!-- 4 Stats Cards (Wireframe Page 26) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">ผู้ใช้งานทั้งหมด</span>
                    <h3 class="fw-bold text-dark my-1">@totalUsers <small class="fs-6 text-muted">คน</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ลูกค้า @normalUserCount คน</div>
                </div>
                <div class="text-primary fs-3"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">ผู้จัดการ (Manager)</span>
                    <h3 class="fw-bold text-warning my-1">@managerCount <small class="fs-6 text-muted">คน</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">มีสิทธิ์จัดการสาขา</div>
                </div>
                <div class="text-warning fs-3"><i class="bi bi-shield-shaded"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">พนักงาน (Staff)</span>
                    <h3 class="fw-bold text-success my-1">@staffCount <small class="fs-6 text-muted">คน</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ผู้ดูแลหน้าร้าน</div>
                </div>
                <div class="text-success fs-3"><i class="bi bi-person-workspace"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">บัญชี (Accountant)</span>
                    <h3 class="fw-bold text-info my-1">@accountantCount <small class="fs-6 text-muted">คน</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ฝ่ายการเงินและรายงาน</div>
                </div>
                <div class="text-info fs-3"><i class="bi bi-currency-dollar"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card (Wireframe Page 26) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="input-group" style="max-width: 280px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="userSearchInput" class="form-control form-control-sm border-start-0" 
                   placeholder="ค้นหาชื่อผู้ใช้ หรืออีเมล..." oninput="filterUserTable()" />
        </div>
        <select id="userRoleFilter" class="form-select form-select-sm" style="width: 170px;" onchange="filterUserTable()">
            <option value="all" selected>ตำแหน่งทั้งหมด</option>
            <option value="Admin">ผู้ดูแลระบบ (Admin)</option>
            <option value="Manager">ผู้จัดการ (Manager)</option>
            <option value="Staff">พนักงาน (Staff)</option>
            <option value="Accountant">บัญชี (Accountant)</option>
            <option value="User">สมาชิกทั่วไป (User)</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small" id="userTable">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">ลำดับ</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>อีเมล</th>
                    <th>ตำแหน่ง</th>
                    <th>สถานะ</th>
                    <th>วันที่เพิ่ม</th>
                    <th class="text-end pe-3">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    @foreach (var u in Model)
                    {
                        <tr class="user-row" data-role="@u.Role" data-search="@u.Username.ToLower() @u.Email.ToLower()">
                            <td class="ps-3 text-muted">@index</td>
                            <td class="fw-semibold text-dark">
                                @u.Username
                                @if (u.UserId == currentUserId)
                                {
                                    <span class="badge bg-secondary ms-1" style="font-size: 0.65rem;">(คุณ)</span>
                                }
                            </td>
                            <td class="text-muted">@u.Email</td>
                            <td>
                                @if (u.Role == "Admin")
                                {
                                    <span class="badge" style="background-color: #1e293b; color: #ffffff; padding: 5px 10px;">
                                        <i class="bi bi-shield-lock-fill text-warning me-1"></i> ผู้ดูแลระบบ
                                    </span>
                                }
                                else if (u.Role == "Manager")
                                {
                                    <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; padding: 5px 10px;">
                                        <i class="bi bi-shield-shaded me-1"></i> ผู้จัดการ
                                    </span>
                                }
                                else if (u.Role == "Staff")
                                {
                                    <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0; padding: 5px 10px;">
                                        <i class="bi bi-person-workspace me-1"></i> พนักงาน
                                    </span>
                                }
                                else if (u.Role == "Accountant")
                                {
                                    <span class="badge" style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; padding: 5px 10px;">
                                        <i class="bi bi-cash-coin me-1"></i> บัญชี
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 5px 10px;">
                                        <i class="bi bi-person-fill me-1"></i> ลูกค้าทั่วไป
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.72rem;">เปิดใช้งาน</span>
                            </td>
                            <td class="text-muted">@DateTime.Today.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("th-TH"))</td>
                            <td class="text-end pe-3">
                                <a asp-action="EditUser" asp-route-id="@u.UserId" class="btn btn-outline-secondary btn-sm p-1 px-2 rounded-2 me-1" title="แก้ไขข้อมูลผู้ใช้">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                @if (u.UserId != currentUserId && u.Role != "Admin")
                                {
                                    <form asp-action="DeleteUser" method="post" class="d-inline" onsubmit="return confirm('คุณต้องการลบผู้ใช้งาน @u.Username ใช่หรือไม่?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.UserId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2 rounded-2" title="ลบผู้ใช้">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted p-1" title="ไม่สามารถลบบัญชีผู้ดูแลระบบหลักหรือบัญชีของตนเองได้"><i class="bi bi-lock-fill"></i></span>
                                }
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>

        <!-- No matching users message -->
        <div id="noUsersMatch" class="text-center py-4 text-muted d-none">
            <i class="bi bi-search fs-3 d-block mb-1 text-secondary"></i>
            ไม่พบผู้ใช้งานที่ตรงกับเงื่อนไขการค้นหา
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top small text-muted">
        <span id="userCountSummary">แสดงผู้ใช้งานทั้งหมด @totalUsers คน</span>
        <span class="text-success"><i class="bi bi-shield-check me-1"></i> ข้อมูลผู้ใช้งานเปิดใช้งานปกติ</span>
    </div>
</div>

@section Scripts {
<script>
    function filterUserTable() {
        var query = document.getElementById("userSearchInput").value.toLowerCase().trim();
        var selectedRole = document.getElementById("userRoleFilter").value;
        var rows = document.querySelectorAll("#userTable tbody tr.user-row");
        var matched = 0;

        rows.forEach(function(row) {
            var searchData = row.getAttribute("data-search") || "";
            var roleData = row.getAttribute("data-role") || "";

            var matchSearch = !query || searchData.includes(query);
            var matchRole = selectedRole === "all" || roleData === selectedRole;

            if (matchSearch && matchRole) {
                row.classList.remove("d-none");
                matched++;
            } else {
                row.classList.add("d-none");
            }
        });

        var noMsg = document.getElementById("noUsersMatch");
        if (noMsg) {
            if (matched === 0) noMsg.classList.remove("d-none");
            else noMsg.classList.add("d-none");
        }

        var summary = document.getElementById("userCountSummary");
        if (summary) {
            summary.innerText = "แสดง " + matched + " จากทั้งหมด " + rows.length + " คน";
        }
    }
</script>
}