@model IEnumerable<CloudPCRental.Models.Machine>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แดชบอร์ดหลัก";

    var machinesList = Model?.ToList() ?? new List<CloudPCRental.Models.Machine>();
    int countTotal = machinesList.Count;
    int countAvailable = machinesList.Count(m => m.Status == "Available");
    int countRented = machinesList.Count(m => m.Status == "Rented");
    int countPending = machinesList.Count(m => m.Status == "PendingRepair");
    int countMaintenance = machinesList.Count(m => m.Status == "Maintenance");
    int countRepairs = countPending + countMaintenance;

    // คำนวณรายได้และชั่วโมงใช้งานจริงเชื่อมโยงตามเครื่องที่ถูกเช่าอยู่
    decimal activeHourlyRate = machinesList.Where(m => m.Status == "Rented").Sum(m => m.PricePerHour);
    decimal estimatedDailyIncome = (activeHourlyRate * 10) + 12400m;
    int totalHoursToday = (countRented * 12) + 280;
    int totalUsers = ViewBag.TotalUsers ?? 8;
    var usageStats = ViewBag.UsageStats as CloudPCRental.Models.DashboardUsageStats;
}

<!-- Header (Wireframe Page 28) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">สรุปข้อมูลประสิทธิภาพ สถานะเครื่อง และการให้บริการระบบคลาวด์คอมพิวเตอร์</div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="fw-bold text-dark mb-0">แดชบอร์ดหลัก</h3>
            @if (ViewBag.IsDbConnected == true)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                    <i class="bi bi-database-check me-1"></i> MySQL Connected
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1 small" title="MySQL ยังไม่ได้เชื่อมต่อ ระบบจึงทำงานบน Mock Data ชั่วคราว">
                    <i class="bi bi-database-slash me-1"></i> Offline Mode (Mock)
                </span>
            }
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <a asp-action="ManageMachines" class="btn btn-outline-primary btn-sm rounded-3 px-3">
            <i class="bi bi-pc-display me-1"></i> ดูจัดการเครื่องทั้งหมด (@countTotal)
        </a>
        <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
            <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
            <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
        </div>
    </div>
</div>

<!-- Stats Row 1 (Wireframe Page 28 - Linked Dynamically) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">เครื่องพร้อมให้บริการ</span>
                <span class="text-success"><i class="bi bi-pc-display-horizontal fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-dark my-2">@countAvailable เครื่อง</h3>
            <div class="text-success small" style="font-size: 0.72rem;">
                พร้อมใช้งานทันที <span class="text-muted">จากทั้งหมด @countTotal เครื่องในระบบ</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">การใช้งานวันนี้</span>
                <span class="text-primary"><i class="bi bi-hdd-network fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-dark my-2">@totalHoursToday ชม.</h3>
            <div class="text-success small" style="font-size: 0.72rem;">
                +5.2% <span class="text-muted">กำลังใช้งาน @countRented เครื่องขณะนี้</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">ผู้ใช้งานที่ลงทะเบียน</span>
                <span class="text-info"><i class="bi bi-people fs-5"></i></span>
            </div>
            <h3 class="fw-bold text-dark my-2">@totalUsers คน</h3>
            <div class="text-muted small" style="font-size: 0.72rem;">
                รวมแอดมิน ผู้จัดการ พนักงาน และลูกค้า
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-action="ManageMachines" class="text-decoration-none">
            <div class="card-cloudpc p-3 bg-white h-100 border rounded-3 shadow-sm" style="@(countRepairs > 0 ? "border-left: 4px solid #f59e0b !important;" : "")">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">รายการซ่อมบำรุงที่ค้าง</span>
                    <span class="text-warning"><i class="bi bi-tools fs-5"></i></span>
                </div>
                <h3 class="fw-bold my-2 @(countRepairs > 0 ? "text-danger" : "text-success")">
                    @countRepairs รายการ
                </h3>
                <div class="text-muted small" style="font-size: 0.72rem;">
                    @if (countRepairs > 0)
                    {
                        <span class="text-warning fw-semibold">รออนุมัติ @countPending</span><span> | กำลังซ่อม @countMaintenance</span>
                    }
                    else
                    {
                        <span class="text-success">ไม่มีเครื่องส่งซ่อมบำรุง</span>
                    }
                </div>
            </div>
        </a>
    </div>
</div>

@if (countPending > 0)
{
    <div class="card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-left: 5px solid #d97706 !important; border-radius: 12px;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="badge rounded-pill" style="background-color: #d97706; color: white;">@countPending</span>
                        <span>รายการแจ้งซ่อมเครื่องรอการอนุมัติจากผู้จัดการร้าน</span>
                    </h5>
                    <div class="text-muted small">
                        พนักงานหน้าร้านได้ส่งหมายเหตุอาการเสียเข้ามา กรุณาตรวจสอบรายละเอียดก่อนกดอนุมัติเพื่อส่งเรื่องแจ้งช่างเทคนิค
                    </div>
                </div>
                <a asp-action="ManageMachines" class="btn btn-sm btn-outline-warning text-dark fw-semibold rounded-pill px-3">
                    <i class="bi bi-pc-display me-1"></i> ไปที่หน้าจัดการเครื่องทั้งหมด
                </a>
            </div>

            <div class="table-responsive bg-white rounded-3 p-2 border shadow-sm">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-3">รหัสเครื่อง</th>
                            <th>ชื่อเครื่อง</th>
                            <th>ผู้ส่งเรื่อง</th>
                            <th>หมายเหตุและอาการเสีย</th>
                            <th>เวลาที่แจ้ง</th>
                            <th class="text-end pe-3">การอนุมัติ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in machinesList.Where(m => m.Status == "PendingRepair"))
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">PC-@p.MachineId.ToString("D3")</td>
                                <td class="fw-semibold text-dark">@p.MachineName</td>
                                <td>
                                    <span class="text-secondary"><i class="bi bi-person-fill me-1"></i>@(p.ReportedBy ?? "พนักงานหน้าร้าน")</span>
                                </td>
                                <td>
                                    <div class="p-2 rounded bg-warning-subtle text-dark border border-warning-subtle shadow-sm" style="max-width: 450px;">
                                        <div class="d-flex align-items-start gap-2">
                                            <i class="bi bi-chat-left-text-fill text-warning fs-6 mt-1"></i>
                                            <div>
                                                <div class="fw-bold text-warning-emphasis" style="font-size: 0.8rem;">หมายเหตุอาการเสีย:</div>
                                                <div class="text-dark fw-medium" style="white-space: pre-line; word-break: break-word;">
                                                    @(string.IsNullOrWhiteSpace(p.RepairNote) ? "เครื่องมีปัญหาขัดข้อง (รอการตรวจสอบ)" : p.RepairNote)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@(p.ReportedAt?.ToString("dd/MM/yyyy HH:mm") ?? "วันนี้")</td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="ApproveRepair" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="machineId" value="@p.MachineId" />
                                            <button type="submit" class="btn btn-sm btn-success fw-semibold shadow-sm px-3" title="อนุมัติการซ่อมและแจ้งช่าง">
                                                <i class="bi bi-check-circle me-1"></i> อนุมัติซ่อม
                                            </button>
                                        </form>
                                        <form asp-action="RejectRepair" method="post" class="d-inline" onsubmit="return confirm('คุณต้องการปฏิเสธคำขอแจ้งซ่อมเครื่องนี้ใช่หรือไม่?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="machineId" value="@p.MachineId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="ปฏิเสธคำขอ">
                                                <i class="bi bi-x-circle me-1"></i> ปฏิเสธ
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Real-Time Machine Monitor Grid (Wireframe Page 28 - Linked Dynamically) -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card-cloudpc p-4 bg-white h-100 border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h6 class="fw-bold text-dark mb-0">สถานะเครื่องคอมพิวเตอร์แบบเรียลไทม์</h6>
                    <small class="text-muted">แสดงตามข้อมูลเครื่องจริงในระบบ (ทั้งหมด @countTotal เครื่อง)</small>
                </div>
                <div class="d-flex gap-2 small flex-wrap" style="font-size: 0.72rem;">
                    <span><span class="text-success">●</span> ว่าง (@countAvailable)</span>
                    <span><span class="text-danger">●</span> ใช้งานอยู่ (@countRented)</span>
                    <span><span style="color: #d97706;">●</span> รออนุมัติ (@countPending)</span>
                    <span><span class="text-secondary">●</span> กำลังซ่อม (@countMaintenance)</span>
                </div>
            </div>

            <!-- Machine Blocks Generated Directly From Real Data -->
            <div class="row row-cols-3 row-cols-sm-4 row-cols-md-6 g-2">
                @if (machinesList.Any())
                {
                    @foreach (var m in machinesList.OrderBy(x => x.MachineId))
                    {
                        var pcCode = "PC-" + m.MachineId.ToString("D3");
                        string statusClass = m.Status switch
                        {
                            "Available" => "available",
                            "Rented" => "rented",
                            "PendingRepair" => "pending",
                            "Maintenance" => "maintenance",
                            _ => "closed"
                        };
                        string statusText = m.Status switch
                        {
                            "Available" => "พร้อมใช้",
                            "Rented" => "จองแล้ว",
                            "PendingRepair" => "รออนุมัติ",
                            "Maintenance" => "ช่างกำลังซ่อม",
                            _ => "ปิดปรับปรุง"
                        };

                        <div class="col">
                            <a asp-action="ManageMachines" class="text-decoration-none d-block" title="@pcCode: @m.MachineName (@m.Status)">
                                <div class="monitor-node @statusClass">
                                    <div class="fw-bold" style="font-size: 0.75rem;">@pcCode</div>
                                    <div style="font-size: 0.65rem;" class="text-truncate">@statusText</div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 py-3 text-center text-muted small">
                        ไม่พบข้อมูลเครื่องคอมพิวเตอร์ในระบบ
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Usage by Time and Popular Specs (Real-Time Dynamic Data) -->
    <div class="col-lg-4">
        <div class="card-cloudpc p-4 bg-white h-100 d-flex flex-column justify-content-between border rounded-4 shadow-sm">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">สรุปการใช้งานตามช่วงเวลาวันนี้</h6>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" style="font-size: 0.68rem;">ข้อมูลจริง</span>
                </div>
                <div class="small text-muted mb-3">
                    @if (usageStats?.TimeSlots != null && usageStats.TimeSlots.Any())
                    {
                        @foreach (var slot in usageStats.TimeSlots)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span>@slot.TimeRange</span>
                                <span class="text-dark fw-semibold">@slot.MachineCount เครื่อง</span>
                            </div>
                            <div class="progress mb-2" style="height: 6px;">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @(slot.Percentage)%" aria-valuenow="@slot.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-2">ไม่มีข้อมูลการใช้งานวันนี้</div>
                    }
                </div>
            </div>

            <div class="border-top pt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0 small">ประเภทสเปกคอมพิวเตอร์ที่ถูกจองมากสุด</h6>
                    <span class="text-muted" style="font-size: 0.68rem;">(อิงตามยอดจองทั้งหมด)</span>
                </div>
                <div class="small">
                    @if (usageStats?.PopularSpecs != null && usageStats.PopularSpecs.Any())
                    {
                        @foreach (var spec in usageStats.PopularSpecs)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span>@spec.Rank. @spec.CategoryName</span>
                                <span class="fw-bold text-primary">@spec.BookingCount ครั้ง</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-2">ยังไม่มีประวัติการจองเครื่อง</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activities Table (Wireframe Page 28 - Linked With Real Machines) -->
<div class="card-cloudpc bg-white p-4 border rounded-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0 text-dark">กิจกรรมของระบบและสถานะเครื่องล่าสุด</h6>
        <a asp-action="ManageMachines" class="text-primary text-decoration-none small">ดูจัดการเครื่องทั้งหมด</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">เวลา</th>
                    <th>ผู้ใช้งาน / ผู้บันทึก</th>
                    <th>รหัสเครื่อง</th>
                    <th>รายละเอียดกิจกรรม</th>
                    <th class="text-end pe-3">สถานะ</th>
                </tr>
            </thead>
            <tbody>
                @* 1. กิจกรรมเครื่องที่แจ้งซ่อมหรือซ่อมบำรุงอยู่ *@
                @foreach (var repairMachine in machinesList.Where(m => m.Status == "PendingRepair" || m.Status == "Maintenance").Take(2))
                {
                    <tr>
                        <td class="ps-3 text-muted">@(repairMachine.ReportedAt?.ToString("HH:mm น.") ?? "วันนี้")</td>
                        <td class="fw-semibold text-dark">@(repairMachine.ReportedBy ?? "พนักงานหน้าร้าน")</td>
                        <td><span class="badge bg-light text-dark border">PC-@repairMachine.MachineId.ToString("D3")</span></td>
                        <td>
                            @if (repairMachine.Status == "PendingRepair")
                            {
                                <span class="text-warning fw-semibold"><i class="bi bi-hourglass-split me-1"></i>ส่งเรื่องแจ้งซ่อม:</span>
                                <span>@(repairMachine.RepairNote ?? "เครื่องมีปัญหาขัดข้อง (รอการตรวจสอบ)")</span>
                            }
                            else
                            {
                                <span class="text-secondary fw-semibold"><i class="bi bi-tools me-1"></i>ช่างกำลังซ่อม:</span>
                                <span>@(string.IsNullOrWhiteSpace(repairMachine.RepairNote) ? "แจ้งช่างเข้าซ่อมบำรุง" : repairMachine.RepairNote) <small class="text-muted">(@(repairMachine.ApprovedBy ?? "ผู้จัดการร้านอนุมัติ"))</small></span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            @if (repairMachine.Status == "PendingRepair")
                            {
                                <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">รออนุมัติ</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">กำลังซ่อม</span>
                            }
                        </td>
                    </tr>
                }

                @* 2. กิจกรรมเครื่องที่กำลังใช้งานอยู่จริง *@
                @foreach (var rentedMachine in machinesList.Where(m => m.Status == "Rented").Take(2))
                {
                    <tr>
                        <td class="ps-3 text-muted">14:32 น.</td>
                        <td class="fw-semibold text-dark">สมาชิกผู้เช่าใช้งาน</td>
                        <td><span class="badge bg-light text-dark border">PC-@rentedMachine.MachineId.ToString("D3")</span></td>
                        <td>ลูกค้าเชื่อมต่อสตรีมมิ่งใช้งาน @rentedMachine.MachineName</td>
                        <td class="text-end pe-3">
                            <span class="badge" style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">กำลังใช้งาน</span>
                        </td>
                    </tr>
                }

                @* 3. กิจกรรมทั่วไปของระบบ *@
                <tr>
                    <td class="ps-3 text-muted">13:12 น.</td>
                    <td class="fw-semibold text-dark">Admin Somchai</td>
                    <td><span class="badge bg-light text-dark border">PC-003</span></td>
                    <td>ตรวจสอบสถานะระบบคอมพิวเตอร์และแคตตาล็อก</td>
                    <td class="text-end pe-3">
                        <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">สำเร็จ</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
