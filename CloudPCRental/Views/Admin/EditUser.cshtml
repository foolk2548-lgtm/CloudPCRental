@model CloudPCRental.Models.User
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แก้ไขข้อมูลผู้ใช้งาน";

    var currentUserId = Context.Session.GetInt32("UserId");
    var currentUsername = Context.Session.GetString("Username") ?? "";
    var currentRole = Context.Session.GetString("Role") ?? "";

    // ตรวจสอบว่าเป็นบัญชีของแอดมินที่กำลังล็อกอินอยู่หรือไม่
    bool isSelf = (currentUserId.HasValue && Model.UserId == currentUserId.Value) ||
                  (currentRole == "Admin" && Model.Role == "Admin" && (Model.UserId == 1 || Model.Username.Equals(currentUsername, StringComparison.OrdinalIgnoreCase)));
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-0">แก้ไขข้อมูลผู้ใช้งาน</h4>
                <small class="text-muted">รหัสผู้ใช้: #USR-@Model.UserId.ToString("D3")</small>
            </div>
            <a asp-action="ManageUsers" class="btn btn-outline-secondary rounded-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ
            </a>
        </div>

        @if (isSelf)
        {
            <div class="alert border-0 shadow-sm mb-4" style="background-color: #f8fafc; border-left: 4px solid #3b82f6 !important; border-radius: 10px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill text-primary fs-5"></i>
                    <div>
                        <strong class="text-dark">คุณกำลังแก้ไขบัญชีของตนเอง</strong>
                        <div class="small text-muted">ระบบล็อกสิทธิ์ผู้ดูแลระบบหลัก (Admin) ไว้เพื่อความปลอดภัย คุณสามารถแก้ไขชื่อ อีเมล และรหัสผ่านของตนเองได้ตามปกติ</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert border-0 shadow-sm mb-4" style="background-color: #f0fdf4; border-left: 4px solid #22c55e !important; border-radius: 10px;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-gear text-success fs-5"></i>
                    <div>
                        <strong class="text-dark">แก้ไขข้อมูลบัญชีบุคลากรในองค์กร</strong>
                        <div class="small text-muted">แอดมินสามารถเปลี่ยนบทบาท/สิทธิ์ (Role) และแก้ไขข้อมูลบัญชีให้กับบุคคลนี้ได้ตามต้องการ</div>
                    </div>
                </div>
            </div>
        }

        <div class="card-cloudpc p-4 p-md-5 bg-white">
            <form asp-action="EditUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="Username" class="form-label small fw-semibold text-secondary">ชื่อผู้ใช้ (Username)</label>
                    <input asp-for="Username" class="form-control" autofocus required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary">อีเมล (Email)</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary">รหัสผ่าน (Password)</label>
                    <input asp-for="Password" class="form-control" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-secondary">สิทธิ์การใช้งาน (Role)</label>
                    @if (isSelf || Model.Role == "Admin" || Model.UserId == 1 || Model.Username.Equals("admin", StringComparison.OrdinalIgnoreCase))
                    {
                        @* แอดมินหลัก: ล็อกสิทธิ์ไม่ให้เปลี่ยนเป็นบทบาทอื่น และไม่อนุญาตให้ลดสิทธิ์ *@
                        <input type="hidden" asp-for="Role" value="Admin" />
                        <div class="input-group">
                            <span class="input-group-text bg-light text-dark fw-bold border-end-0">
                                <i class="bi bi-shield-lock-fill text-warning me-2"></i> ผู้ดูแลระบบหลัก (Super Admin)
                            </span>
                            <span class="form-control bg-light text-muted small border-start-0 d-flex align-items-center justify-content-end">
                                <i class="bi bi-lock-fill text-secondary me-1"></i> ล็อกสิทธิ์ผู้ดูแลระบบหลัก (มีได้เพียง 1 บัญชี)
                            </span>
                        </div>
                        <div class="form-text small text-muted mt-1">
                            <i class="bi bi-info-circle me-1 text-primary"></i> ระบบอนุญาตให้มีผู้ดูแลระบบหลักได้เพียง 1 บัญชีเท่านั้น และไม่สามารถลดสิทธิ์ได้
                        </div>
                    }
                    else
                    {
                        @* บัญชีอื่น: สามารถปรับเปลี่ยนตำแหน่งได้ ยกเว้น Admin *@
                        <select asp-for="Role" class="form-select">
                            <option value="User">สมาชิกทั่วไป / ลูกค้า (User)</option>
                            <option value="Staff">พนักงานหน้าร้าน / พนักงานทั่วไป (Staff)</option>
                            <option value="Accountant">เจ้าหน้าที่บัญชีและการเงิน (Accountant)</option>
                            <option value="Manager">ผู้จัดการสาขา / แผนก (Manager)</option>
                        </select>
                        <div class="form-text small text-muted mt-1">
                            <i class="bi bi-check-circle me-1 text-success"></i> คุณสามารถปรับเปลี่ยนตำแหน่งของบุคลากรท่านนี้ได้ (ไม่อนุญาตให้เพิ่มสิทธิ์เป็น Admin)
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="ManageUsers" class="btn btn-light rounded-3 px-4">ยกเลิก</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                        บันทึกการแก้ไข
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
