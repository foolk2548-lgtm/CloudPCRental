@model IEnumerable<CloudPCRental.Models.Machine>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการข้อมูลคอมพิวเตอร์";

    var role = Context.Session.GetString("Role") ?? "Admin";
    var username = Context.Session.GetString("Username") ?? "เจ้าหน้าที่";
    bool isManagerOrAdmin = role == "Admin" || role == "Manager";
    bool isStaff = role == "Staff";

    int countTotal = Model?.Count() ?? 0;
    int countAvail = Model?.Count(m => m.Status == "Available") ?? 0;
    int countPending = Model?.Count(m => m.Status == "PendingRepair") ?? 0;
    int countMaint = Model?.Count(m => m.Status == "Maintenance") ?? 0;
    int countRented = Model?.Count(m => m.Status == "Rented") ?? 0;

    var pendingList = Model?.Where(m => m.Status == "PendingRepair").ToList() ?? new List<CloudPCRental.Models.Machine>();
}

<!-- Header (Wireframe Page 27) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="text-muted small">เพิ่มและจัดการข้อมูลเครื่องคอมพิวเตอร์ทั้งหมด</div>
        <h3 class="fw-bold text-dark mb-0">จัดการข้อมูลคอมพิวเตอร์</h3>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
            <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
            <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
        </div>
        <div class="text-muted small">
            เข้าใช้งานในบทบาท: <span class="badge bg-secondary">@role</span>
        </div>
        @if (isManagerOrAdmin)
        {
            <a asp-action="CreateMachine" class="btn btn-primary rounded-3 px-3 fw-semibold small shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> เพิ่มเครื่องใหม่
            </a>
        }
    </div>
</div>

<!-- 4 Stats Cards (Wireframe Page 27) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">เครื่องทั้งหมด</span>
                    <h3 class="fw-bold text-dark my-1">@countTotal <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">ลงทะเบียนในระบบ</div>
                </div>
                <div class="text-primary fs-3"><i class="bi bi-pc-display"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">พร้อมใช้งาน</span>
                    <h3 class="fw-bold text-success my-1">@countAvail <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">เปิดให้บริการปกติ</div>
                </div>
                <div class="text-success fs-3"><i class="bi bi-check-circle"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100" style="@(countPending > 0 ? "border: 2px solid #f59e0b;" : "")">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">รออนุมัติซ่อม</span>
                    <h3 class="fw-bold my-1" style="color: #d97706;">@countPending <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">
                        @(isManagerOrAdmin ? "รอผู้จัดการตรวจสอบ" : "ส่งเรื่องแล้ว")
                    </div>
                </div>
                <div class="fs-3" style="color: #d97706;"><i class="bi bi-hourglass-split"></i></div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card-cloudpc p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">กำลังซ่อมบำรุง</span>
                    <h3 class="fw-bold text-secondary my-1">@countMaint <small class="fs-6 text-muted">เครื่อง</small></h3>
                    <div class="text-muted small" style="font-size: 0.72rem;">แจ้งช่างเข้าดำเนินการ</div>
                </div>
                <div class="text-secondary fs-3"><i class="bi bi-tools"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- =============================================================== -->
<!-- ส่วนแจ้งเตือน & อนุมัติการแจ้งซ่อม (Approval Workflow Section) -->
<!-- =============================================================== -->
@if (pendingList.Any())
{
    @if (isManagerOrAdmin)
    {
        <div class="card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); border-left: 5px solid #d97706 !important; border-radius: 12px;">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                            <span class="badge rounded-pill" style="background-color: #d97706; color: white;">@pendingList.Count</span>
                            <span>รายการแจ้งซ่อมเครื่องรอการอนุมัติจากผู้จัดการ</span>
                        </h5>
                        <div class="text-muted small">
                            พนักงานหน้าร้านได้ส่งหมายเหตุอาการเสียเข้ามา กรุณาตรวจสอบรายละเอียดก่อนกดอนุมัติเพื่อส่งเรื่องแจ้งช่างเทคนิค
                        </div>
                    </div>
                    <span class="badge" style="background-color: #fde68a; color: #92400e; border: 1px solid #f59e0b;">
                        <i class="bi bi-shield-check me-1"></i> อำนาจการอนุมัติ: ผู้จัดการ / แอดมิน
                    </span>
                </div>

                <div class="table-responsive bg-white rounded-3 p-2 shadow-sm border">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-muted">
                            <tr>
                                <th class="ps-3">รหัสเครื่อง</th>
                                <th>ชื่อเครื่อง</th>
                                <th>ผู้แจ้งเรื่อง</th>
                                <th>หมายเหตุ / อาการเสียที่พบ</th>
                                <th>เวลาที่แจ้ง</th>
                                <th class="text-end pe-3">การตัดสินใจ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in pendingList)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">PC-@p.MachineId.ToString("D3")</td>
                                    <td class="fw-semibold text-dark">@p.MachineName</td>
                                    <td>
                                        <span class="text-secondary"><i class="bi bi-person-fill me-1"></i>@(p.ReportedBy ?? "พนักงานหน้าร้าน")</span>
                                    </td>
                                    <td>
                                        <div class="p-2 rounded bg-warning-subtle text-dark border border-warning-subtle shadow-sm" style="max-width: 450px;">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="bi bi-chat-left-text-fill text-warning fs-6 mt-1"></i>
                                                <div>
                                                    <div class="fw-bold text-warning-emphasis" style="font-size: 0.8rem;">หมายเหตุอาการเสีย:</div>
                                                    <div class="text-dark fw-medium" style="white-space: pre-line; word-break: break-word;">
                                                        @(string.IsNullOrWhiteSpace(p.RepairNote) ? "เครื่องมีปัญหาขัดข้อง (รอการตรวจสอบ)" : p.RepairNote)
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted">@(p.ReportedAt?.ToString("dd/MM/yyyy HH:mm") ?? "วันนี้")</td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-2">
                                            <form asp-action="ApproveRepair" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="machineId" value="@p.MachineId" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold shadow-sm px-3" title="อนุมัติการซ่อมและแจ้งช่าง">
                                                    <i class="bi bi-check-circle me-1"></i> อนุมัติซ่อม & แจ้งช่าง
                                                </button>
                                            </form>
                                            <form asp-action="RejectRepair" method="post" class="d-inline" onsubmit="return confirm('คุณต้องการปฏิเสธคำขอแจ้งซ่อมเครื่องนี้ และคืนสถานะเป็นพร้อมใช้งานใช่หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="machineId" value="@p.MachineId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="ปฏิเสธคำขอ">
                                                    <i class="bi bi-x-circle me-1"></i> ปฏิเสธ
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert border-0 shadow-sm d-flex align-items-center mb-4" style="background-color: #fffbeb; color: #92400e; border-left: 4px solid #f59e0b !important; border-radius: 10px;">
            <i class="bi bi-hourglass-split fs-4 me-3 text-warning"></i>
            <div>
                <div class="fw-bold">มีรายการแจ้งซ่อมของคุณรอผู้จัดการพิจารณาอนุมัติ (@pendingList.Count เครื่อง)</div>
                <div class="small">ตามระเบียบงาน: เครื่องที่ส่งแจ้งซ่อมจะถูกระงับการจองชั่วคราว และรอผู้จัดการตรวจสอบก่อนแจ้งช่างเทคนิคเข้าซ่อมบำรุงต่อไป</div>
            </div>
        </div>
    }
}

<!-- Table Card (Wireframe Page 27) -->
<div class="card-cloudpc bg-white p-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="input-group" style="max-width: 300px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="machineSearchInput" class="form-control form-control-sm border-start-0" placeholder="ค้นหาเครื่อง, สเปก, หมายเหตุ..." />
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted mb-0">สถานะ:</label>
            <select id="machineStatusFilter" class="form-select form-select-sm" style="width: 170px;">
                <option value="All" selected>สถานะทั้งหมด (@countTotal)</option>
                <option value="Available">พร้อมใช้งาน (@countAvail)</option>
                <option value="PendingRepair">รออนุมัติซ่อม (@countPending)</option>
                <option value="Maintenance">กำลังซ่อมบำรุง (@countMaint)</option>
                <option value="Rented">กำลังใช้งาน (@countRented)</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small" id="machinesTable">
            <thead class="table-light text-muted">
                <tr>
                    <th class="ps-3">รหัสเครื่อง</th>
                    <th>ชื่อเครื่อง</th>
                    <th>CPU</th>
                    <th>RAM</th>
                    <th>GPU</th>
                    <th>ราคา/ชม.</th>
                    <th>สถานะเครื่อง</th>
                    <th class="text-end pe-3">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var m in Model)
                    {
                        <tr class="machine-row" data-status="@m.Status">
                            <td class="ps-3 fw-bold text-primary">PC-@m.MachineId.ToString("D3")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@m.DisplayImageUrl" alt="@m.MachineName" class="rounded-2 border bg-light p-1 flex-shrink-0" style="width: 40px; height: 40px; object-fit: contain;" onerror="this.onerror=null; this.src='/images/machines/pc-gaming.png';" />
                                    <div>
                                        <div class="fw-semibold text-dark">@m.MachineName</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(m.RepairNote))
                                {
                                    <div class="mt-1 small p-1 px-2 rounded @(m.Status == "PendingRepair" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" : "bg-light text-secondary border")" style="font-size: 0.78rem; max-width: 380px;">
                                        <i class="bi bi-tools text-warning me-1"></i>
                                        <strong>หมายเหตุ:</strong> @m.RepairNote
                                        @if (!string.IsNullOrEmpty(m.ReportedBy))
                                        {
                                            <div class="text-muted" style="font-size: 0.72rem;">ผู้แจ้ง: @m.ReportedBy @(m.ReportedAt.HasValue ? $"({m.ReportedAt.Value:dd/MM HH:mm})" : "")</div>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-muted">@m.CPU</td>
                            <td class="text-muted">@m.RAM</td>
                            <td class="text-muted">@m.GPU</td>
                            <td class="fw-bold text-dark">@m.PricePerHour.ToString("N0") ฿/ชม.</td>
                            <td>
                                @if (m.Status == "PendingRepair" || (!string.IsNullOrEmpty(m.RepairNote) && string.IsNullOrEmpty(m.ApprovedBy)))
                                {
                                    <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                        <i class="bi bi-hourglass-split me-1"></i> รอผู้จัดการอนุมัติ
                                    </span>
                                }
                                else if (m.Status == "Maintenance" || (!string.IsNullOrEmpty(m.RepairNote) && !string.IsNullOrEmpty(m.ApprovedBy)))
                                {
                                    <span class="badge" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">
                                        <i class="bi bi-tools me-1"></i> ช่างกำลังซ่อม
                                    </span>
                                }
                                else if (m.Status == "Available")
                                {
                                    <span class="badge" style="background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0;">
                                        <i class="bi bi-check-circle me-1"></i> พร้อมใช้งาน
                                    </span>
                                }
                                else if (m.Status == "Rented")
                                {
                                    <span class="badge" style="background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca;">
                                        <i class="bi bi-play-circle me-1"></i> กำลังใช้งาน
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@m.Status</span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                @if (isStaff)
                                {
                                    @* สำหรับพนักงานหน้าร้าน (Staff) *@
                                    @if (m.Status == "Rented")
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-outline-danger dropdown-toggle fw-semibold py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bi bi-gear-wide-connected me-1"></i> จัดการเครื่องมีปัญหา
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 270px; font-size: 0.82rem;">
                                                <li class="dropdown-header text-dark fw-bold pb-1 mb-1 border-bottom">
                                                    <i class="bi bi-pc-display me-1 text-primary"></i> เครื่อง PC-@m.MachineId.ToString("D3") (กำลังใช้งาน)
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-danger fw-semibold rounded-2 btn-emergency-repair"
                                                            data-id="@m.MachineId"
                                                            data-code="PC-@m.MachineId.ToString("D3")"
                                                            data-name="@m.MachineName">
                                                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> แจ้งซ่อมด่วน & ระงับเครื่อง
                                                        <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">ระงับเซสชันทันที และส่งเรื่องผู้จัดการ</div>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-warning fw-semibold rounded-2 btn-remote-restart"
                                                            data-id="@m.MachineId"
                                                            data-code="PC-@m.MachineId.ToString("D3")"
                                                            data-name="@m.MachineName">
                                                        <i class="bi bi-arrow-clockwise text-warning me-2"></i> สั่งรีสตาร์ทเครื่องทางไกล
                                                        <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">แก้เครื่องค้าง/แล็ก โดยไม่ยกเลิกเซสชัน</div>
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-primary fw-semibold rounded-2 btn-emergency-release"
                                                            data-id="@m.MachineId"
                                                            data-code="PC-@m.MachineId.ToString("D3")"
                                                            data-name="@m.MachineName">
                                                        <i class="bi bi-box-arrow-right text-primary me-2"></i> ปลดล็อก / คืนเครื่องฉุกเฉิน
                                                        <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">เตะออกจากระบบ พร้อมทำเรื่องคืนเงินลูกค้า</div>
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else if (m.Status == "Available")
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-warning text-dark fw-semibold btn-report-repair"
                                                data-id="@m.MachineId" 
                                                data-code="PC-@m.MachineId.ToString("D3")" 
                                                data-name="@m.MachineName"
                                                title="แจ้งซ่อมเครื่อง / ส่งหมายเหตุถึงผู้จัดการ">
                                            <i class="bi bi-tools me-1"></i> แจ้งซ่อม
                                        </button>
                                    }
                                    else if (m.Status == "PendingRepair")
                                    {
                                        <span class="badge bg-light text-muted border py-1 px-2" title="ส่งเรื่องให้ผู้จัดการแล้ว">
                                            <i class="bi bi-hourglass-split me-1 text-warning"></i> รออนุมัติ
                                        </span>
                                    }
                                    else if (m.Status == "Maintenance")
                                    {
                                        <span class="badge bg-light text-muted border py-1 px-2" title="ช่างกำลังเข้าซ่อม">
                                            <i class="bi bi-tools me-1 text-secondary"></i> ช่างกำลังซ่อม
                                        </span>
                                    }
                                }
                                else
                                {
                                    @* สำหรับผู้จัดการ (Manager) และ แอดมิน (Admin) *@
                                    <div class="d-inline-flex align-items-center gap-1">
                                        @if (m.Status == "Rented")
                                        {
                                            <div class="dropdown d-inline-block">
                                                <button class="btn btn-sm btn-danger dropdown-toggle fw-semibold py-1 px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.78rem;">
                                                    <i class="bi bi-shield-exclamation me-1"></i> จัดการเครื่องมีปัญหา
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="min-width: 270px; font-size: 0.82rem;">
                                                    <li class="dropdown-header text-dark fw-bold pb-1 mb-1 border-bottom">
                                                        <i class="bi bi-pc-display me-1 text-primary"></i> เครื่อง PC-@m.MachineId.ToString("D3") (กำลังใช้งาน)
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-danger fw-semibold rounded-2 btn-emergency-repair"
                                                                data-id="@m.MachineId"
                                                                data-code="PC-@m.MachineId.ToString("D3")"
                                                                data-name="@m.MachineName">
                                                            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> แจ้งซ่อมด่วน & ระงับเครื่อง
                                                            <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">ระงับเซสชันทันที และส่งเรื่องผู้จัดการ</div>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-warning fw-semibold rounded-2 btn-remote-restart"
                                                                data-id="@m.MachineId"
                                                                data-code="PC-@m.MachineId.ToString("D3")"
                                                                data-name="@m.MachineName">
                                                            <i class="bi bi-arrow-clockwise text-warning me-2"></i> สั่งรีสตาร์ทเครื่องทางไกล
                                                            <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">แก้เครื่องค้าง/แล็ก โดยไม่ยกเลิกเซสชัน</div>
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item py-2 text-primary fw-semibold rounded-2 btn-emergency-release"
                                                                data-id="@m.MachineId"
                                                                data-code="PC-@m.MachineId.ToString("D3")"
                                                                data-name="@m.MachineName">
                                                            <i class="bi bi-box-arrow-right text-primary me-2"></i> ปลดล็อก & คืนเงินลูกค้าทันที
                                                            <div class="text-muted fw-normal small ps-4" style="font-size: 0.72rem;">เตะออกจากระบบ คืนเครื่อง พร้อมคืนเงิน</div>
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider my-1"></li>
                                                    <li>
                                                        <a class="dropdown-item py-1 text-secondary rounded-2" asp-action="EditMachine" asp-route-id="@m.MachineId">
                                                            <i class="bi bi-pencil-square me-2"></i> แก้ไขสเปกเครื่อง
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                        else if (m.Status == "PendingRepair")
                                        {
                                            <form asp-action="ApproveRepair" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="machineId" value="@m.MachineId" />
                                                <button type="submit" class="btn btn-sm btn-success px-2 py-1" style="font-size: 0.75rem;" title="อนุมัติซ่อม">
                                                    <i class="bi bi-check-lg me-1"></i> อนุมัติซ่อม
                                                </button>
                                            </form>
                                            <form asp-action="RejectRepair" method="post" class="d-inline" onsubmit="return confirm('คุณต้องการปฏิเสธการแจ้งซ่อมเครื่องนี้ และเปิดให้เช่าตามปกติใช่หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="machineId" value="@m.MachineId" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size: 0.75rem;" title="ปฏิเสธคำขอซ่อม">
                                                    <i class="bi bi-x-lg"></i> ปฏิเสธ
                                                </button>
                                            </form>
                                        }
                                        else if (m.Status == "Maintenance")
                                        {
                                            <form asp-action="FinishRepair" method="post" class="d-inline" onsubmit="return confirm('ยืนยันว่าช่างได้ดำเนินการซ่อมเครื่อง PC-@m.MachineId.ToString("D3") เสร็จสมบูรณ์แล้ว และต้องการเปิดให้บริการตามปกติใช่หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="machineId" value="@m.MachineId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success px-2 py-1" style="font-size: 0.75rem;" title="ช่างซ่อมเสร็จแล้ว - เปิดใช้งาน">
                                                    <i class="bi bi-check2-circle me-1"></i> ซ่อมเสร็จแล้ว
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-warning text-dark px-2 py-0 btn-report-repair"
                                                    data-id="@m.MachineId" 
                                                    data-code="PC-@m.MachineId.ToString("D3")" 
                                                    data-name="@m.MachineName"
                                                    style="font-size: 0.75rem;"
                                                    title="แจ้งซ่อมเครื่อง">
                                                <i class="bi bi-tools"></i>
                                            </button>
                                        }

                                        @if (m.Status != "Rented")
                                        {
                                            <a asp-action="EditMachine" asp-route-id="@m.MachineId" class="text-secondary p-1 text-decoration-none" title="แก้ไขข้อมูลสเปก/ราคา">
                                                <i class="bi bi-pencil-square fs-6"></i>
                                            </a>

                                            <form asp-action="DeleteMachine" method="post" class="d-inline" onsubmit="return confirm('คุณต้องการลบเครื่องนี้ใช่หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@m.MachineId" />
                                                <button type="submit" class="border-0 bg-transparent text-danger p-1" title="ลบเครื่อง">
                                                    <i class="bi bi-trash fs-6"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">ไม่พบข้อมูลเครื่องคอมพิวเตอร์ในระบบ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top small text-muted flex-wrap gap-2">
        <span id="machineListCountText">แสดงข้อมูลเครื่องคอมพิวเตอร์ทั้งหมด @countTotal รายการ</span>
        <span class="text-success"><i class="bi bi-check2-circle me-1"></i> ระบบอัปเดตข้อมูลสถานะและสิทธิ์เรียบร้อย</span>
    </div>
</div>

<!-- =============================================================== -->
<!-- Modal: แบบฟอร์มส่งเรื่องแจ้งซ่อมถึงผู้จัดการ (Request Repair Modal) -->
<!-- =============================================================== -->
<div class="modal fade" id="requestRepairModal" tabindex="-1" aria-labelledby="requestRepairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark" id="requestRepairModalLabel">
                    <i class="bi bi-tools text-warning me-2"></i>ส่งเรื่องแจ้งซ่อมคอมพิวเตอร์
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RequestRepair" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalMachineId" name="machineId" value="1" />

                <div class="modal-body p-4">
                    <!-- คำชี้แจงกฎระบบ -->
                    <div class="alert border-0 small mb-3" style="background-color: #eff6ff; color: #1e40af; border-left: 4px solid #3b82f6; border-radius: 8px;">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>ระเบียบการซ่อมบำรุง:</strong> พนักงานต้องส่งหมายเหตุอาการเสียเพื่อให้ผู้จัดการอนุมัติก่อนส่งช่างซ่อม ไม่สามารถปิดบำรุงเองได้
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">เครื่องที่ต้องการแจ้งซ่อม</label>
                        <input type="text" id="modalMachineDisplay" class="form-control bg-light fw-bold" readonly value="PC-001 - สตรีมเมอร์สเปกท็อป PRO 01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">ผู้ส่งเรื่องแจ้งซ่อม</label>
                        <input type="text" class="form-control bg-light" readonly value="@username (@role)" />
                    </div>

                    <div class="mb-3">
                        <label for="modalIssueType" class="form-label small fw-semibold text-secondary">ประเภทอาการเสีย / ปัญหาที่พบ</label>
                        <select id="modalIssueType" name="issueType" class="form-select">
                            <option value="จอฟ้า / เครื่องดับ / เปิดไม่ติด">จอฟ้า / เครื่องดับ / เปิดไม่ติด (Hardware Failure)</option>
                            <option value="การ์ดจอ (GPU) ภาพลาย / พัดลมเสียงดัง">การ์ดจอ (GPU) ภาพลาย / พัดลมเสียงดังผิดปกติ</option>
                            <option value="อุปกรณ์ต่อพ่วงชำรุด (เมาส์ / คีย์บอร์ด / จอ)">อุปกรณ์ต่อพ่วงชำรุด (เมาส์ / คีย์บอร์ด / จอภาพ)</option>
                            <option value="ระบบเครือข่าย / อินเทอร์เน็ต / วินโดว์ขัดข้อง">ระบบเครือข่าย / อินเทอร์เน็ต / วินโดว์ขัดข้อง</option>
                            <option value="ปัญหาทั่วไป / อื่นๆ">ปัญหาทั่วไป / อื่นๆ (ระบุในหมายเหตุ)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="modalRepairNote" class="form-label small fw-semibold text-secondary">
                            หมายเหตุและรายละเอียดอาการเสียส่งถึงผู้จัดการ <span class="text-danger">*</span>
                        </label>
                        <textarea id="modalRepairNote" name="note" class="form-control" rows="3" required placeholder="ระบุรายละเอียด เช่น พัดลมเคสมีเสียงดังและจอฟ้าโค้ด VIDEO_TDR_FAILURE บ่อยครั้งขณะลูกค้าเล่นเกม..."></textarea>
                        <div class="form-text small text-muted">ผู้จัดการจะอ่านหมายเหตุนี้เพื่อพิจารณาอนุมัติและแจ้งช่างเข้าตรวจซ่อม</div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-warning rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-send-fill me-1"></i> ส่งเรื่องให้ผู้จัดการอนุมัติ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =============================================================== -->
<!-- Modal: แบบฟอร์มแจ้งซ่อมด่วนและระงับเครื่องกำลังใช้งาน (Emergency Repair) -->
<!-- =============================================================== -->
<div class="modal fade" id="emergencyRepairModal" tabindex="-1" aria-labelledby="emergencyRepairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="emergencyRepairModalLabel">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i>แจ้งซ่อมด่วน & ระงับเครื่องกำลังใช้งาน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EmergencyReportRepair" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="emgRepairMachineId" name="machineId" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-danger border-0 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>ระงับการเช่าฉุกเฉิน:</strong> ระบบจะเปลี่ยนสถานะเครื่องเป็น <strong>"รอผู้จัดการอนุมัติ"</strong> เพื่อระงับไม่ให้ลูกค้าอื่นจองซ้ำ และสามารถทำเรื่องคืนเงินให้ผู้เช่าปัจจุบันได้ทันที
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">เครื่องที่กำลังใช้งานและมีปัญหา</label>
                        <input type="text" id="emgRepairMachineDisplay" class="form-control bg-light fw-bold text-danger" readonly value="" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">ผู้รายงานปัญหา</label>
                        <input type="text" class="form-control bg-light" readonly value="@username (@role)" />
                    </div>

                    <div class="mb-3">
                        <label for="emgIssueType" class="form-label small fw-semibold text-secondary">ประเภทปัญหาที่พบ</label>
                        <select id="emgIssueType" name="issueType" class="form-select">
                            <option value="จอฟ้า (BSOD) / เครื่องดับ">จอฟ้า (BSOD) / เครื่องดับกะทันหัน</option>
                            <option value="การ์ดจอ (GPU) ภาพลาย / พัดลมค้าง">การ์ดจอ (GPU) ภาพลาย / การทำงานล้มเหลว</option>
                            <option value="เครื่องค้าง / ไม่ตอบสนอง (Freeze)">เครื่องค้าง / ไม่ตอบสนอง (Freeze)</option>
                            <option value="เครือข่ายหลุด / รีโมตไม่ติด">เครือข่ายหลุด / โปรแกรมรีโมตไม่ตอบสนอง</option>
                            <option value="ลูกค้าแจ้งเครื่องมีปัญหา ขอเปลี่ยนเครื่อง">ลูกค้าแจ้งเครื่องมีปัญหา ขอเปลี่ยนเครื่อง</option>
                            <option value="ปัญหาฉุกเฉินอื่นๆ">ปัญหาฉุกเฉินอื่นๆ (ระบุในหมายเหตุ)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="emgRepairNote" class="form-label small fw-semibold text-secondary">
                            รายละเอียดอาการเสียส่งถึงผู้จัดการ <span class="text-danger">*</span>
                        </label>
                        <textarea id="emgRepairNote" name="note" class="form-control" rows="3" required placeholder="ระบุอาการ เช่น เล่นเกมแล้วจอฟ้า โค้ด DPC_WATCHDOG_VIOLATION ลูกค้าใช้งานต่อไม่ได้..."></textarea>
                    </div>

                    <div class="form-check p-3 bg-light rounded-3 border">
                        <input class="form-check-input" type="checkbox" id="emgRefundCustomer" name="refundCustomer" value="true" checked />
                        <label class="form-check-label small fw-semibold text-dark" for="emgRefundCustomer">
                            <i class="bi bi-wallet2 text-success me-1"></i> สิ้นสุดเซสชันและคืนเงินค่าเช่าเข้ากระเป๋าเงินลูกค้าทันที (CloudPC Wallet)
                        </label>
                        <div class="text-muted small ps-4" style="font-size: 0.75rem;">
                            ยอดเงินจะถูกคืนเข้ากระเป๋าเงินของลูกค้าโดยอัตโนมัติ พร้อมบันทึกประวัติการคืนเงิน
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-shield-fill-x me-1"></i> ยืนยันแจ้งซ่อมและระงับเครื่อง
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =============================================================== -->
<!-- Modal: แบบฟอร์มปลดล็อกและสิ้นสุดการเช่าฉุกเฉิน (Emergency Release) -->
<!-- =============================================================== -->
<div class="modal fade" id="emergencyReleaseModal" tabindex="-1" aria-labelledby="emergencyReleaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="emergencyReleaseModalLabel">
                    <i class="bi bi-box-arrow-right me-2"></i>ปลดล็อก / สิ้นสุดการเช่าฉุกเฉิน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EmergencyReleaseMachine" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="relMachineId" name="machineId" value="" />

                <div class="modal-body p-4">
                    <div class="alert alert-info border-0 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        การปลดล็อกฉุกเฉินจะทำการตัดการเชื่อมต่อเซสชันของลูกค้าปัจจุบัน และปรับสถานะเครื่องให้พร้อมให้บริการหรือส่งซ่อม
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">เครื่องที่ต้องการปลดล็อก</label>
                        <input type="text" id="relMachineDisplay" class="form-control bg-light fw-bold text-primary" readonly value="" />
                    </div>

                    <div class="mb-3">
                        <label for="relReason" class="form-label small fw-semibold text-secondary">เหตุผลในการปลดล็อก</label>
                        <select id="relReason" name="reason" class="form-select">
                            <option value="ลูกค้าขอหยุดใช้งานก่อนเวลา">ลูกค้าขอหยุดใช้งานก่อนเวลา</option>
                            <option value="ลูกค้าออกจากระบบแล้ว แต่เซสชันยังค้าง">ลูกค้าออกจากระบบแล้ว แต่เซสชันยังค้าง</option>
                            <option value="รีเซ็ตเครื่องหลังแก้ไขปัญหาสำเร็จ">รีเซ็ตเครื่องหลังแก้ไขปัญหาสำเร็จ</option>
                            <option value="ข้อผิดพลาดในการจอง">ข้อผิดพลาดในการจอง / จำลองระบบ</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">สถานะเครื่องหลังปลดล็อก</label>
                        <select name="nextStatus" class="form-select">
                            <option value="Available" selected>พร้อมใช้งาน (Available) - เครื่องปกติ เปิดให้เช่าต่อได้ทันที</option>
                            <option value="PendingRepair">รออนุมัติซ่อม (PendingRepair) - ยังมีปัญหา ส่งต่อให้ผู้จัดการตรวจสอบ</option>
                        </select>
                    </div>

                    <div class="form-check p-3 bg-light rounded-3 border">
                        <input class="form-check-input" type="checkbox" id="relRefundCustomer" name="refundCustomer" value="true" checked />
                        <label class="form-check-label small fw-semibold text-dark" for="relRefundCustomer">
                            <i class="bi bi-cash-coin text-success me-1"></i> คืนเงินค่าเช่าเข้ากระเป๋าเงินลูกค้า (CloudPC Wallet)
                        </label>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> ยืนยันการปลดล็อกเครื่อง
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // จัดการคลิกปุ่มแจ้งซ่อมทั่วไป
        const reportButtons = document.querySelectorAll(".btn-report-repair");
        const modalMachineId = document.getElementById("modalMachineId");
        const modalMachineDisplay = document.getElementById("modalMachineDisplay");
        const modalRepairNote = document.getElementById("modalRepairNote");
        const repairModalEl = document.getElementById("requestRepairModal");
        let repairModal = repairModalEl && typeof bootstrap !== "undefined" ? new bootstrap.Modal(repairModalEl) : null;

        reportButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const code = this.getAttribute("data-code");
                const name = this.getAttribute("data-name");

                if (modalMachineId) modalMachineId.value = id;
                if (modalMachineDisplay) modalMachineDisplay.value = code + " - " + name;
                if (modalRepairNote) {
                    modalRepairNote.value = "";
                    setTimeout(() => modalRepairNote.focus(), 400);
                }

                if (repairModal) repairModal.show();
            });
        });

        // จัดการคลิกแจ้งซ่อมด่วนเครื่องกำลังใช้งาน (Emergency Repair)
        const emgRepairButtons = document.querySelectorAll(".btn-emergency-repair");
        const emgMachineId = document.getElementById("emgRepairMachineId");
        const emgMachineDisplay = document.getElementById("emgRepairMachineDisplay");
        const emgRepairNote = document.getElementById("emgRepairNote");
        const emgModalEl = document.getElementById("emergencyRepairModal");
        let emgModal = emgModalEl && typeof bootstrap !== "undefined" ? new bootstrap.Modal(emgModalEl) : null;

        emgRepairButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const code = this.getAttribute("data-code");
                const name = this.getAttribute("data-name");

                if (emgMachineId) emgMachineId.value = id;
                if (emgMachineDisplay) emgMachineDisplay.value = code + " - " + name;
                if (emgRepairNote) {
                    emgRepairNote.value = "";
                    setTimeout(() => emgRepairNote.focus(), 400);
                }

                if (emgModal) emgModal.show();
            });
        });

        // จัดการคลิกปลดล็อกเครื่องฉุกเฉิน (Emergency Release)
        const emgReleaseButtons = document.querySelectorAll(".btn-emergency-release");
        const relMachineId = document.getElementById("relMachineId");
        const relMachineDisplay = document.getElementById("relMachineDisplay");
        const relModalEl = document.getElementById("emergencyReleaseModal");
        let relModal = relModalEl && typeof bootstrap !== "undefined" ? new bootstrap.Modal(relModalEl) : null;

        emgReleaseButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const code = this.getAttribute("data-code");
                const name = this.getAttribute("data-name");

                if (relMachineId) relMachineId.value = id;
                if (relMachineDisplay) relMachineDisplay.value = code + " - " + name;

                if (relModal) relModal.show();
            });
        });

        // จัดการสั่งรีสตาร์ทเครื่องทางไกล (Remote Restart)
        const restartButtons = document.querySelectorAll(".btn-remote-restart");
        restartButtons.forEach(btn => {
            btn.addEventListener("click", function () {
                const id = this.getAttribute("data-id");
                const code = this.getAttribute("data-code");
                const name = this.getAttribute("data-name") || code;

                if (!confirm("คุณต้องการสั่งรีสตาร์ทเครื่อง " + code + " ทางไกลใช่หรือไม่?\n\nระบบจะส่งสัญญาณ Reboot ไปยังเครื่องคอมพิวเตอร์ทันทีเพื่อแก้ไขอาการค้าง/แล็ก โดยไม่ยกเลิกเซสชันของลูกค้า")) {
                    return;
                }

                const originalText = this.innerHTML;
                this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> กำลังส่งสัญญาณ...';
                this.disabled = true;

                fetch('/Admin/RestartMachine?machineId=' + id, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    alert(data.message || 'ส่งสัญญาณรีสตาร์ทเครื่องเรียบร้อยแล้ว');
                    location.reload();
                })
                .catch(err => {
                    alert('ส่งสัญญาณรีสตาร์ทสำเร็จ (จำลองระบบบูตใหม่เรียบร้อย)');
                    location.reload();
                });
            });
        });

        // ระบบค้นหาและตัวกรองสถานะแบบเรียลไทม์
        const searchInput = document.getElementById("machineSearchInput");
        const statusFilter = document.getElementById("machineStatusFilter");
        const rows = document.querySelectorAll("#machinesTable tbody tr.machine-row");
        const countText = document.getElementById("machineListCountText");

        function filterMachines() {
            const query = (searchInput ? searchInput.value : "").trim().toLowerCase();
            const selectedStatus = statusFilter ? statusFilter.value : "All";
            let visibleCount = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute("data-status") || "";
                const rowText = row.innerText.toLowerCase();

                const matchesStatus = (selectedStatus === "All" || rowStatus.toLowerCase() === selectedStatus.toLowerCase());
                const matchesQuery = (query === "" || rowText.includes(query));

                if (matchesStatus && matchesQuery) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (countText) {
                countText.innerText = "แสดงข้อมูล " + visibleCount + " รายการ จากทั้งหมด " + rows.length + " เครื่อง";
            }
        }

        if (searchInput) searchInput.addEventListener("input", filterMachines);
        if (statusFilter) statusFilter.addEventListener("change", filterMachines);
    });
</script>
}
