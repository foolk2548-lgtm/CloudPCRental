@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "ตั้งค่าทั่วไป";
}

<!-- Header (Wireframe Page 30) -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="text-muted small">ปรับนโยบายระบบคลาวด์คอมพิวเตอร์ ข้อมูลร้านค้า เงื่อนไขการเช่าใช้งาน และความปลอดภัย</div>
        <h3 class="fw-bold text-dark mb-0">ตั้งค่าทั่วไป</h3>
    </div>
    <div class="text-muted small cursor-pointer refresh-badge d-flex align-items-center" onclick="refreshPageData(this)" title="คลิกเพื่อรีเฟรชข้อมูลล่าสุด">
        <span>อัปเดตข้อมูลล่าสุด: เรียลไทม์</span>
        <i class="bi bi-arrow-clockwise text-primary ms-1 fs-6"></i>
    </div>
</div>

<div class="row g-4 pb-5">
    <!-- Left Column -->
    <div class="col-lg-6">
        <!-- ข้อมูลระบบหลัก (System Profile) -->
        <div class="card-cloudpc bg-white p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">ข้อมูลระบบหลัก (System Profile)</h6>
            <div class="mb-3">
                <label class="form-label small text-secondary">ชื่อสโมสร / ร้านค้าคลาวด์</label>
                <input type="text" class="form-control" value="Cloud PC High Performance Arena" />
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-secondary">อีเมลติดต่อดูแลระบบ</label>
                    <input type="email" class="form-control" value="support@cloudpc-arena.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-secondary">เบอร์โทรศัพท์ส่วนกลาง</label>
                    <input type="text" class="form-control" value="02-123-4567" />
                </div>
            </div>
        </div>

        <!-- เงื่อนไขการจองและเวลาใช้งาน -->
        <div class="card-cloudpc bg-white p-4">
            <h6 class="fw-bold text-dark mb-3">เงื่อนไขการจองและเวลาใช้งาน</h6>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-secondary">จองขั้นต่ำต่อครั้ง</label>
                    <select class="form-select">
                        <option selected>1 ชั่วโมง</option>
                        <option>2 ชั่วโมง</option>
                        <option>3 ชั่วโมง</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-secondary">จองสูงสุดต่อเนื่อง</label>
                    <select class="form-select">
                        <option selected>12 ชั่วโมง</option>
                        <option>24 ชั่วโมง</option>
                    </select>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-secondary">เวลาเผื่อรีเซ็ตเครื่อง (Buffer Time)</label>
                    <select class="form-select">
                        <option selected>10 นาที</option>
                        <option>15 นาที</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-secondary">ยกเลิกอัตโนมัติหากไม่ชำระเงิน</label>
                    <select class="form-select">
                        <option selected>15 นาที หลังจอง</option>
                        <option>30 นาที หลังจอง</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-6">
        <!-- ระบบความปลอดภัย (Security) -->
        <div class="card-cloudpc bg-white p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">ระบบความปลอดภัย (Security)</h6>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="sec-2fa" checked />
                <label class="form-check-label small fw-semibold text-dark" for="sec-2fa">
                    บังคับใช้การยืนยันตัวตน 2 ชั้น (2FA) สำหรับแอดมินทุกคน
                </label>
                <div class="text-muted small" style="font-size: 0.72rem;">เพิ่มความปลอดภัยป้องกันแฮกเกอร์เจาะสิทธิ์จัดการ</div>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="sec-block" checked />
                <label class="form-check-label small fw-semibold text-dark" for="sec-block">
                    ปิดกั้นการเชื่อมต่อเครื่องคอมพิวเตอร์ถ้าผู้ใช้ไม่มีสถานะจองแล้ว
                </label>
                <div class="text-muted small" style="font-size: 0.72rem;">ตัดสัญญาณรีโมทควบคุมทันทีที่หมดชั่วโมงเช่าโดยไม่เคลียร์ข้อมูลช้า</div>
            </div>

            <div class="mt-3">
                <label class="form-label small text-secondary">ระยะเวลาออกจากระบบอัตโนมัติ (Session Timeout)</label>
                <select class="form-select">
                    <option selected>30 นาที หลังไม่มีกิจกรรม</option>
                    <option>60 นาที หลังไม่มีกิจกรรม</option>
                </select>
            </div>
        </div>

        <!-- การแจ้งเตือนและการทำงานระบบ (Notifications) -->
        <div class="card-cloudpc bg-white p-4 mb-4">
            <h6 class="fw-bold text-dark mb-3">การแจ้งเตือนและการทำงานระบบ (Notifications)</h6>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="noti-email" checked />
                <label class="form-check-label small fw-semibold text-dark" for="noti-email">
                    แจ้งเตือนความคืบหน้าระดับชั่วโมงผ่านทางอีเมล (Email)
                </label>
                <div class="text-muted small" style="font-size: 0.72rem;">ส่งรายงานสรุปยอดผู้เช่าคอมพิวเตอร์เมื่อครบ 24 ชม.</div>
            </div>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="noti-line" checked />
                <label class="form-check-label small fw-semibold text-dark" for="noti-line">
                    ใช้งานระบบ LINE Notify แจ้งเตือนแอดมิน
                </label>
                <div class="text-muted small" style="font-size: 0.72rem;">แจ้งเตือนผ่านกลุ่มแชททันทีที่มีเครื่องขัดข้องหรือเกิดบันทึกแบบวิกฤต</div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-light rounded-3 px-4">คืนค่าเริ่มต้น</button>
            <button type="button" class="btn btn-primary rounded-3 px-4 fw-semibold shadow-sm">บันทึกข้อมูลการตั้งค่า</button>
        </div>
    </div>
</div>

